<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 3: this action was `project_commission_action` in
         arkzayed_18_realestate_developer_crm, the same local id the monolith used for a
         DIFFERENT model (realestate.project.commission). Separate module prefixes hid the
         clash; one module cannot hold both, so this one - for `project.commission` - was
         renamed `action_project_commission_lines`. Backlog #77. -->
    <!-- Phase 3c: moved here from arkzayed_18_realestate_developer_crm, verbatim and with the same
         local xmlids. L3 owns these models, so it owns their UI. -->
        <record id="action_project_commission_lines" model="ir.actions.act_window">
            <field name="name">Project Commission</field>
            <field name="res_model">project.commission</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="project_commission_list_view" model="ir.ui.view">
            <field name="name">Project.Commission.list</field>
            <field name="model">project.commission</field>
            <field name="arch" type="xml">
                <list string="Project Commission">
                    <field name="developer_project_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="commission_percentage" widget="percentage"/>
                </list>
            </field>
        </record>
        <record id="project_commission_form_view" model="ir.ui.view">
            <field name="name">Project.Commission.form</field>
            <field name="model">project.commission</field>
            <field name="arch" type="xml">
                <form string="Project Commission">
                    <sheet>
                        <group>
                            <group>
                                <field name="developer_project_id"/>
                                <field name="start_date" readonly="not is_first_commission" required="developer_project_id != None"/>
                                <field name="end_date" required="developer_project_id != None"/>
                            </group>
                            <group>
                                <field name="commission_percentage" widget="percentage"/>
                                <field name="additional_commission_percentage" widget="percentage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
</odoo>
