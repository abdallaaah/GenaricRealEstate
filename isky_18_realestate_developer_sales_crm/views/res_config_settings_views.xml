<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 6: L2 contributes the Sales Setup and Financials sections to the shared
         "Real Estate" tab that L0 declares (decisions log, 2026-11-07, P1/P2).

         Before Phase 6 this module defined a tab of its own ("Real Estate Sales") with the
         headings "Sales Setup" and "Sales Setup: Approvals", while 17 of its own settings were
         rendered only by the monolith's settings view under four further headings. Both are
         gone: every setting this module declares now sits in exactly one of the plan's five
         sections. The monolith's view still renders 17 of them until Phase 3c retires it
         (backlog #65) - that is a legacy-view duplicate, not a second home here. -->
    <record id="res_config_settings_view_form_sales_crm" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sales.crm</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="74"/>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.res_config_settings_view_form_real_estate"/>
        <field name="arch" type="xml">
            <!-- Sales Setup: L0 declares the heading and the container; this adds entries. -->
            <xpath expr="//div[@id='realestate_sales_setup_section']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="installments_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="installments_enabled"/>
                            <div class="text-muted">
                                Default for new projects: generate installment and maintenance
                                installment lines on reservations and contracts. A project can
                                override this. Cannot be changed once projects inheriting it have
                                installment lines.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Default Payment Plan Years</span>
                            <div class="text-muted">
                                Years a new payment plan defaults to, by unit kind.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="residential_default_years" class="col-lg-8 o_light_label"/>
                                    <field name="residential_default_years"/>
                                </div>
                                <div class="row mt16">
                                    <label for="non_residential_default_years" class="col-lg-8 o_light_label"/>
                                    <field name="non_residential_default_years"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_reservation_expiry_cron"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_reservation_expiry_cron"/>
                            <div class="text-muted">
                                Expire reservations automatically once their allowed time has
                                passed.
                            </div>
                            <div class="content-group" invisible="not enable_reservation_expiry_cron">
                                <div class="row mt16">
                                    <label for="onhold_reservation_expiration_hours" class="col-lg-8 o_light_label"/>
                                    <field name="onhold_reservation_expiration_hours"/>
                                </div>
                                <div class="row mt16">
                                    <label for="unpaid_reservation_expiration_hours" class="col-lg-8 o_light_label"/>
                                    <field name="unpaid_reservation_expiration_hours"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_crm_unit_hold"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_crm_unit_hold"/>
                            <div class="text-muted">
                                Let a salesperson hold a unit straight from an opportunity.
                            </div>
                            <div class="content-group" invisible="not enable_crm_unit_hold">
                                <div class="row mt16">
                                    <label for="crm_unit_hold_duration" class="col-lg-8 o_light_label"/>
                                    <field name="crm_unit_hold_duration"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- S7's three approval entries, inside Sales Setup rather than under a
                         heading of their own: "Sales Setup: Approvals" was a sixth section name
                         (P3). Section 11's decision 2 still holds - these choose WHO approves,
                         never whether a check runs, and unit blocking and the reservation
                         exception are deliberately absent. -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="approval_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="approval_enabled"/>
                            <div class="text-muted">
                                When off, the approval stages below are not required. Unit blocking
                                and the reservation exception check are always enforced and are not
                                affected by this switch.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not approval_enabled">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Contract Approval Chain</span>
                            <div class="text-muted">
                                Which groups approve each stage of a contract. Changes apply
                                immediately, including to contracts already pending.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="finance_approver_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="finance_approver_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="finance_two_approver_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="finance_two_approver_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="manager_approver_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="manager_approver_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="operation_manager_approver_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="operation_manager_approver_group_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not approval_enabled">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Reservation and Discount</span>
                            <div class="text-muted">
                                Which groups may confirm reservations, see and edit discount
                                percentages, and tick installments as paid by hand.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="confirm_reservation_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="confirm_reservation_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="show_discount_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="show_discount_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="edit_discount_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="edit_discount_group_ids" widget="many2many_tags"/>
                                </div>
                                <div class="row mt16">
                                    <label for="manual_paid_group_ids" class="col-lg-5 o_light_label"/>
                                    <field name="manual_paid_group_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>

            <!-- Financials: installment rounding, the split precision, and collection entries. -->
            <xpath expr="//div[@id='realestate_financials_section']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="apply_cents_in_last_line"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="apply_cents_in_last_line"/>
                            <div class="text-muted">
                                Rounding of generated installment and maintenance lines. The last
                                line always absorbs the difference; generation is refused when that
                                difference exceeds the tolerance.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="apply_to_nearer_ten" class="col-lg-8 o_light_label"/>
                                    <field name="apply_to_nearer_ten"/>
                                </div>
                                <div class="row mt16">
                                    <label for="installment_price_tolerance" class="col-lg-8 o_light_label"/>
                                    <field name="installment_price_tolerance"/>
                                </div>
                                <div class="row mt16">
                                    <label for="split_percentage_precision" class="col-lg-8 o_light_label"/>
                                    <field name="split_percentage_precision"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Collection Entries</span>
                            <div class="text-muted">
                                Accounts, journal and revenue split used when posting a collection
                                entry.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="collection_journal_id" class="col-lg-6 o_light_label"/>
                                    <field name="collection_journal_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="collection_debit_account_id" class="col-lg-6 o_light_label"/>
                                    <field name="collection_debit_account_id"/>
                                </div>
                                <div class="row mt16">
                                    <span class="o_form_label">Revenue Split</span>
                                    <div class="text-muted">
                                        One row per business line. Each row's percentage of the
                                        collected amount is credited to its account; the debit is
                                        their sum, so the entry balances.
                                    </div>
                                    <field name="revenue_split_line_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="percentage"/>
                                            <field name="account_id"/>
                                            <field name="analytic_account_id"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>
