<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_construction_progress" model="ir.module.category">
        <field name="name">Construction Progress</field>
    </record>

    <record id="group_progress_engineer" model="res.groups">
        <field name="name">Site Engineer</field>
        <field name="category_id" ref="module_category_construction_progress"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can add progress updates on the units and buildings assigned to them.</field>
    </record>

    <record id="group_progress_manager" model="res.groups">
        <field name="name">Progress Manager</field>
        <field name="category_id" ref="module_category_construction_progress"/>
        <field name="implied_ids" eval="[(4, ref('group_progress_engineer'))]"/>
        <field name="comment">Can update any unit or building, correct or delete updates, and assign engineers.</field>
    </record>

    <data noupdate="1">
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_progress_manager'))]"/>
        </record>
    </data>

</odoo>
