<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="revenue_share2_tree" model="ir.ui.view">
            <field name="name">revenue_share2_tree</field>
            <field name="model">revenue.share2</field>
            <field name="arch" type="xml">
                <list>
                    <field name="customer_id"/>
                    <field name="date"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="revenue_share2_form" model="ir.ui.view">
            <field name="name">revenue_share2_form</field>
            <field name="model">revenue.share2</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-money">
<!--                                <field name="invoice_count" class="o_stat_value"/>-->
                                <div class="o_stat_info">
                                    <span class="o_stat_text">
                                        Invoice
                                    </span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id"/>
                                <field name="rental_fee"/>
                                <field name="revenue_share"/>
                                <field name="currency_id"/>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="sales"/>
                                <field name="revenue_share_amount"/>
                                <field name="tax_id"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="revenue_share2_action" model="ir.actions.act_window">
            <field name="name">Revenue Share2</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">revenue.share2</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>