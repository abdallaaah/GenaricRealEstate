<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_company_form_custody_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='social_media']" position="before">
                    <group>
                        <field name="custody_account_id"/>
                    </group>
                     <group>
                        <field name="custody_journal_id"/>
                        <field name="custody_payment_method_id"/>
                    </group>

                </xpath>

            </field>
        </record>
    </data>
</odoo>