<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_broker" model="ir.ui.view">
        <field name="name">res.company.form.inherit.broker</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <group name="social_media" position="after">
                <group string="Broker">
                    <field name="broker_sequence_prefix" placeholder="e.g. ABC"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
