<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_real_estate_unit_form_cost_inherit" model="ir.ui.view">
        <field name="name">real.estate.unit.form.cost.inherit</field>
        <field name="model">real.estate.unit</field>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.view_real_estate_unit_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Cost">
                    <group>
                        <group string="Cost">
                            <field name="direct_cost"/>
                            <field name="indirect_cost"/>
                            <field name="total_cost"/>
                            <field name="cost_per_sqm"/>
                        </group>
                        <group string="Profitability">
                            <field name="price_after_discount"/>
                            <field name="sale_price_per_sqm_after_discount"/>
                            <field name="profit_per_sqm"/>
                            <field name="total_profit"/>
                        </group>
                    </group>
                    <field name="allocation_ids">
                        <list>
                            <field name="move_id"/>
                            <field name="cost_type"/>
                            <field name="unit_area"/>
                            <field name="rate_per_sqm"/>
                            <field name="percentage"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
