<?xml version="1.0"?>
<odoo>
    <data>
        <record id="custody_transactions_search_view" model="ir.ui.view">
            <field name="name">custody.transactions.search.view</field>
            <field name="model">custody.transaction</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="employee_id" string="Employee"/>
                    <separator/>
                    <group expand="0" string="Group By...">
                        <filter string="Employee"
                                name="group_employee_id"
                                domain="[]"
                                context="{'group_by':'employee_id'}"/>
                        <filter string="Custody"
                                name="group_custody_id"
                                domain="[]"
                                context="{'group_by':'custody_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="custody_transaction_tree_view" model="ir.ui.view">
            <field name="name">custody.transaction.tree.view</field>
            <field name="model">custody.transaction</field>
            <field name="arch" type="xml">
                <list string="Employee Custody" create="false">
                    <field name="date"/>
                    <field name="custody_id"/>
                    <field name="supplier_id"/>
                    <field name="product_id"/>
                    <field name="type"/>
                    <field name="custody_amount"/>
                    <field name="amount_before"/>
                    <field name="amount"/>
                    <field name="amount_after"/>
                    <field name="currency_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_custody_transaction">
            <field name="name">Employee Custody Transactions</field>
            <field name="res_model">custody.transaction</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="custody_transactions_search_view"/>
            <field name="context">{'search_default_group_employee_id':1}</field>
            <field name="view_id" ref="custody_transaction_tree_view"/>
        </record>

    </data>
</odoo>
