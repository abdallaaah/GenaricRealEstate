<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_lead2opportunity_inherit_form" model="ir.ui.view">
            <field name="name">crm_lead2opportunity_inherit_form</field>
            <field name="model">crm.lead2opportunity.partner</field>
            <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='name']" position="after">
                    <group>
                        <field name="stage_id"/>
                        <field name="is_reserved" invisible="1"/>
                        <field name="reservation_price" invisible="is_reserved != True" required="1"/>
                        <field name="reserved_date" invisible="is_reserved != True" required="1"/>
                        <field name="is_contract" invisible="1"/>
                        <field name="contract_price" invisible="is_contract != True" required="1"/>
                        <field name="contracted_date" invisible="is_contract != True" required="1"/>
                        <field name="buying_type"/>
                        <field name="eoi_attachment" invisible="is_eoi == False"
                               required="is_eoi == True"/>
                        <field name="reservation_attachment" invisible="is_reserved == False"
                               required="is_reserved == True"/>
                        <field name="contract_attachment" invisible="is_contract == False"
                               required="is_contract == True"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='action']" position="after">
                    <field name="related_action" nolabel="1" widget="radio"/>
                </xpath>
                <xpath expr="//field[@name='action']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//footer/button[@name='action_apply']" position="attributes">
                    <attribute name="context">{'from_convert_to_opp': True}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
