<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <!-- Maintenance Template -->
        <record id="view_maintenance_template_tree" model="ir.ui.view">
            <field name="name">maintenance.template.tree</field>
            <field name="model">maintenance.template</field>
            <field name="arch" type="xml">
                <list string="Maintenance Template">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="default_for_reservation" />
                </list>
            </field>
        </record>

        <record id="view_maintenance_template_form" model="ir.ui.view">
            <field name="name">maintenance.template.form</field>
            <field name="model">maintenance.template</field>
            <field name="arch" type="xml">
                <form string="Maintenance Template">
                    <sheet>
                        <h1>
                            <field name="name" default_focus="1" placeholder="Name"/>
                        </h1>
                        <br/>
                        <group>
                            <field name="project_ids" widget="many2many_tags"/>
                            <field name="percentage" widget="percentage"/>
                            <field name="type"/>
                            <field name="company_id"/>
                            <field name="default_for_reservation" />
                        </group>
                        <group>
                            <group string="Monthly Installments">
                                 <field name="monthly_installment_amount" widget="percentage"/>
                                <label for="monthly_installment_duration"/>
                                <div class="o_row">
                                    <field name="monthly_installment_duration" required="1"/>
                                    <span class="mr-1">Months</span>
                                </div>
                            </group>
                            <group string="Quarterly Installments">
                                <field name="quarterly_installment_amount" widget="percentage"/>
                                 <label for="quarterly_installment_duration"/>
                                    <div class="o_row">
                                        <field name="quarterly_installment_duration" required="1"/>
                                        <span class="mr-1">Quarters</span>
                                    </div>
                            </group>
                        </group>
                        <group>
                            <group string="Semi Annual Installments">
                            <field name="semi_annual_installment_amount" widget="percentage"/>
                            <label for="semi_annual_installment_duration"/>
                                <div class="o_row">
                                    <field name="semi_annual_installment_duration" required="1"/>
                                    <span class="mr-1">Half-Years</span>
                                </div>
                        </group>
                        <group string="Annual Installments">
                            <field name="annual_installment_amount" widget="percentage"/>
                            <label for="annual_installment_duration"/>
                                <div class="o_row">
                                    <field name="annual_installment_duration" required="1"/>
                                    <span class="mr-1">Years</span>
                                </div>
                        </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_maintenance_template_form_act_window" model="ir.actions.act_window">
            <field name="name">Maintenance Template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">maintenance.template</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'maintenance')]</field>
            <field name="context">{'default_type': 'maintenance'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to add a new maintenance template
                </p>
            </field>
        </record>


    </data>
</odoo>
