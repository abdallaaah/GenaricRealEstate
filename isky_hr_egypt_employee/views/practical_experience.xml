<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_exp_practical_experience_form" model="ir.ui.view">
            <field name="name">view.exp.practical.experiences.form</field>
            <field name="model">exp.practical.experiences</field>
            <field name="arch" type="xml">
                <form string="Partner Practical Experience">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="job"/>
                                <field name="applicant_id"/>
                            </group>
                            <group>
                                <field name="business_sector"/>
                                <field name="years"/>
                                <field name="employee_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_exp_practical_experience_tree" model="ir.ui.view">
            <field name="name">view.exp_practical_experience.tree</field>
            <field name="model">exp.practical.experiences</field>
            <field name="arch" type="xml">
                <list string="Partner Practical Experience">
                    <field name="name"/>
                    <field name="job"/>
                    <field name="applicant_id"/>
                    <field name="business_sector"/>
                    <field name="years"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

        <record id="view_exp_practical_experience_search" model="ir.ui.view">
            <field name="name">view.exp_practical_experience.search</field>
            <field name="model">exp.practical.experiences</field>
            <field name="arch" type="xml">
                <search string="Partner Practical Experience">
                    <field name="name"/>
                    <field name="job"/>
                    <field name="applicant_id"/>
                    <field name="business_sector"/>
                    <field name="years"/>
                    <field name="employee_id"/>
                    <group string="Group By" name="groupby">
                        <filter name="applicant_id_groupby" string="Applicant" context="{'group_by': 'applicant_id'}"/>
                        <filter name="employee_id_groupby" string="Employee" context="{'group_by': 'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="exp_practical_experience_action" model="ir.actions.act_window">
            <field name="name">Partner Practical Experience</field>
            <field name="res_model">exp.practical.experiences</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new Partner Practical Experience.
                </p>
            </field>
        </record>

    </data>
</odoo>
