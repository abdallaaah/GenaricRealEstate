<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_progress_log_list" model="ir.ui.view">
        <field name="name">arkzayed.construction.progress.list</field>
        <field name="model">arkzayed.construction.progress</field>
        <field name="arch" type="xml">
            <list string="Progress Updates" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="target"/>
                <field name="unit_id" optional="hide"/>
                <field name="building_id" optional="hide"/>
                <field name="percent"/>
                <field name="note"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_progress_log_search" model="ir.ui.view">
        <field name="name">arkzayed.construction.progress.search</field>
        <field name="model">arkzayed.construction.progress</field>
        <field name="arch" type="xml">
            <search string="Progress Updates">
                <field name="unit_id"/>
                <field name="building_id"/>
                <field name="user_id"/>
                <filter name="units_only" string="Units" domain="[('unit_id', '!=', False)]"/>
                <filter name="buildings_only" string="Buildings" domain="[('building_id', '!=', False)]"/>
                <filter name="mine" string="My updates" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="Updated By" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_progress_log" model="ir.actions.act_window">
        <field name="name">Update History</field>
        <field name="res_model">arkzayed.construction.progress</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_progress_log_search"/>
    </record>

    <menuitem id="menu_construction_progress_root" name="Construction Progress"
              parent="arkzayed_18_realestate_development.menu_real_estate_root" sequence="5"/>
    <menuitem id="menu_progress_history" name="Update History" parent="menu_construction_progress_root"
              action="action_progress_log" sequence="30"/>

</odoo>
