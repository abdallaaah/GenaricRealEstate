<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Unit Type Configuration Views -->
    <record id="view_unit_type_configuration_list" model="ir.ui.view">
        <field name="name">unit.type.configuration.list</field>
        <field name="model">real.estate.unit.type.configuration</field>
        <field name="arch" type="xml">
            <list string="Unit Type Configurations" default_order="building_id, unit_type">
                <field name="building_id"/>
                <field name="unit_type" readonly="unit_type == 'residential'"/>
                <field name="indoor_price_sqm"/>
                <field name="terrace_price_sqm"/>
                <field name="outdoor_price_percentage" widget="percentage"/>
                <field name="indoor_gross_ratio"/>
                <field name="terrace_gross_ratio"/>
                <field name="garden_gross_ratio"/>
                <field name="outdoor_gross_ratio"/>
            </list>
        </field>
    </record>

    <record id="view_unit_type_configuration_search" model="ir.ui.view">
        <field name="name">unit.type.configuration.search</field>
        <field name="model">real.estate.unit.type.configuration</field>
        <field name="arch" type="xml">
            <search>
                <field name="building_id"/>
                <field name="unit_type" readonly="unit_type == 'residential'"/>
                <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                <filter string="Unit Type" name="group_unit_type" context="{'group_by': 'unit_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_unit_type_configuration_form" model="ir.ui.view">
        <field name="name">unit.type.configuration.form</field>
        <field name="model">real.estate.unit.type.configuration</field>
        <field name="arch" type="xml">
            <form string="Unit Type Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="building_id" options="{'no_create': True}"/>
                            <field name="unit_type" readonly="unit_type == 'residential'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Pricing Configuration">
                            <group>
                                <group>
                                    <field name="indoor_price_sqm"/>
                                    <field name="terrace_price_sqm"/>
                                    <field name="outdoor_price_percentage" widget="percentage"/>
                                    <p class="text-muted" colspan="2">
                                        Percentage for calculating outdoor price from indoor price
                                    </p>
                                </group>
                            </group>
                        </page>

                        <page string="Area Ratios">
                            <group string="Common Area Ratios">
                                <group>
                                    <field name="indoor_gross_ratio"/>
                                    <field name="terrace_gross_ratio"/>
                                </group>
                            </group>
                            <group string="Other Ratios">
                                <group>
                                    <label for="garden_gross_ratio" string="Garden Ratio" invisible="unit_type != 'residential'"/>
                                    <div invisible="unit_type != 'residential'">
                                        <field name="garden_gross_ratio" class="oe_inline"/>
                                        <p class="text-muted">
                                            <small>For residential units with garden</small>
                                        </p>
                                    </div>
                                    <label for="outdoor_gross_ratio" string="Outdoor Ratio" invisible="unit_type == 'residential'"/>
                                    <div invisible="unit_type == 'residential'">
                                        <field name="outdoor_gross_ratio" class="oe_inline"/>
                                        <p class="text-muted">
                                            <small>For non-residential units</small>
                                        </p>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unit_type_configuration" model="ir.actions.act_window">
        <field name="name">Unit Type Configuration</field>
        <field name="res_model">real.estate.unit.type.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
