<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- RESERVATION ACTIONS -->
    <record id="action_dept_plan_reservation" model="ir.actions.report">
        <field name="name">Departments Payment Plan</field>
        <field name="model">real.estate.sale.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arkzayed_18_realestate_development.dept_plan_res</field>
        <field name="report_file">arkzayed_18_realestate_development.dept_plan_res</field>
        <field name="print_report_name">f"Departments Payment Plan - {object.unit_id.system_code or object.name}"</field>
        <field name="paperformat_id" ref="arkzayed_18_realestate_development.report_payment_plan_paperformat"/>
        <field name="binding_model_id" ref="model_real_estate_sale_reservation"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_ceo_plan_reservation" model="ir.actions.report">
        <field name="name">CEO Payment Plan</field>
        <field name="model">real.estate.sale.reservation</field>
