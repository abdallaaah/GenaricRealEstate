<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_real_estate_facility_tree" model="ir.ui.view">
        <field name="name">real.estate.facility.tree</field>
        <field name="model">real.estate.facility</field>
        <field name="arch" type="xml">
            <list string="Facilities">
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [30, 30]}"/>
                <field name="project_id"/>
                <field name="company_id" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_real_estate_facility_form" model="ir.ui.view">
        <field name="name">real.estate.facility.form</field>
        <field name="model">real.estate.facility</field>
        <field name="arch" type="xml">
            <form string="Facility">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image" options="{'size': [50, 50]}"/>
                        <field name="project_id"/>
                        <field name="company_id" readonly="1"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_real_estate_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">real.estate.facility</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
