        <record id="crm_lead_admin_rule" model="ir.rule">
            <field name="name">Lead Admin: See all Leads and teams</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('lead_admin_group'))]"/>
        </record>

        <record id="crm_team_admin_rule" model="ir.rule">
            <field name="name">Lead Admin: See all and teams</field>
            <field name="model_id" ref="crm.model_crm_team"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('lead_admin_group'))]"/>
        </record>

        <record id="crm_team_admin_rule" model="ir.rule">
            <field name="name">Team leader</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>

        <function model="ir.rule" name="write">
            <value eval="[ref('base.res_partner_portal_public_rule')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>
        <function model="ir.rule" name="write">
            <value eval="[ref('mail.mail_message_subtype_rule_public')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <record id="crm_meeting_report_admin_rule" model="ir.rule">
            <field name="name">CRM Meeting Report for Admin</field>
            <field name="model_id" ref="model_crm_meeting_report"/>
            <field name="groups"
                   eval="[(6, 0, [ref('arkzayed_18_realestate_broker.lead_admin_group'), ref('arkzayed_18_realestate_broker.operation_manager_group')])]"/>
<!--                   , ref('arkzayed_18_realestate_broker.operation_executive_group')-->

            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="crm_meeting_report_user_rule" model="ir.rule">
            <field name="name">CRM Meeting Report for User</field>
            <field name="model_id" ref="model_crm_meeting_report"/>
            <field name="groups"
                   eval="[(6, 0, [ref('sales_team.group_sale_salesman_all_leads'), ref('arkzayed_18_realestate_broker.sales_manager_group'), ref('arkzayed_18_realestate_broker.director_manager_group')])]"/>
            <field name="domain_force">[('user_id', 'in', user.env['crm.team'].search([
                '|',
                '|',
                ('user_id', '=', user.id),
                ('director_id', '=', user.id),
                ('sales_manager_id', '=', user.id),
                ]).mapped('member_ids').ids)]
            </field>
        </record>

    </data>
</odoo>