<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
    <record id="view_real_estate_nearby_connectivity_tree" model="ir.ui.view">
        <field name="name">real.estate.nearby.connectivity.tree</field>
        <field name="model">real.estate.nearby.connectivity</field>
        <field name="arch" type="xml">
            <list string="Nearby Connectivities">
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [30, 30]}"/>
                <field name="project_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_real_estate_nearby_connectivity_form" model="ir.ui.view">
        <field name="name">real.estate.nearby.connectivity.form</field>
        <field name="model">real.estate.nearby.connectivity</field>
        <field name="arch" type="xml">
            <form string="Nearby Connectivity">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image" options="{'size': [50, 50]}"/>
                        <field name="project_id"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_real_estate_nearby_connectivity" model="ir.actions.act_window">
        <field name="name">Nearby Connectivities</field>
        <field name="res_model">real.estate.nearby.connectivity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
