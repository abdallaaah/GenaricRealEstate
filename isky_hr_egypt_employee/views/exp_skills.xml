<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_exp_skills_form" model="ir.ui.view">
            <field name="name">view.exp.skills.form</field>
            <field name="model">exp.skills</field>
            <field name="arch" type="xml">
                <form string="Partner Skills">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="applicant_id"/>
                            </group>
                            <group>
                                <field name="level"/>
                                <field name="employee_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_exp_skills_tree" model="ir.ui.view">
            <field name="name">view.exp_skills.tree</field>
            <field name="model">exp.skills</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="applicant_id"/>
                    <field name="level"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

        <record id="view_exp_skills_search" model="ir.ui.view">
            <field name="name">view.exp_skills.search</field>
            <field name="model">exp.skills</field>
            <field name="arch" type="xml">
                <search string="Partner Skills">
                    <field name="name"/>
                    <field name="applicant_id"/>
                    <field name="level"/>
                    <field name="employee_id"/>
                    <group string="Group By" name="groupby">
                        <filter name="applicant_id_groupby" string="Applicant" context="{'group_by': 'applicant_id'}"/>
                        <filter name="employee_id_groupby" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="level_groupby" string="Level" context="{'group_by': 'level'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="exp_skills_action" model="ir.actions.act_window">
            <field name="name">Partner Skills</field>
            <field name="res_model">exp.skills</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new Partner Skills.
                </p>
            </field>
        </record>

    </data>
</odoo>
