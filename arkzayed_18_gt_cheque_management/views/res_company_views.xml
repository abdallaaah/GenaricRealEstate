<odoo>
    <record id="view_res_company_modi" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//group//field[@name='currency_id']" position="after">
                <field name="received_checks"/>
            </xpath>
            <xpath expr="//group//group//field[@name='currency_id']" position="after">
                <field name="outgoing_checks"/>
            </xpath>
            <xpath expr="//group//group//field[@name='currency_id']" position="after">
                <field name="hermes_account"/>
            </xpath>
            <xpath expr="//field[@name='hermes_account']" position="after">
                <field name="adib_account"/>
            </xpath>
<!--            <xpath expr="//field[@name='adib_account']" position="after">-->
<!--                <field name="return_account"/>-->
<!--            </xpath>-->
        </field>
    </record>
</odoo>
