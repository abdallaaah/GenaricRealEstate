<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L3 owns these models, so it owns their UI. -->
        <record id="view_commission_category_tree" model="ir.ui.view">
            <field name="name">commission.category.tree</field>
            <field name="model">commission.category</field>
            <field name="arch" type="xml">
                <list string="Commission Categories">
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="employee_count"/>
                </list>
            </field>
        </record>
        <record id="view_commission_category_form" model="ir.ui.view">
            <field name="name">commission.category.form</field>
            <field name="model">commission.category</field>
            <field name="arch" type="xml">
                <form string="Commission Category">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_employees" type="object"
                                    class="oe_stat_button" icon="fa-users">
                                <field name="employee_count" widget="statinfo" string="Employees"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="percentage"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_commission_category" model="ir.actions.act_window">
            <field name="name">Commission Categories</field>
            <field name="res_model">commission.category</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
