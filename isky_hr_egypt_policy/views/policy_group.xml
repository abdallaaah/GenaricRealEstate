<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- employee policy group form view-->
        <record id="policy_group_from_view" model="ir.ui.view">
            <field name="name">policy.group.view.form</field>
            <field name="model">policy.group</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--employee policy group tree view-->
        <record id="policy_group_tree_view" model="ir.ui.view">
            <field name="name">policy.group.tree.view</field>
            <field name="model">policy.group</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- employee policy action-->
        <record id="policy_group_action" model="ir.actions.act_window">
            <field name="name">Policy Group</field>
            <field name="res_model">policy.group</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>