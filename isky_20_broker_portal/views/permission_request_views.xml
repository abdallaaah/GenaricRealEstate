<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backend views: the operations/approver side of permission requests. Until now the
         model only had portal templates, so action_approve/action_reject had no buttons;
         the approval flow existed in code but was unreachable from the UI. -->
    <record id="permission_request_view_list" model="ir.ui.view">
        <field name="name">permission.request.view.list</field>
        <field name="model">permission.request</field>
        <field name="arch" type="xml">
            <list decoration-success="approval_status == 'approved'"
                  decoration-danger="approval_status == 'rejected'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="team_id"/>
                <field name="request_type"/>
                <field name="client_name"/>
                <field name="client_number" optional="hide"/>
                <field name="approval_status" widget="badge"
                       decoration-success="approval_status == 'approved'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-warning="approval_status == 'pending'"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="permission_request_view_form" model="ir.ui.view">
        <field name="name">permission.request.view.form</field>
        <field name="model">permission.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="approval_status != 'pending'"
                            groups="isky_20_broker_base.group_permission_approver"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="approval_status != 'pending'"
                            groups="isky_20_broker_base.group_permission_approver"/>
                    <field name="approval_status" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="requester_id"/>
                            <field name="team_id"/>
                            <field name="request_type"/>
                        </group>
                        <group string="Client">
                            <field name="client_name"/>
                            <field name="client_number"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="request_details" nolabel="1"/>
                    </group>
                    <group string="Operations Feedback">
                        <field name="operations_feedback" nolabel="1"
                               placeholder="Why this request was approved or rejected..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="permission_request_view_search" model="ir.ui.view">
        <field name="name">permission.request.view.search</field>
        <field name="model">permission.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="client_name"/>
                <filter string="Pending" name="pending" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('approval_status', '=', 'rejected')]"/>
                <group>
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'approval_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="permission_request_action" model="ir.actions.act_window">
        <field name="name">Permission Requests</field>
        <field name="res_model">permission.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_permission_requests" name="Permission Requests"
              parent="isky_20_broker_base.broker_menu_root"
              action="permission_request_action" sequence="40"/>
</odoo>
