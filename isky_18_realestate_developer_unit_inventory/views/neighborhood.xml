<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_developer_crm, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="view_neighborhood_list" model="ir.ui.view">
            <field name="name">view.neighborhood.list</field>
            <field name="model">neighborhood.neighborhood</field>
            <field name="arch" type="xml">
                <list string="Neighborhood">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="view_neighborhood_form" model="ir.ui.view">
            <field name="name">view.neighborhood.form</field>
            <field name="model">neighborhood.neighborhood</field>
            <field name="arch" type="xml">
                <form string="Neighborhood">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_neighborhood_project" model="ir.actions.act_window">
            <field name="name">Neighborhood</field>
            <field name="res_model">neighborhood.neighborhood</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
