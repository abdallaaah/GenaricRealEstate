<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
    <record id="view_collections_installment_list" model="ir.ui.view">
        <field name="name">installment.lines.collections.list</field>
        <field name="model">installment.lines</field>
        <field name="arch" type="xml">
            <list string="Installments" create="0" edit="0" delete="0" default_order="overdue_days desc, date">
                <field name="customer_id"/>
                <field name="unit_id"/>
                <field name="name"/>
                <field name="date" string="Due Date"/>
                <field name="overdue_days" optional="show"/>
                <field name="amount" optional="hide"/>
                <field name="paid_amount" sum="Paid"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="is_down_payment" optional="hide"/>
                <field name="payment_methods" optional="hide"/>
                <field name="contract_state" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_collections_installment_pivot" model="ir.ui.view">
        <field name="name">installment.lines.collections.pivot</field>
        <field name="model">installment.lines</field>
        <field name="arch" type="xml">
            <pivot string="Collections Analysis">
                <field name="customer_id" type="row"/>
                <field name="paid_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_collections_installment_search" model="ir.ui.view">
        <field name="name">installment.lines.collections.search</field>
        <field name="model">installment.lines</field>
        <field name="arch" type="xml">
            <search string="Installments">
                <field name="customer_id"/>
                <field name="unit_id"/>
                <filter name="overdue" string="Overdue"
                        domain="[('remaining_amount', '>', 0), ('date', '&lt;', context_today().strftime('%Y-%m-%d')), ('date', '&lt;', '2060-01-01')]"/>
                <filter name="over_90" string="Overdue more than 90 days"
                        domain="[('remaining_amount', '>', 0), ('date', '&lt;', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d')), ('date', '&lt;', '2060-01-01')]"/>
                <filter name="due_30" string="Due in next 30 days"
                        domain="[('remaining_amount', '>', 0), ('date', '>=', context_today().strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="unpaid" string="Not fully paid" domain="[('remaining_amount', '>', 0)]"/>
                <filter name="down_payment" string="Down payments" domain="[('is_down_payment', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Client" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_due_month" string="Due Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_method" string="Payment Method" context="{'group_by': 'payment_methods'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_collections_installments" model="ir.actions.act_window">
        <field name="name">Overdue Installments</field>
        <field name="res_model">installment.lines</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_collections_installment_search"/>
        <field name="domain">[('contract_state', 'in', ['approved', 'signed_client', 'operation_review', 'finance_review', 'top_management', 'signed_ceo', 'ready_to_deliver_contract', 'sent_to_client', 'delivered_contract', 'ready_to_deliver', 'delivered'])]</field>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_customer': 1}</field>
    </record>
</odoo>
