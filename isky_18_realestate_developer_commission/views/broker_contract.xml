<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L3 owns these models, so it owns their UI. -->
        <record id="broker_contract_tree" model="ir.ui.view">
            <field name="name">broker.contract.tree</field>
            <field name="model">broker.contract</field>
            <field name="arch" type="xml">
                <list string="Broker Contract">
                    <field name="name"/>
                    <field name="broker_company"/>
                    <field name="contract_issue_date"/>
                    <field name="contract_start_date"/>
                    <field name="contract_end_date"/>
                </list>
            </field>
        </record>
        <record id="broker_contract_form" model="ir.ui.view">
            <field name="name">broker.contract.form</field>
            <field name="model">broker.contract</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <div class="oe_title">
                                <label for="name" string="Reference"/>
                                <h1>
                                    <field name="name"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <group>
                                <field name="broker_company"/>
                                <field name="collection" widget="char"/>
                            </group>
                            <group>
                                <field name="contract_issue_date"/>
                                <label for="contract_start_date" string="Contract Start Date"/>
                                <div name="dates" class="o_row">
                                    <field name="contract_start_date" widget="daterange"
                                           options='{"related_end_date": "contract_end_date"}'/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon"
                                       title="Arrow"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon"
                                       title="Arrow"
                                       invisible = "[('contract_start_date', '=', False), ('contract_end_date', '=', False)]"/>
                                    <field name="contract_end_date" widget="daterange"
                                           options='{"related_start_date": "contract_start_date"}'/>
                                </div>
                                <field name="company_id" invisible="1"/>
                                <field name="broker_type"/>
                            </group>
                        </group>
                        <notebook>
                            <Page name="commission" string="Commission">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="commission"/>
                                    </list>
                                </field>
                            </Page>
                            <page name="broker_team" string="Broker Team Members" invisible="broker_type !='assign_to_sales'">
                                <field name="broker_line_ids">
                                    <list editable="bottom">
                                        <field name="partner_id" context="{'default_is_agent': 1}"/>
                                        <field name="commission"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="broker_contract_search_view" model="ir.ui.view">
            <field name="name">broker.contract.search</field>
            <field name="model">broker.contract</field>
            <field name="arch" type="xml">
                <search string="Search Broker Contract">
                    <field name="name" string="Reference"/>
                    <field name="broker_company" string="Broker Company"/>
                    <field name="broker_company_ref" string="Broker Company Reference"/>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="broker_contract_action">
            <field name="name">broker / Ambassador contract</field>
            <field name="res_model">broker.contract</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
