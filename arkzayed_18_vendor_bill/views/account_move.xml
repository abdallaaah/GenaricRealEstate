<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_history" model="ir.ui.view">
        <field name="name">account.move.form.inherit.history</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">arkzayed_18_vendor_bill.group_reset_to_draft</attribute>
            </xpath>
            <!-- Add building_id and purchase_type fields -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="purchase_type" widget="radio" options="{'horizontal': true}" invisible="move_type != 'in_invoice'"/>
                <field name="building_id" invisible="purchase_type == 'original'"/>
                <field name="engineering_approved" readonly="1"
                       invisible="move_type != 'in_invoice' or purchase_type != 'construction'"/>
            </xpath>

            <!-- Engineering Approval workflow for Construction vendor bills -->
            <xpath expr="(//button[@name='action_post'])[2]" position="before">
                <button name="action_engineering_approval" string="Engineering Approval"
                        type="object" class="oe_highlight" data-hotkey="w"
                        groups="arkzayed_18_vendor_bill.group_engineering_approval"
                        invisible="move_type != 'in_invoice' or purchase_type != 'construction' or state != 'draft' or engineering_approved"/>
            </xpath>
            <xpath expr="(//button[@name='action_post'])[2]" position="attributes">
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or (purchase_type == 'construction' and not engineering_approved)</attribute>
            </xpath>

            <!-- Add History page -->
            <xpath expr="//notebook//page[last()]" position="after">
                <page string="History" name="history" invisible="move_type != 'in_invoice' or purchase_type == 'original'">
                    <field name="history_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="product_id"/>
                            <field name="previous_work" sum="Total Previous"/>
                            <field name="current_work" sum="Total Current"/>
                            <field name="total_work" sum="Total"/>
                        </list>
                    </field>
                </page>
                <page string="History Report" invisible="move_type != 'in_invoice' or purchase_type == 'original'">
                    <button name="action_read_history_report_lines" type="object"
                            string="Read from History" class="btn-secondary mb-2"/>
                    <field name="history_report_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="previous_work" sum="Total Previous"/>
                            <field name="current_work" sum="Total Current"/>
                            <field name="total_work" sum="Total"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Add insurance fields with visibility based on purchase_type -->
            <xpath expr="//page[@name='invoice_tab']/field/list/field[@name='product_id']" position="after">
                <field name="is_insurance_product" column_invisible="parent.purchase_type == 'original'"/>
                <field name="insurance_percentage" readonly="not is_insurance_product" column_invisible="parent.purchase_type == 'original'"/>
            </xpath>
        </field>
    </record>
</odoo>
