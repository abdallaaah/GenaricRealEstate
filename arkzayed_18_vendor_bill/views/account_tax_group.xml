<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tax_group_form_insurance" model="ir.ui.view">
            <field name="name">account.tax.group.form.insurance</field>
            <field name="model">account.tax.group</field>
            <field name="inherit_id" ref="account.view_tax_group_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="include_in_insurance"
                           string="Include in Insurance Calculation"
                           help="If checked, this tax will be included when calculating insurance on products that include tax"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
