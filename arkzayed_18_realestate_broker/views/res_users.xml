<odoo>
    <data>
        <record id="view_users_search_inherit" model="ir.ui.view">
            <field name="name">view.users.search.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_search"/>
            <field name="arch" type="xml">
                <xpath expr="." position="inside">
                    <filter string="Department" name="department" context="{'group_by': 'user_department_id'}"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="res_user_inherit_form" model="ir.ui.view">
            <field name="name">res_user_inherit_form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='mobile']" position="after">
                    <field name="job_level_id"/>
                </xpath>

            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="res_user_inherit_form_view" model="ir.ui.view">
            <field name="name">res_user_inherit_form_view</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='preferences']" position="inside">
                    <group>
                        <group string="Job Level">
                            <field name="job_level_id"/>
                        </group>
                        <group></group>
                    </group>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
