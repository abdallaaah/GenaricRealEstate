<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_real_state_project_assigned" model="ir.module.category">
            <field name="name">Real State Project</field>
        </record>

        <!-- Phase 3c step 1 (S1-D4): this group gates the Net area group on the UNIT form, so it
             belongs to the module owning the unit - the same rule backlog #9 and Phase 3 steps 1
             and 2a applied. The unit form moved here in step 1, and a `groups=` xmlid that does
             not resolve is a hard ParseError, so the group has to resolve from L0. The monolith
             keeps its own copy, still used by its sale_proposal view, until step 2 moves that; in
             a database with both installed, members must be re-assigned (backlog #72). -->
        <record id="group_restrict_net_area_visibility" model="res.groups">
            <field name="name">Restrict Net Area Visibility</field>
            <field name="category_id" ref="module_category_real_state_project_assigned"/>
        </record>
        <record id="real_estate_facility_company_rule" model="ir.rule">
            <field name="name">real_estate_facility_company_rule</field>
            <field name="model_id" ref="model_real_estate_facility"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="real_estate_feature_company_rule" model="ir.rule">
            <field name="name">real_estate_feature_company_rule</field>
            <field name="model_id" ref="model_real_estate_feature"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="real_estate_nearby_connectivity_company_rule" model="ir.rule">
            <field name="name">real_estate_nearby_connectivity_company_rule</field>
            <field name="model_id" ref="model_real_estate_nearby_connectivity"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Phase 3 step 2a: moved here from arkzayed_18_realestate_development. It gates
             blocking a UNIT, so it belongs in L0. Both L0 (real_estate_unit.py) and L2
             (sale_request.py) call has_group() on it, and neither depends on the monolith, so
             it returned False for every user and unit blocking was silently permitted to
             nobody. L2 reaches it here because sales_crm depends on L0. -->
        <record id="group_block_unit" model="res.groups">
            <field name="name">Block Unit</field>
            <field name="category_id" ref="module_category_real_state_project_assigned"/>
        </record>

        <record id="real_state_project_user_group" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_real_state_project_assigned"/>
        </record>
        <record id="real_state_project_admin_group" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_real_state_project_assigned"/>
        </record>
        <record id="user_real_state_project_assigned_rule" model="ir.rule">
            <field name="name">User Project Assigned</field>
            <field name="model_id" ref="model_realestate_project"/>
            <field name="domain_force">[('id', 'in', user.realestate_project_ids.ids)]</field>
            <field name="groups"
                   eval="[Command.link(ref('real_state_project_user_group'))]"/>
        </record>
        <record id="admin_real_state_project_assigned_rule" model="ir.rule">
            <field name="name">Admin Project Assigned (all)</field>
            <field name="model_id" ref="model_realestate_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[Command.link(ref('real_state_project_admin_group'))]"/>
        </record>
        <record id="user_real_state_unit_assigned_rule" model="ir.rule">
