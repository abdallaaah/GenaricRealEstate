<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_commission_view_list" model="ir.ui.view">
        <field name="name">project.commission.view.list</field>
        <field name="model">project.commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="developer_project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="commission_percentage"/>
                <field name="additional_commission_percentage"/>
                <field name="commission_multiplier"/>
            </list>
        </field>
    </record>

    <record id="project_commission_action" model="ir.actions.act_window">
        <field name="name">Project Commissions</field>
        <field name="res_model">project.commission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
