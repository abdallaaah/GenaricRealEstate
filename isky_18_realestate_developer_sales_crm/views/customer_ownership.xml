<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
         <record id="customer_ownership_tree" model="ir.ui.view">
            <field name="name">customer_ownership_tree</field>
            <field name="model">customer.ownership</field>
            <field name="arch" type="xml">
                <list>
                    <field name="customer_id"/>
                    <field name="percentage"/>
                    <field name="company_id"/>

                </list>
            </field>
         </record>
        <record id="customer_ownership_form" model="ir.ui.view">
            <field name="name">customer_ownership_form</field>
            <field name="model">customer.ownership</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="customer_id"/>
                            <field name="percentage"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="customer_ownership_action">
            <field name="name">Customer Ownership</field>
            <field name="res_model">customer.ownership</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
