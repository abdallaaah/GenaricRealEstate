        <!-- Sales Manager sees only team's requests -->
        <record id="permission_request_sales_manager_rule" model="ir.rule">
            <field name="name">Sales Manager sees own team's permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[
                '|',
                ('requester_id', '=', user.id),
                ('team_id.sales_manager_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_manager_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Director sees only team's requests -->
        <record id="permission_request_director_rule" model="ir.rule">
            <field name="name">Director sees own team's permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[
                '|',
                ('requester_id', '=', user.id),
                ('team_id.director_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('director_manager_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Team Leader sees only team's requests -->
        <record id="permission_request_team_leader_rule" model="ir.rule">
            <field name="name">Team Leader sees team's permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[
                '|',
                ('requester_id', '=', user.id),
                ('team_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Salesperson sees only own requests -->
        <record id="permission_request_salesperson_rule" model="ir.rule">
            <field name="name">Salesperson sees own permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>