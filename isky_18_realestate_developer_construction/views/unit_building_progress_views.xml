<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 4 (S6-D1): the construction-progress UI for L0's unit and building.
         Step 1 left these in the monolith because they render ONLY L4 fields - so they
         belong neither in L0, which has not got the fields, nor in the monolith. Three are
         inherited views, which S4 allows in any module. The two progress lists and their
         searches are standalone views of an L0 model living in L4, which is the narrow
         exception recorded in S6-D3: every field they render is this module's own. -->
    <record id="view_real_estate_unit_form_progress_inherit" model="ir.ui.view">
        <field name="name">real.estate.unit.form.progress.inherit</field>
        <field name="model">real.estate.unit</field>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.view_real_estate_unit_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Progress">
                    <group>
                        <group>
                            <field name="construction_progress" widget="progressbar"/>
                            <field name="progress_source"/>
                            <field name="progress_date"/>
                            <field name="progress_user_id"/>
                        </group>
                        <group>
                            <field name="responsible_engineer_id"/>
                        </group>
                    </group>
                    <field name="progress_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="percent"/>
                            <field name="note"/>
                            <field name="user_id" readonly="1"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
    <record id="view_real_estate_unit_tree_progress_inherit" model="ir.ui.view">
        <field name="name">real.estate.unit.tree.progress.inherit</field>
        <field name="model">real.estate.unit</field>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.view_real_estate_unit_tree"/>
        <field name="arch" type="xml">
            <field name="unit_status" position="after">
                <field name="construction_progress" widget="progressbar" string="Progress"/>
            </field>
        </field>
    </record>
    <record id="view_real_estate_building_form_progress_inherit" model="ir.ui.view">
        <field name="name">real.estate.building.form.progress.inherit</field>
        <field name="model">real.estate.building</field>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.view_real_estate_building_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <separator string="Construction Progress"/>
                <group>
                    <group>
                        <field name="progress_percent" widget="progressbar"/>
                        <field name="progress_date"/>
                        <field name="progress_user_id"/>
                    </group>
                    <group>
                        <field name="units_progress" widget="progressbar"/>
                        <field name="units_count"/>
                        <field name="responsible_engineer_id"/>
                    </group>
                </group>
                <field name="progress_ids">
                    <list editable="bottom">
                        <field name="date"/>
                        <field name="percent"/>
                        <field name="note"/>
                        <field name="user_id" readonly="1"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="view_units_progress_list" model="ir.ui.view">
        <field name="name">real.estate.unit.progress.list</field>
        <field name="model">real.estate.unit</field>
        <field name="arch" type="xml">
            <list string="Units Progress" create="0" delete="0" edit="0" default_order="construction_progress, system_code">
                <field name="name" string="Unit"/>
                <field name="system_code"/>
                <field name="building_id"/>
                <field name="unit_area" string="Total Gross Area" sum="Total"/>
                <field name="unit_status" string="Status"/>
                <field name="total_price_unit" string="Total Unit Price" sum="Total"/>
                <field name="construction_progress" widget="progressbar"/>
                <field name="progress_source" optional="hide"/>
                <field name="progress_date"/>
                <field name="progress_user_id" optional="hide"/>
                <field name="responsible_engineer_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_units_progress_search" model="ir.ui.view">
        <field name="name">real.estate.unit.progress.search</field>
        <field name="model">real.estate.unit</field>
        <field name="arch" type="xml">
            <search string="Units Progress">
                <field name="system_code"/>
                <field name="building_id"/>
                <field name="responsible_engineer_id"/>
                <filter name="not_started" string="Not started" domain="[('construction_progress', '=', 0)]"/>
                <filter name="in_progress" string="In progress" domain="[('construction_progress', '&gt;', 0), ('construction_progress', '&lt;', 100)]"/>
                <filter name="completed" string="Completed" domain="[('construction_progress', '&gt;=', 100)]"/>
                <separator/>
                <filter name="never_updated" string="Never updated" domain="[('progress_date', '=', False)]"/>
                <filter name="stale" string="Not updated for 14 days"
                        domain="[('construction_progress', '&lt;', 100), '|', ('progress_date', '=', False), ('progress_date', '&lt;', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="My units"
                        domain="['|', ('responsible_engineer_id', '=', uid), ('building_id.responsible_engineer_id', '=', uid)]"/>
                <group>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="group_engineer" string="Responsible Engineer" context="{'group_by': 'responsible_engineer_id'}"/>
                    <filter name="group_source" string="Progress From" context="{'group_by': 'progress_source'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_units_progress" model="ir.actions.act_window">
        <field name="name">Units Progress</field>
        <field name="res_model">real.estate.unit</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_units_progress_list"/>
        <field name="search_view_id" ref="view_units_progress_search"/>
    </record>
    <record id="view_buildings_progress_list" model="ir.ui.view">
        <field name="name">real.estate.building.progress.list</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <list string="Buildings Progress" create="0" delete="0" edit="0" default_order="progress_percent, system_code">
                <field name="system_code"/>
                <field name="progress_percent" widget="progressbar" string="Building Progress"/>
                <field name="units_progress" widget="progressbar"/>
                <field name="units_count" optional="show"/>
                <field name="progress_date"/>
                <field name="progress_user_id" optional="show"/>
                <field name="responsible_engineer_id"/>
            </list>
        </field>
    </record>
    <record id="view_buildings_progress_search" model="ir.ui.view">
        <field name="name">real.estate.building.progress.search</field>
        <field name="model">real.estate.building</field>
        <field name="arch" type="xml">
            <search string="Buildings Progress">
                <field name="system_code"/>
                <field name="responsible_engineer_id"/>
                <filter name="not_started" string="Not started" domain="[('progress_percent', '=', 0)]"/>
                <filter name="in_progress" string="In progress" domain="[('progress_percent', '&gt;', 0), ('progress_percent', '&lt;', 100)]"/>
                <filter name="completed" string="Completed" domain="[('progress_percent', '&gt;=', 100)]"/>
                <separator/>
                <filter name="stale" string="Not updated for 14 days"
                        domain="[('progress_percent', '&lt;', 100), '|', ('progress_date', '=', False), ('progress_date', '&lt;', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="My buildings" domain="[('responsible_engineer_id', '=', uid)]"/>
            </search>
        </field>
    </record>
    <record id="action_buildings_progress" model="ir.actions.act_window">
        <field name="name">Buildings Progress</field>
        <field name="res_model">real.estate.building</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_buildings_progress_list"/>
        <field name="search_view_id" ref="view_buildings_progress_search"/>
    </record>
</odoo>
