<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_voucher" model="ir.actions.report">
            <field name="name">Voucher Report</field>
            <field name="model">cheque.manage</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">arkzayed_18_gt_cheque_management.report_invoice</field>
            <field name="report_file">arkzayed_18_gt_cheque_management.report_invoice</field>
            <field name="binding_model_id" ref="model_cheque_manage"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_invoice">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page">
                            <div class="header">
                                <div class="row ">
                                    <div class="col-6 float-left">
                                        <img t-if="docs.company_id.logo"
                                             t-att-src="image_data_uri(docs.company_id.logo)"
                                             width="100" height="120" alt="Company Logo"
                                             style="padding-top: 29pt;"/>
                                    </div>
                                    <div class="col-6 float-right text-right text-secondary" style="padding-left:40px;">
                                        <span t-esc="o.company_id.name"/>
                                        <br/>
                                        <span t-esc="o.company_id.street"/>
                                        <br/>
                                        <span t-esc="o.company_id.street2"/>
                                        <br/>
                                        <span t-esc="o.company_id.city"/>
                                        <br/>
                                        <span t-esc="o.company_id.country_id.name"/>
                                        <br/>
                                    </div>
                                </div>
                            </div>
                            <div class="table table-bordered w-100 text-secondary" style="border: 2px solid black;">
                             <div class="row">
                                <div class="col-4 float-left" style="padding-left:25px;">
                                    <span>NO:</span>
                                    <span t-esc="o.seq_no"/>
                                    <br/>
                                </div>
                                <div class="col-4 text-center" >
                                    <div t-if="o['cheq_type'] == 'incoming'">
                                        <span>سند قبض</span>
                                        <br/>
                                        <span>Receipt Voucher</span>
                                    </div>
                                    <div t-if="o['cheq_type'] == 'outgoing'">
                                        <span>سند صرف</span>
                                        <br/>
                                        <span>Payment Voucher</span>
                                    </div>
                                </div>
                                <div class="col-4 float-right" style="padding-left:10px;padding-right:25px;">
                                    <div class="container p-3 my-3 border">
                                        <span class="float-left">جنيه</span>
                                        <span class="float-right">قرش</span>
                                        <br/>
                                        <hr/>
                                        <span class="float-left">...........</span>
                                        <span class="float-right">..........</span>
                                        <br/>
                                    </div>
                                </div>


                            </div>
                            <div class="row">
                                <div class="col-4 text-left" style="padding-left:25px;">
                                    <span>Date:</span>
                                    <span t-esc="o.cheque_date"/>
                                    <br/>
                                    <div t-if="o['cheq_type'] == 'incoming'">
                                       <span>Received From Mr./Messers:</span>
                                    <br/>
                                    </div>
                                    <div t-if="o['cheq_type'] == 'outgoing'">
                                        <span>Spent To Mr./Messers:</span>
                                    <br/>
                                    </div>


                                    <span>The Sum Of:</span>
<!--                                    <span t-esc="o.amount"/>-->
                                    <br/>
                                    <span>Cash:</span>
                                    <span/>
                                    <br/>
                                    <span>For:</span>
                                    <span t-esc="o.name"/>
                                    <br/>

                                </div>
                                <div class="col-8">
                                    <div class="text-right" style="padding-right:25px;">
                                        <div class="float-right">
                                            <span class="text-right">التاريخ:</span>
                                            <span t-esc="o.cheque_date"/>
                                        </div>
                                        <br/>
                                        <div t-if="o['cheq_type'] == 'incoming'">
                                            <span class="float-right">:استلمنا من السيد / الساده</span>
                                        <span class="float-left text-center">
                                            <span t-esc="o.payer.name"/>
                                        </span>
                                        <br/>

                                    </div>
                                    <div t-if="o['cheq_type'] == 'outgoing'">
                                        <span class="float-right">:صرفنا لامر السيد / الساده</span>
                                        <span class="float-left text-center">
                                            <span t-esc="o.payer.name"/>
                                        </span>
                                        <br/>

                                    </div>


                                        <span>:مبلغ وقدره</span>
                                        <span class="float-left text-center"><span t-esc="o.amount"/></span>

                                        <br/>
                                        <span>:نقدا</span>
                                        <br/>
                                        <span class="float-right">:وذلك عن</span>
                                        <span>
                                            <span t-esc="o.name"/>
                                        </span>
                                        <br/>
                                    </div>

                                    <br/>
                                </div>
                            </div>
                            <div class="row" style="padding-top:30px;">
                                <div class="col-3 " style="padding-left:25px;">
                                    <span>توقيع المدير</span>
                                    <br/>
                                    <span>Manager Sign</span>
                                    <br/>
                                    <span>.............................</span>
                                </div>
                                <div class="col-3">
                                    <span>المندوب</span>
                                    <br/>
                                    <span>Delegate</span>
                                    <br/>
                                    <span>....................</span>
                                    <br/>
                                </div>
                                <div class="col-3">
                                    <span>المستلم</span>
                                    <br/>
                                    <span>Received By</span>
                                    <br/>
                                    <span>..........................</span>
                                    <br/>
                                </div>
                                <div class="col-3">
                                    <span>اعدها</span>
                                    <br/>
                                    <span>Prepared By</span>
                                    <br/>
                                    <span>Magdy Saber</span>
                                </div>

                            </div>

                            <hr style="border: 1px solid black;"/>
                            <div class="row">
                                <div class="col-12 text-center" style="padding-bottom:15px;">
                                    <span><span t-esc="o.company_id.street"/>-</span>
                                    <span><span t-esc="o.company_id.street2"/>-</span>
                                    <span><span t-esc="o.company_id.city"/>-</span>
                                    <span t-esc="o.company_id.country_id.name"/><br/>

                                </div>
                            </div>
<!--                            <hr style="border: 1px solid black;"/>-->

                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>