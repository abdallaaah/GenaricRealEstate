<odoo>
    <data noupdate="1">
        <record id="ir_cron_scheduler_check_sale_reservation_not_contracted" model="ir.cron">
            <field name="name">Sale Reservations Without Contract</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_real_estate_sale_reservation"/>
            <field name="state">code</field>
            <field name="code">model.action_check_sale_reservation_schedule_action()</field>
            <field name="priority" eval="5" />
             <field name="nextcall" eval="DateTime.now().replace(hour=19, minute=0, second=0, microsecond=0) + timedelta(days=1)"/>
        </record>

        <record id="ir_cron_calculate_installment_penalties" model="ir.cron">
            <field name="name">Calculate Installment Delay Penalties</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_installment_penalty"/>
            <field name="state">code</field>
            <field name="code">model._cron_calculate_installment_penalties()</field>
            <field name="priority" eval="10"/>
            <field name="nextcall" eval="DateTime.now().replace(hour=6, minute=0, second=0, microsecond=0) + timedelta(days=1)"/>
            <field name="active" eval="True"/>
        </record>


        <record id="ir_cron_vendor_commitment_notification" model="ir.cron">
            <field name="name">Vendor Commitment Expiry Notification</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="isky_18_realestate_developer_construction.model_vendor_commitment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_vendor_commitment_notifications()</field>
            <field name="priority" eval="10"/>
            <field name="nextcall" eval="DateTime.now().replace(hour=6, minute=0, second=0, microsecond=0) + timedelta(days=1)"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_recompute_installment_overdue" model="ir.cron">
            <field name="name">Recompute Installment Overdue Status</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_installment_lines"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_overdue()</field>
            <field name="priority" eval="5"/>
            <field name="nextcall" eval="DateTime.now().replace(hour=0, minute=5, second=0, microsecond=0) + timedelta(days=1)"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_check_reservation_expiry_date" model="ir.cron">
            <field name="name">Sale Reservation: Check Reservation Expiry Date</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_real_estate_sale_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_reservation()</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>