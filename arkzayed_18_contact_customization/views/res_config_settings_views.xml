<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_contact_defaults"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.contact.defaults</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='default_accounts']" position="after">

                <block id="contact_default_accounts" title="Contact Default Accounts">

                    <div class="row mt8 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="contact_default_account_receivable_id"/>
                                <div class="text-muted mb-2">
                                    Default <strong>receivable</strong> account for new contacts.
                                </div>
                                <field name="contact_default_account_receivable_id"
                                       placeholder="e.g. 102011 Accounts Receivable"
                                       style="width: 100%; max-width: 100%;"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="contact_default_account_payable_id"/>
                                <div class="text-muted mb-2">
                                    Default <strong>payable</strong> account for new contacts.
                                </div>
                                <field name="contact_default_account_payable_id"
                                       placeholder="e.g. 206100 Accounts Payable"
                                       style="width: 100%; max-width: 100%;"/>
                            </div>
                        </div>

                    </div>

                    <div class="row mt8 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="contact_default_account_down_payment_receivable_id"/>
                                <div class="text-muted mb-2">
                                    Default <strong>down-payment receivable</strong> account for new contacts.
                                </div>
                                <field name="contact_default_account_down_payment_receivable_id"
                                       placeholder="e.g. 205102 Down Payment Receivable"
                                       style="width: 100%; max-width: 100%;"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="contact_default_account_down_payment_payable_id"/>
                                <div class="text-muted mb-2">
                                    Default <strong>down-payment payable</strong> account for new contacts.
                                </div>
                                <field name="contact_default_account_down_payment_payable_id"
                                       placeholder="e.g. 205103 Down Payment Payable"
                                       style="width: 100%; max-width: 100%;"/>
                            </div>
                        </div>

                    </div>

                    <div class="row mt8 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="contact_default_property_notes_receivable_id"/>
                                <div class="text-muted mb-2">
                                    Default <strong>notes receivable</strong> account for new contacts.
                                </div>
                                <field name="contact_default_property_notes_receivable_id"
                                       placeholder="e.g. Notes Receivable Account"
                                       style="width: 100%; max-width: 100%;"/>
                            </div>
                        </div>

                    </div>

                </block>

            </xpath>

        </field>
    </record>
</odoo>