<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ipc_no_margin" model="report.paperformat">
        <field name="name">IPC No Margin</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>

        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>

        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_ipc_taxable_report" model="ir.actions.report">
        <field name="name">IPC Taxable Certificate</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arkzayed_18_vendor_bill.ipc_taxable_report</field>
        <field name="report_file">arkzayed_18_vendor_bill.ipc_taxable_report</field>
        <field name="paperformat_id" ref="arkzayed_18_vendor_bill.paperformat_ipc_no_margin"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>

        <field name="print_report_name">'IPC - %s' % (object.name)</field>
    </record>

</odoo>