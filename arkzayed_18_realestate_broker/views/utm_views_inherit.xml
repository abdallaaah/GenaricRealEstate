<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="utm_medium_view_tree_inherit" model="ir.ui.view">
            <field name="name">utm.medium.view.tree.inherit</field>
            <field name="model">utm.medium</field>
            <field name="inherit_id" ref="utm.utm_medium_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="id"/>
                </xpath>
            </field>
        </record>
        <record id="utm_source_view_tree_inherit" model="ir.ui.view">
            <field name="name">utm.source.view.tree.inherit</field>
            <field name="model">utm.source</field>
            <field name="inherit_id" ref="utm.utm_source_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>