<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_unqualified_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.lead.unqualified.wizard.view.form</field>
        <field name="model">crm.lead.unqualified.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="lead_id" invisible="1"/>
                <group>
                    <field name="lost_reason_id"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Unqualify" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
