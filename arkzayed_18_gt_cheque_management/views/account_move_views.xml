<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Phase 2b: moved here from isky_18_realestate_developer_accounting, together with the
         journal_type field and action_cash_in_out_statement method it drives. The button's
         report action (account_cash_in_out_report) is defined in this module, so keeping the
         button here means the env.ref resolves within one module instead of reaching across
         an undeclared dependency. -->
    <record id="view_account_move_cash_in_out" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cash_in_out</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="journal_type" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_cash_in_out_statement"
                      type="object" string="cash in/out statement"
                        invisible="journal_type != 'cash'"
                      class="btn_primary" />
            </xpath>
        </field>
    </record>
</odoo>
