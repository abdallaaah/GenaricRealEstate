<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_loan_form_commission_inherit" model="ir.ui.view">
        <field name="name">account.loan.form.commission.inherit</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="account_loans.account_loan_form_view"/>
        <field name="arch" type="xml">
            <field name="expense_account_id" position="after">
                <field name="commission_account_id" readonly="state != 'draft'"/>
            </field>
            <field name="interest" position="after">
                <field name="commission" widget="monetary" decoration-danger="commission_difference != 0"
                       readonly="state != 'draft'"/>
            </field>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" icon="fa-money" type="object"
                        name="action_view_payments" invisible="payment_move_count == 0">
                    <field string="Payments" name="payment_move_count" widget="statinfo"/>
                </button>
            </div>
            <page name="main_page" position="after">
                <page string="Payment Summary" name="payment_summary">
                    <group>
                        <group string="Principal">
                            <field name="amount_borrowed" widget="monetary" readonly="1"/>
                            <field name="principal_paid" widget="monetary" readonly="1"/>
                            <field name="principal_remaining" widget="monetary" readonly="1"/>
                        </group>
                        <group string="Interest">
                            <field name="interest" widget="monetary" readonly="1"/>
                            <field name="interest_paid" widget="monetary" readonly="1"/>
                            <field name="interest_remaining" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commission">
                            <field name="commission" widget="monetary" readonly="1"/>
                            <field name="commission_paid" widget="monetary" readonly="1"/>
                            <field name="commission_remaining" widget="monetary" readonly="1"/>
                        </group>
                        <group string="Total">
                            <field name="total_paid" widget="monetary" readonly="1"/>
                            <field name="total_remaining" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="account_loan_line_list_view_payment_inherit" model="ir.ui.view">
        <field name="name">account.loan.line.list.payment.inherit</field>
        <field name="model">account.loan.line</field>
        <field name="inherit_id" ref="account_loans.account_loan_line_list_view"/>
        <field name="arch" type="xml">
            <field name="interest" position="after">
                <field name="commission" string="Commission" sum="Total commission"/>
            </field>
            <field name="payment" position="after">
                <field name="amount_due" string="Total Due" sum="Total due"/>
            </field>
            <field name="outstanding_balance" position="after">
                <field name="is_paid" widget="boolean_toggle" readonly="1"/>
                <button name="action_register_payment" type="object" string="Pay P&amp;I" icon="fa-money"
                        invisible="is_pi_paid" class="btn-link"/>
                <button name="action_register_payment_commission" type="object" string="Pay Commission"
                        icon="fa-money" invisible="is_commission_paid or not commission" class="btn-link"/>
            </field>
        </field>
    </record>
</odoo>
