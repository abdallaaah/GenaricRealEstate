<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="portal_my_home_sale_vendor" inherit_id="sale.portal_my_home_sale">
            <xpath expr="//div[@id='portal_alert_category']" position="attributes">
                <attribute name="t-if">request.env.user.partner_id.sale_portal_user</attribute>
            </xpath>
            <xpath expr="//div[@id='portal_client_category']" position="attributes">
                <attribute name="t-if">request.env.user.partner_id.sale_portal_user</attribute>
            </xpath>
        </template>

        <template id="portal_my_home_purchase_vendor" inherit_id="purchase.portal_my_home_purchase">
            <xpath expr="//div[@id='portal_vendor_category']" position="attributes">
                <attribute name="t-if">request.env.user.partner_id.purchase_portal_user</attribute>
            </xpath>
        </template>

    </data>
</odoo>