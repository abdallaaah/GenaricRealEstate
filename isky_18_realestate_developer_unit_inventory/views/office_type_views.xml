<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="action_office_type" model="ir.actions.act_window">
            <field name="name">Office Type</field>
            <field name="res_model">office.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="office_type_list" model="ir.ui.view">
            <field name="name">office.type.list</field>
            <field name="model">office.type</field>
            <field name="arch" type="xml">
                <list string="Office Type">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="office_type_form" model="ir.ui.view">
            <field name="name">office.type.form</field>
            <field name="model">office.type</field>
            <field name="arch" type="xml">
                <form string="Office Type">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
</odoo>
