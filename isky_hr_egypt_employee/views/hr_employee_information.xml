<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="employee_information_tree_view" model="ir.ui.view">
            <field name="name">Employees Information</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <list>
                    <field name="department_id"/>
                    <field name="gender"/>
                    <field name="name" string="First Name"/>
                    <field name="second_name" string="Middle Name"/>
                    <field name="last_name" string="Last Name"/>
                    <field name="birthday" string="Birth Date"/>
                    <field name="age"/>
                    <field name="country_id" string="Nationality"/>
                    <field name="work_phone"/>
                </list>
            </field>
        </record>

        <record id="employees_information_action" model="ir.actions.act_window">
            <field name="name">Employees Information</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="employee_information_tree_view"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>
