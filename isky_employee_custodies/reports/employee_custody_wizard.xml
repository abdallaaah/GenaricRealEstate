<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_custody_tree_report" model="ir.ui.view">
            <field name="name">view.employee.custody.tree</field>
            <field name="model">employee.custody</field>
            <field name="arch" type="xml">
                <list string="Employee Custody">
                    <field name="name"/>
                    <field name="state" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="custody_date"/>
                    <field name="open_balance"/>
                    <field name="amount_currency" sum="Total"/>
                    <field name="close_balance"/>
                    <field name="currency_id"/>
                    <field name="total_transactions"/>
                </list>
            </field>

        </record>
        <record id="employee_custody_wizard_id" model="ir.ui.view">
            <field name="name">Employee Custody Wizard</field>
            <field name="model">employee.custody.report</field>
            <field name="arch" type="xml">
                <form string="Choose your date">
                    <h1 class="oe_gray">
                        <field name="employee_id"
                               placeholder="Employee ..."
                               options="{'no_create' : True}"/>
                    </h1>
                    <group>
                        <field name="employee_custody_category_id" options="{'no_create' : True}"/>

                    </group>
                    <group col="4">
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>

                    <footer>

                        <button name="display_data"
                                string="View"
                                type="object"
                                class="btn-primary"/>
                        <button name="print_pdf_data"
                                string="Print(PDF)"
                                type="object"
                                class="btn-primary"/>
                        <button name="export_xls"
                                string="Export(XLSX)"
                                type="object"
                                class="btn-primary"/>or
                        <button string="Cancel"
                                class="btn-default"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="employee_custody_action" model="ir.actions.act_window">
            <field name="name">Employee Custody</field>
            <field name="res_model">employee.custody.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="employee_custody_wizard_id"/>
            <field name="target">new</field>
            <field name="context">{'group_by': 'employee_id'}</field>
        </record>
    </data>
</odoo>
