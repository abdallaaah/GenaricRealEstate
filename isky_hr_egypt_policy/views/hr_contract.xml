<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Inherit Contract Form view -->
        <record id="employee_policy_contract" model="ir.ui.view">
            <field name="name">employee.policy.contract.form</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='salary_info']" position="after">
                    <group>
                        <group name="emp_policy" string="Policy Group">
                            <field name="employee_policy_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
