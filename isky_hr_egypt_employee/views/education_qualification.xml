<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_exp_education_qualification_form" model="ir.ui.view">
            <field name="name">view.exp.education.qualification.form</field>
            <field name="model">exp.education.qualification</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="qualification"/>
                                <field name="degree_rate"/>
                                <field name="applicant_id"/>
                            </group>
                            <group>
                                <field name="certificate_level"/>
                                <field name="degree_date"/>
                                <field name="full_rate"/>
                                <field name="employee_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_exp_education_qualification_tree" model="ir.ui.view">
            <field name="name">view.exp_education_qualification.tree</field>
            <field name="model">exp.education.qualification</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="qualification"/>
                    <field name="degree_rate"/>
                    <field name="applicant_id"/>
                    <field name="certificate_level"/>
                    <field name="degree_date"/>
                    <field name="full_rate"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

        <record id="view_exp_education_qualification_search" model="ir.ui.view">
            <field name="name">view.exp_education_qualification.search</field>
            <field name="model">exp.education.qualification</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="qualification"/>
                    <field name="degree_rate"/>
                    <field name="applicant_id"/>
                    <field name="certificate_level"/>
                    <field name="degree_date"/>
                    <field name="full_rate"/>
                    <field name="employee_id"/>
                    <group string="Group By" name="groupby">
                        <filter name="employee_id_groupby" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="applicant_id_groupby" string="Applicant" context="{'group_by': 'applicant_id'}"/>
                        <filter name="full_rate_groupby" string="Full Rate" context="{'group_by': 'full_rate'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="exp_education_qualification_action" model="ir.actions.act_window">
            <field name="name">Education Qualification</field>
            <field name="res_model">exp.education.qualification</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new Partner Education Qualification.
                </p>
            </field>
        </record>

    </data>
</odoo>
