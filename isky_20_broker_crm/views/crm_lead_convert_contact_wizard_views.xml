<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_convert_contact_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.lead.convert.contact.wizard.view.form</field>
        <field name="model">crm.lead.convert.contact.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Contact">
                <field name="lead_id" invisible="1"/>
                <group>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="company_name"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
