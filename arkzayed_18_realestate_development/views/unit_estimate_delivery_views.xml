<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unit_estimate_delivery_tree" model="ir.ui.view">
        <field name="name">unit.estimate.delivery.tree</field>
        <field name="model">unit.estimate.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="unit_type"/>
                <field name="estimate_delivery_years"/>
            </list>
        </field>
    </record>

    <record id="unit_estimate_delivery_form" model="ir.ui.view">
        <field name="name">unit.estimate.delivery.form</field>
        <field name="model">unit.estimate.delivery</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="unit_type"/>
                        <field name="estimate_delivery_years"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unit_estimate_delivery_search" model="ir.ui.view">
        <field name="name">unit.estimate.delivery.search</field>
        <field name="model">unit.estimate.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_type"/>
            </search>
        </field>
    </record>

    <record id="unit_estimate_delivery_action" model="ir.actions.act_window">
        <field name="name">Unit Estimated Delivery Years</field>
        <field name="res_model">unit.estimate.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first unit estimated delivery years configuration
            </p>
        </field>
    </record>

    <menuitem id="menu_unit_estimate_delivery"
              name="Estimated Delivery Years"
              parent="menu_unit_config_root"
              action="unit_estimate_delivery_action"
              sequence="8"/>
</odoo>
