<odoo>
    <data>
        <record id="exp_inh_employee_from_view" model="ir.ui.view">
            <field name="name">exp.inh.employee.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="is_duplicity_tracker"/>
                </xpath>
                <xpath expr="//notebook//page[@name='hr_settings']" position="after">
                    <page name="agent_tree" string="Agent Tree" >
                        <group>
                            <field name="director_id" invisible="not director_id"/>
                            <field name="sales_manager_id" invisible="not sales_manager_id"/>
                            <field name="team_leader_id" invisible="not team_leader_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

