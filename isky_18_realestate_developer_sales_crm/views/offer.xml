<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
        <record id="view_offer_offer_tree" model="ir.ui.view">
            <field name="name">offer.offer.tree</field>
            <field name="model">offer.offer</field>
            <field name="arch" type="xml">
                <list string="Offers">
                    <field name="system_code"/>
                    <field name="unit_id"/>
                    <field name="installment_plan_id"/>
                    <field name="installemnt_years"/>
                    <field name="down_payment" widget="percentage"/>
                    <field name="down_payment_date"/>
                    <field name="maintenance_percentage" widget="percentage"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>
        <record id="view_offer_offer_form" model="ir.ui.view">
            <field name="name">offer.offer.form</field>
            <field name="model">offer.offer</field>
            <field name="arch" type="xml">
                <form string="Offer">
                    <header>
                        <button name="action_print_combined_documents"
                                string="Unit Documents"
                                type="object"
                                class="btn-info"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Unit Information">
                                <field name="unit_id"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="system_code"/>
                            </group>

                            <group string="Installment Plan">
                                <field name="installment_plan_id" readonly="1"/>
                                <field name="installemnt_years"/>
                                <field name="down_payment" widget="percentage"/>
                                <field name="down_payment_date"/>
                                <field name="maintenance_percentage" widget="percentage"/>
                            </group>
                        </group>

                        <group>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_offer_offer_search" model="ir.ui.view">
            <field name="name">offer.offer.search</field>
            <field name="model">offer.offer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="system_code"/>
                    <field name="unit_id"/>
                    <group expand="0" string="Group By">
                        <filter string="Unit" name="group_unit" context="{'group_by':'unit_id'}"/>
                        <filter string="Installment Plan" name="group_plan" context="{'group_by':'installment_plan_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_offer_offer" model="ir.actions.act_window">
            <field name="name">Offers</field>
            <field name="res_model">offer.offer</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
