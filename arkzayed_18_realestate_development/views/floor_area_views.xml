<odoo>
    <data>
         <record id="floor_area_tree" model="ir.ui.view">
            <field name="name">floor_area_tree</field>
            <field name="model">floor.area</field>
            <field name="arch" type="xml">
                <list string="Floor Area">
                    <field name="name"/>
                    <field name="abbreviation"/>
                    <field name="code"/>
                    <field name="system_code"/>
                    <field name="company_id"/>
                    <field name="unit_count" optional="show"/>
                    <field name="total_gross_area" optional="show" sum="Total Gross Area"/>
                    <field name="total_new_gross_area" optional="show" sum="Total New Gross Area"/>

                </list>
            </field>
         </record>
        <record id="floor_area_form" model="ir.ui.view">
            <field name="name">floor_area_form</field>
            <field name="model">floor.area</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="abbreviation"/>
                            <field name="code"/>
                            <field name="parent_source_id"/>
                            <field name="location" invisible="1"/>
                            <field name="system_code"/>
                            <field name="company_id"/>
                            <field name="project_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="floor_area_action">
            <field name="name">Floor Area</field>
            <field name="res_model">floor.area</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>