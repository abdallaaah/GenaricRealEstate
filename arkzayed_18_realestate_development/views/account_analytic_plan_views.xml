<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="analytic_account_view_form_inherit" model="ir.ui.view">
            <field name="model">account.analytic.plan</field>
            <field name="name">account.analytic.plan.form.inherit</field>
            <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
            <field name="arch" type="xml">
                <field name="color" position="after">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="is_project"/>
                    <field name="is_building"/>
                    <field name="is_unit"/>
                    <field name="is_sale"/>
                    <field name="is_wip"/>
                </field>
            </field>
        </record>

    <record id="account_analytic_plan_view_tree_inherit" model="ir.ui.view">
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </field>
        </field>
    </record>
</odoo>