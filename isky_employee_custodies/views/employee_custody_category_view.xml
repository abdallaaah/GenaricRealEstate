<?xml version="1.0"?>
<odoo>
    <data>
        <record id="employee_custody_category_form" model="ir.ui.view">
            <field name="name">employee.custody.category.form.view</field>
            <field name="model">employee.custody.category</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Employee Custody Category">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                            <div name="options">
                                <div>
                                    <field name="fixed"/>
                                    <label for="fixed"/>
                                </div>
                            </div>
                        </div>
                        <group>
                            <field name="custody_description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
