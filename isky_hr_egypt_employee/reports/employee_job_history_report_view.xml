<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
           <record id="employee_job_history_report" model="ir.actions.report">
            <field name="name"> Job Position Report</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">isky_hr_egypt_employee.employee_job_history_template</field>
            <field name="report_file">isky_hr_egypt_employee.employee_job_history_template</field>
            <field name="print_report_name">' Employee- %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_hr_employee"/>
            <field name="binding_type">report</field>
            <!-- Erase fields to avoid double PDF posting -->
            <field name="attachment"></field>
            <field name="attachment_use" eval="False"/>
        </record>

        <template id="employee_job_history_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <center>
                                <h3>Job Position Report</h3>
                            </center>
                            <br/>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Employee Code</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.job_history_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-field="line.employee_id.display_name"/>
                                            </td>

                                            <td>
                                                <span t-field="line.employee_id.emp_no"/>
                                            </td>

                                            <td>
                                                <span t-field="line.job_id.display_name"/>
                                            </td>

                                            <td>
                                                <span t-field="line.to_job_id.display_name"/>
                                            </td>

                                            <td>
                                                <span t-field="line.date"/>
                                            </td>

                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
