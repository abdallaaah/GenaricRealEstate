<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
    <record id="view_price_increase_tree" model="ir.ui.view">
        <field name="name">down.payment.increase.tree</field>
        <field name="model">down.payment.increase</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_type" readonly="unit_type == 'residential'"/>
<!--                <field name="percentage_increase"/>-->
<!--                <field name="number_of_years"/>-->
<!--                <field name="down_payment"/>-->
            </list>
        </field>
    </record>
    <record id="view_price_increase_form" model="ir.ui.view">
        <field name="name">down.payment.increase.form</field>
        <field name="model">down.payment.increase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group cols="2">
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="unit_type" readonly="unit_type == 'residential'"/>
                        </group>
                        <group>
                            <field name="price_plan_ids" colspan="1">
                                    <list editable="bottom"  delete="true" >
                                        <field name="year_no"/>
                                        <field name="down_payment"/>
                                        <field name="percentage_increase"/>
                                    </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_price_increase" model="ir.actions.act_window">
        <field name="name">Price Increase Plans</field>
        <field name="res_model">down.payment.increase</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Price Increase Plan
            </p>
            <p>
                Define percentage increases that can be applied to unit prices based on number of years.
            </p>
        </field>
    </record>
</odoo>
