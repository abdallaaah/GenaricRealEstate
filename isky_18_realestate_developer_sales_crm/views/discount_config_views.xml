<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
        <record id="view_discount_config_form" model="ir.ui.view">
            <field name="name">discount.config.form</field>
            <field name="model">discount.config</field>
            <field name="arch" type="xml">
                <form string="Discount Configuration">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Configuration Details">
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <group string="Additional Information">
                                <field name="description" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_discount_config_list" model="ir.ui.view">
            <field name="name">discount.config.list</field>
            <field name="model">discount.config</field>
            <field name="arch" type="xml">
                <list string="Discount Configurations">
                    <field name="name"/>
                    <field name="active" widget="boolean"/>
                </list>
            </field>
        </record>
        <record id="view_discount_config_search" model="ir.ui.view">
            <field name="name">discount.config.search</field>
            <field name="model">discount.config</field>
            <field name="arch" type="xml">
                <search string="Discount Configurations">
                    <field name="name"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Status" name="group_status" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_discount_config" model="ir.actions.act_window">
            <field name="name">Discount Configuration</field>
            <field name="res_model">discount.config</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_discount_config_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first discount configuration
                </p>
            </field>
        </record>
</odoo>
