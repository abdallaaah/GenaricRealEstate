<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- from arkzayed_18_realestate_development/views/charts_of_accounts_views.xml -->
    <record id="view_account_journal_form_inherited" model="ir.ui.view">
        <field name="name">view.account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="is_security_deposit"/>
                <field name="is_reconcile_journal"/>
            </xpath>
        </field>
    </record>
</odoo>
