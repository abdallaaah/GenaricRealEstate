<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Phase 3 step 2a: 8 groups moved out of this module - 7 to
             isky_18_realestate_developer_sales_crm (they gate sale.proposal / reservation
             behaviour) and group_block_unit to isky_18_realestate_developer_unit_inventory
             (it gates blocking a unit). They were unreachable from those modules here. -->

        <record id="module_category_engineer_menu" model="ir.module.category">
            <field name="name">Engineer Menu</field>
        </record>
        <record id="group_engineer_menu" model="res.groups">
            <field name="name">Engineer Menu Access</field>
            <field name="category_id" ref="module_category_engineer_menu"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can open Real Estate &gt; Engineer Menu (Residential, Admin &amp; Retail and Medical unit lists) and export them to Excel.</field>
        </record>

        <record id="contract_rollback_group" model="res.groups">
            <field name="name">contract rollback group</field>
        </record>
        <record id="group_share_revenue_user" model="res.groups">
            <field name="name">Share Revenue User</field>
        </record>
        <record id="group_share_revenue_admin" model="res.groups">
            <field name="name">Share Revenue Admin</field>
            <field name="implied_ids" eval="[(4, ref('arkzayed_18_realestate_development.group_share_revenue_user'))]"/>
        </record>
        <record id="stop_checking_reservation_expiration" model="res.groups">
            <field name="name">Reservation Expiration Manager</field>
        </record>
        <record id="can_reserve_available_units" model="res.groups">
            <field name="name">Can Reserve Available Units</field>
        </record>

        <record id="crm_team_company_rule" model="ir.rule">
            <field name="name">crm_team_company_rule</field>
            <field name="model_id" ref="crm.model_crm_team"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="account_analytic_plan_company_rule" model="ir.rule">
            <field name="name">Analytic Plan: Multi-company</field>
            <field name="model_id" ref="analytic.model_account_analytic_plan"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="project_assignees_rule" model="ir.rule">
            <field name="name">Project Assignees</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('assignees_ids', 'in', [user.id])]</field>
        </record>
        <record id="task_assignees_rule" model="ir.rule">
            <field name="name">Task Assignees</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('assignees_ids', 'in', [user.id])]</field>
        </record>

        <record id="payment_cfo_group" model="res.groups">
            <field name="name">Payment CFO</field>
        </record>

        <record id="payment_deputy_cfo_group" model="res.groups">
            <field name="name">Payment Deputy CFO</field>
        </record>

        <record id="group_operation_manager_approval" model="res.groups">
            <field name="name">Operation Manager Approval</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>

        <record id="revenue_share2_company_rule" model="ir.rule">
            <field name="name">revenue share2 company</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_revenue_share2"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="eoi_eoi_company_rule" model="ir.rule">
            <field name="name">eoi eoi company</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_eoi_eoi"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="sale_proposal_company_rule" model="ir.rule">
            <field name="name">sale proposal company</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_sale_proposal"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="sale_reservation_company_rule" model="ir.rule">
            <field name="name">sale reservation company</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_real_estate_sale_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="broker_contract_company_rule" model="ir.rule">
            <field name="name">Broker Contract: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_commission.model_broker_contract"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="broker_claim_company_rule" model="ir.rule">
            <field name="name">Broker Claim: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_commission.model_broker_claim"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="maintenance_template_company_rule" model="ir.rule">
            <field name="name">Maintenance Template: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_unit_inventory.model_maintenance_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="project_commission_company_rule" model="ir.rule">
            <field name="name">Project Commission: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_commission.model_realestate_project_commission"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="customer_ownership_company_rule" model="ir.rule">
            <field name="name">Customer Ownership: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_sales_crm.model_customer_ownership"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="capex_scope_company_rule" model="ir.rule">
            <field name="name">Capex Scope: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_construction.model_capex_scope"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="installment_template_company_rule" model="ir.rule">
            <field name="name">Installment Template: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_unit_inventory.model_installment_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <!-- Per-action permissions controlling Reservation action button visibility -->
        <record id="group_calculate_installments" model="res.groups">
            <field name="name">Reservation: Calculate Installments</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <record id="group_calculate_maintenance" model="res.groups">
            <field name="name">Reservation: Calculate Maintenance</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <record id="group_create_payment" model="res.groups">
            <field name="name">Reservation: Create Payment</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <record id="group_check_payment" model="res.groups">
            <field name="name">Reservation: Check Payment</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <record id="group_create_contract_action" model="res.groups">
            <field name="name">Reservation: Create Contract</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <!-- #60: this record sits AFTER group_create_contract_action on purpose - it implies that
             group, and Odoo loads records in file order, so on a fresh database the earlier
             position raised "External ID not found" (decisions log, 2026-11-07). -->
        <record id="group_create_contract" model="res.groups">
            <field name="name">Create Contract Before Confirmation</field>
            <field name="implied_ids" eval="[(4, ref('arkzayed_18_realestate_development.group_create_contract_action'))]"/>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>
        <record id="vendor_commitment_company_rule" model="ir.rule">
            <field name="name">Vendor Commitment: Restrict by Company</field>
            <field name="model_id" ref="isky_18_realestate_developer_construction.model_vendor_commitment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="group_payment_receipt_signature" model="res.groups">
            <field name="name">Payment Receipt with Signature Access</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
        </record>
        <record id="group_restrict_net_area_visibility" model="res.groups">
            <field name="name">Restrict Net Area Visibility</field>
            <field name="category_id" ref="isky_18_realestate_developer_unit_inventory.module_category_real_state_project_assigned"/>
        </record>

        <!-- group_manual_paid_installment moved to
             isky_18_realestate_developer_sales_crm/security/security.xml (Phase 3 step 1):
             it gates an installment.lines action, which is a sales_crm model. -->
    </data>

    <data noupdate="1">
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_engineer_menu'))]"/>
        </record>
    </data>
</odoo>
