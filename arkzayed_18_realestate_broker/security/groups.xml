        <record id="lead_admin_group" model="res.groups">
            <field name="name">Lead Admin</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="finance_group" model="res.groups">
            <field name="name">Finance</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="permission_request_approval_button" model="res.groups">
            <field name="name">permission request approval button</field>
        </record>

        <!-- Record Rules for Permission Requests -->
        <!-- Admin can see all requests -->
        <record id="permission_request_admin_rule" model="ir.rule">
            <field name="name">Admin sees all permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Operations can see all requests -->
        <record id="permission_request_operations_rule" model="ir.rule">
            <field name="name">Sales Sector Manager sees all permission requests</field>
            <field name="model_id" ref="model_permission_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('operation_manager_group'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Operation executive can see all requests -->
