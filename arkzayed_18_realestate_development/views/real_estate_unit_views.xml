<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Server Action: convert selected units from "Available" to "Available For Sale" -->
        <record id="action_convert_available_for_sale" model="ir.actions.server">
            <field name="name">Convert to Available For Sale</field>
            <field name="model_id" ref="isky_18_realestate_developer_unit_inventory.model_real_estate_unit"/>
            <field name="binding_model_id" ref="isky_18_realestate_developer_unit_inventory.model_real_estate_unit"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code"><![CDATA[
for rec in records:
    if rec.unit_status == 'available':
        rec.action_available_for_sale()
            ]]></field>
        </record>



        <!-- Filter by Block Reason view  -->





    </data>
</odoo>
