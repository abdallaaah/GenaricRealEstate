<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_proposal_sales_analysis_wizard_view_form" model="ir.ui.view">
            <field name="name">sale.proposal.sales.analysis.wizard.form</field>
            <field name="model">sale.proposal.sales.analysis.wizard</field>
            <field name="arch" type="xml">
                <form string="Sales Analysis Report">
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from" required="1"/>
                                <field name="date_to" required="1"/>
                            </group>
                        </group>
                        <group>
                            <label for="business_unit_type_ids" string="Business Unit Types to Include"/>
                            <field name="business_unit_type_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_pdf"
                                string="Generate PDF"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_generate_excel"
                                string="Generate Excel"
                                type="object"
                                class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_proposal_sales_analysis_wizard" model="ir.actions.act_window">
            <field name="name">Sales Analysis Report</field>
            <field name="res_model">sale.proposal.sales.analysis.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Action -->
        <menuitem
            id="menu_sale_proposal_sales_analysis"
            name="Sales Analysis Report"
            parent="menu_sales_root"
            action="action_sale_proposal_sales_analysis_wizard"
            sequence="10"/>

    </data>
</odoo>