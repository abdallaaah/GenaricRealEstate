<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="broker_feature_flag_view_list" model="ir.ui.view">
        <field name="name">broker.feature.flag.view.list</field>
        <field name="model">broker.feature.flag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>

    <record id="broker_feature_flag_view_form" model="ir.ui.view">
        <field name="name">broker.feature.flag.view.form</field>
        <field name="model">broker.feature.flag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="enabled"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="broker_feature_flag_action" model="ir.actions.act_window">
        <field name="name">Portal Feature Flags</field>
        <field name="res_model">broker.feature.flag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
