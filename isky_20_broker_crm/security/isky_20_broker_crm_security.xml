        <field name="name">Deal Approval: Manager</field>
        <field name="privilege_id" ref="isky_20_broker_base.res_groups_privilege_broker"/>
    </record>
    <record id="group_financial_manager" model="res.groups">
        <field name="name">Deal Approval: Financial Manager</field>
        <field name="privilege_id" ref="isky_20_broker_base.res_groups_privilege_broker"/>
    </record>
    <record id="group_director_manager" model="res.groups">
        <field name="name">Director</field>
