<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                                     <!-- Paper Format -->
        <record id="paperformat_vendor_commitment_a4" model="report.paperformat">
            <field name="name">Vendor Commitment A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

                              <!-- Report Action for Single Record -->
        <record id="vendor_commitment_report_action" model="ir.actions.report">
            <field name="name">Vendor Commitment Report</field>
            <field name="model">vendor.commitment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">arkzayed_18_realestate_development.vendor_commitment_single_report_template</field>
            <field name="report_file">arkzayed_18_realestate_development.vendor_commitment_single_report_template</field>
            <field name="print_report_name">'تحليل التزامات الموردين - %s' % (object.commitment_type)</field>
            <field name="binding_model_id" ref="isky_18_realestate_developer_construction.model_vendor_commitment"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">form</field>
            <field name="paperformat_id" ref="paperformat_vendor_commitment_a4"/>
        </record>

                             <!-- Report Action for Multi-Record -->
        <record id="vendor_commitment_multi_report_action" model="ir.actions.report">
            <field name="name">Vendor Commitment Multi Report</field>
            <field name="model">vendor.commitment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">arkzayed_18_realestate_development.vendor_commitment_multi_report_template</field>
            <field name="report_file">arkzayed_18_realestate_development.vendor_commitment_multi_report_template</field>
            <field name="print_report_name">'تحليل التزامات الموردين - %s' % (time.strftime('%Y-%m-%d'))</field>
            <field name="paperformat_id" ref="paperformat_vendor_commitment_a4"/>
            <field name="binding_model_id" ref="isky_18_realestate_developer_construction.model_vendor_commitment"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">list</field>
        </record>

                                  <!-- Single record template -->
        <template id="vendor_commitment_single_report_template">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page" style="direction: rtl; font-family: 'DejaVu Sans', Arial, sans-serif;">
                            <style>
                                body {
                                    font-family: 'DejaVu Sans', Arial, sans-serif;
                                    direction: rtl;
                                }

                                .vc-header-block {
                                    text-align: right;
                                    direction: rtl;
                                    margin-bottom: 8px;
                                }
                                .vc-header-block .vc-company-name {
                                    font-size: 13pt;
                                    font-weight: bold;
                                    color: #000;
                                }
                                .vc-header-block .vc-company-subtitle {
                                    font-size: 9pt;
                                    color: #333;
                                }
                                .vc-header-block .vc-report-title {
                                    font-size: 10pt;
                                    color: #333;
                                }
                                .vc-header-block .vc-date-line {
                                    font-size: 8.5pt;
                                    color: #333;
                                    direction: ltr;
                                    text-align: right;
                                }

                                .vc-main-title {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-bottom: 0;
                                }
                                .vc-main-title td {
                                    background-color: #2E5FA1;
                                    color: #fff;
                                    font-size: 11pt;
                                    font-weight: bold;
                                    text-align: center;
                                    padding: 6px 10px;
                                    border: 1px solid #000;
                                }

                                .vc-data-table {
                                    width: 100%;
                                    border-collapse: collapse;
                                    margin-top: 0;
                                }
                                .vc-data-table th {
                                    background-color: #D9E1F2;
                                    border: 1px solid #000;
                                    padding: 5px 3px;
                                    font-size: 7.5pt;
                                    font-weight: bold;
                                    text-align: center;
                                    vertical-align: middle;
                                    line-height: 1.3;
                                    white-space: nowrap;
                                }
                                .vc-data-table td {
                                    border: 1px solid #000;
                                    padding: 4px 3px;
                                    font-size: 7.5pt;
                                    text-align: center;
                                    vertical-align: middle;
                                }
                                .vc-data-table .td-number {
                                    text-align: center;
                                    direction: ltr;
                                }
                                .vc-data-table .td-date {
                                    text-align: center;
                                    direction: ltr;
                                    white-space: nowrap;
                                }
                                .vc-data-table .td-seq {
                                    text-align: center;
                                    font-weight: bold;
                                }

                                .vc-total-row td {
                                    background-color: #D9D9D9;
                                    font-weight: bold;
                                    border: 1px solid #000;
                                    padding: 5px 3px;
                                    font-size: 7.5pt;
                                    text-align: center;
                                    vertical-align: middle;
                                }
                                .vc-total-row .td-number {
                                    text-align: center;
                                    direction: ltr;
                                }

                                @page {
                                    size: A4 landscape;
                                    margin: 10mm 7mm;
                                }
                            </style>

                            <t t-set="today" t-value="datetime.date.today()"/>
                            <div class="vc-header-block">
                                <div class="vc-company-name">ذا ارك</div>
                                <div class="vc-company-subtitle">ذا ارك جروب للتطوير العقاري</div>
                                <t t-if="o.commitment_type == 'letter_of_guarantee'">
                                    <div class="vc-report-title">تحليل خطابات الضمان</div>
                                </t>
                                <t t-if="o.commitment_type == 'permits'">
                                    <div class="vc-report-title">تحليل التصاريح</div>
                                </t>
                                <div class="vc-date-line">
                                    <t t-esc="today.strftime('%A, %B %d, %Y')"/>
                                    &#160;&#160;&#160;التاريخ
                                </div>
                            </div>

                            <t t-if="o.commitment_type == 'letter_of_guarantee'">
                                <table class="vc-main-title">
                                    <tr>
                                        <td>تحليل خطابات الضمان</td>
                                    </tr>
                                </table>

                                <table class="vc-data-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 3%;">م</th>
                                            <th style="width: 13%;">اسم الشركة</th>
                                            <th style="width: 13%;">تاريخ الاستحقاق</th>
                                            <th style="width: 9%;">رقم الشيك</th>
                                            <th style="width: 13%;">البنك المستفيد</th>
                                            <th style="width: 13%;">البنك المصدر</th>
                                            <th style="width: 14%;">رقم المبني</th>
                                            <th style="width: 11%;">المبلغ</th>
                                            <th style="width: 11%;">نسبة شيكات الضمان من الاعمال</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="td-seq">1</td>
                                            <td><t t-esc="o.vendor_id.name"/></td>
                                            <td class="td-date">
                                                <t t-if="o.end_date">
                                                    <t t-esc="o.end_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td class="td-number">
                                                <t t-esc="o.check_number or ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="o.beneficiary_bank_id.name if o.beneficiary_bank_id else ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="o.issuing_bank_id.name if o.issuing_bank_id else ''"/>
                                            </td>
                                            <td>
                                                <t t-esc="o.building_names_display or ''"/>
                                            </td>
                                            <td class="td-number">
                                                <t t-esc="'{:,.2f}'.format(o.lg_value or 0.0)"/>
                                            </td>
                                            <td class="td-number">
                                                <t t-if="o.guarantee_checks_percent">
                                                    <t t-esc="'{:.2f}%'.format(o.guarantee_checks_percent)"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="vc-total-row">
                                            <td style="width: 3%;"></td>
                                            <td style="width: 13%;">الإجمالي</td>
                                            <td style="width: 13%;"></td>
                                            <td style="width: 9%;"></td>
                                            <td style="width: 13%;"></td>
                                            <td style="width: 13%;"></td>
                                            <td style="width: 14%;"></td>
                                            <td style="width: 11%;" class="td-number">
                                                <t t-esc="'{:,.2f}'.format(o.lg_value or 0.0)"/>
                                            </td>
                                            <td style="width: 11%;"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="o.commitment_type == 'permits'">
                                <table class="vc-main-title">
                                    <tr>
                                        <td>تحليل التصاريح</td>
                                    </tr>
                                </table>

                                <table class="vc-data-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 6%;">م</th>
                                            <th style="width: 28%;">اسم الشركة</th>
                                            <th style="width: 22%;">تاريخ البداية</th>
                                            <th style="width: 22%;">تاريخ الانتهاء</th>
                                            <th style="width: 22%;">الاسم</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="td-seq">1</td>
                                            <td><t t-esc="o.vendor_id.name"/></td>
                                            <td class="td-date">
                                                <t t-if="o.start_date">
                                                    <t t-esc="o.start_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td class="td-date">
                                                <t t-if="o.end_date">
                                                    <t t-esc="o.end_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-esc="o.permit_name or ''"/>
                                            </td>
                                        </tr>
                                        <tr class="vc-total-row">
                                            <td style="width: 6%;"></td>
                                            <td style="width: 28%;">الإجمالي</td>
                                            <td style="width: 22%;"></td>
                                            <td style="width: 22%;"></td>
                                            <td style="width: 22%;"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                        </div>
                    </t>
                </t>
            </t>
        </template>

                                             <!-- MULTI RECORD TEMPLATE  -->
        <template id="vendor_commitment_multi_report_template">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page" style="direction: rtl; font-family: 'DejaVu Sans', Arial, sans-serif;">
                        <style>
                            body {
                                font-family: 'DejaVu Sans', Arial, sans-serif;
                                direction: rtl;
                            }

                            .vc-header-block {
                                text-align: right;
                                direction: rtl;
                                margin-bottom: 8px;
                            }
                            .vc-header-block .vc-company-name {
                                font-size: 13pt;
                                font-weight: bold;
                                color: #000;
                            }
                            .vc-header-block .vc-company-subtitle {
                                font-size: 9pt;
                                color: #333;
                            }
                            .vc-header-block .vc-report-title {
                                font-size: 10pt;
                                color: #333;
                            }
                            .vc-header-block .vc-date-line {
                                font-size: 8.5pt;
                                color: #333;
                                direction: ltr;
                                text-align: right;
                            }

                            .vc-main-title {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 0;
                                margin-top: 15px;
                            }
                            .vc-main-title td {
                                background-color: #2E5FA1;
                                color: #fff;
                                font-size: 11pt;
                                font-weight: bold;
                                text-align: center;
                                padding: 6px 10px;
                                border: 1px solid #000;
                            }

                            .vc-data-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 0;
                            }
                            .vc-data-table th {
                                background-color: #D9E1F2;
                                border: 1px solid #000;
                                padding: 5px 3px;
                                font-size: 7.5pt;
                                font-weight: bold;
                                text-align: center;
                                vertical-align: middle;
                                line-height: 1.3;
                                white-space: nowrap;
                            }
                            .vc-data-table td {
                                border: 1px solid #000;
                                padding: 4px 3px;
                                font-size: 7.5pt;
                                text-align: center;
                                vertical-align: middle;
                            }
                            .vc-data-table .td-number {
                                text-align: center;
                                direction: ltr;
                            }
                            .vc-data-table .td-date {
                                text-align: center;
                                direction: ltr;
                                white-space: nowrap;
                            }
                            .vc-data-table .td-seq {
                                text-align: center;
                                font-weight: bold;
                            }

                            .vc-total-row td {
                                background-color: #D9D9D9;
                                font-weight: bold;
                                border: 1px solid #000;
                                padding: 5px 3px;
                                font-size: 7.5pt;
                                text-align: center;
                                vertical-align: middle;
                            }
                            .vc-total-row .td-number {
                                text-align: center;
                                direction: ltr;
                            }

                            @page {
                                size: A4 landscape;
                                margin: 10mm 7mm;
                            }
                        </style>

                        <t t-set="today" t-value="datetime.date.today()"/>

                        <div class="vc-header-block">
                            <div class="vc-company-name">ذا ارك</div>
                            <div class="vc-company-subtitle">ذا ارك جروب للتطوير العقاري</div>
                            <div class="vc-report-title">تحليل التزامات الموردين</div>
                            <div class="vc-date-line">
                                <t t-esc="today.strftime('%A, %B %d, %Y')"/>
                                &#160;&#160;&#160;التاريخ
                            </div>
                        </div>

                        <t t-set="permit_records" t-value="docs.filtered(lambda r: r.commitment_type == 'permits')"/>
                        <t t-set="lg_records" t-value="docs.filtered(lambda r: r.commitment_type == 'letter_of_guarantee')"/>

                        <t t-if="permit_records">
                            <table class="vc-main-title">
                                <tr><td>تحليل التصاريح</td></tr>
                            </table>

                            <table class="vc-data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 6%;">م</th>
                                        <th style="width: 28%;">اسم الشركة</th>
                                        <th style="width: 22%;">تاريخ البداية</th>
                                        <th style="width: 22%;">تاريخ الانتهاء</th>
                                        <th style="width: 22%;">الاسم</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="seq" t-value="0"/>
                                    <t t-foreach="permit_records" t-as="o">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <tr>
                                            <td class="td-seq"><t t-esc="seq"/></td>
                                            <td><t t-esc="o.vendor_id.name"/></td>
                                            <td class="td-date">
                                                <t t-if="o.start_date">
                                                    <t t-esc="o.start_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td class="td-date">
                                                <t t-if="o.end_date">
                                                    <t t-esc="o.end_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td><t t-esc="o.permit_name or ''"/></td>
                                        </tr>
                                    </t>

                                    <tr class="vc-total-row">
                                        <td style="width: 6%;"></td>
                                        <td style="width: 28%;">الإجمالي</td>
                                        <td style="width: 22%;"></td>
                                        <td style="width: 22%;"></td>
                                        <td style="width: 22%;"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="lg_records">
                            <table class="vc-main-title">
                                <tr><td>تحليل خطابات الضمان</td></tr>
                            </table>

                            <table class="vc-data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 3%;">م</th>
                                        <th style="width: 13%;">اسم الشركة</th>
                                        <th style="width: 13%;">تاريخ الاستحقاق</th>
                                        <th style="width: 9%;">رقم الشيك</th>
                                        <th style="width: 13%;">البنك المستفيد</th>
                                        <th style="width: 13%;">البنك المصدر</th>
                                        <th style="width: 14%;">رقم المبني</th>
                                        <th style="width: 11%;">المبلغ</th>
                                        <th style="width: 11%;">نسبة شيكات الضمان من الاعمال</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="lg_total" t-value="0.0"/>
                                    <t t-set="seq" t-value="0"/>
                                    <t t-foreach="lg_records" t-as="o">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <t t-set="lg_total" t-value="lg_total + (o.lg_value or 0.0)"/>
                                        <tr>
                                            <td class="td-seq"><t t-esc="seq"/></td>
                                            <td><t t-esc="o.vendor_id.name"/></td>
                                            <td class="td-date">
                                                <t t-if="o.end_date">
                                                    <t t-esc="o.end_date.strftime('%A, %B %d, %Y')"/>
                                                </t>
                                            </td>
                                            <td class="td-number"><t t-esc="o.check_number or ''"/></td>
                                            <td><t t-esc="o.beneficiary_bank_id.name if o.beneficiary_bank_id else ''"/></td>
                                            <td><t t-esc="o.issuing_bank_id.name if o.issuing_bank_id else ''"/></td>
                                            <td><t t-esc="o.building_names_display or ''"/></td>
                                            <td class="td-number"><t t-esc="'{:,.2f}'.format(o.lg_value or 0.0)"/></td>
                                            <td class="td-number">
                                                <t t-if="o.guarantee_checks_percent">
                                                    <t t-esc="'{:.2f}%'.format(o.guarantee_checks_percent)"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>

                                    <tr class="vc-total-row">
                                        <td style="width: 3%;"></td>
                                        <td style="width: 13%;">الإجمالي</td>
                                        <td style="width: 13%;"></td>
                                        <td style="width: 9%;"></td>
                                        <td style="width: 13%;"></td>
                                        <td style="width: 13%;"></td>
                                        <td style="width: 14%;"></td>
                                        <td style="width: 11%;" class="td-number"><t t-esc="'{:,.2f}'.format(lg_total)"/></td>
                                        <td style="width: 11%;"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>