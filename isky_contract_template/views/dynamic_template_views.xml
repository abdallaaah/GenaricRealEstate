<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_dynamic_template" model="ir.ui.view">
        <field name="name">dynamic.template.form</field>
        <field name="model">dynamic.template</field>
        <field name="arch" type="xml">
            <form string="Dynamic Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <group>
                        <field name="name" required="1"/>
                        <field name="with_logo"/>
                        <field name="word_file" filename="word_filename"/>
                        <field name="word_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body_html" widget="html" class="oe-bordered-editor"
                                   options="{'style-inline': true,  'dynamic_placeholder': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_dynamic_template" model="ir.ui.view">
        <field name="name">dynamic.template.list</field>
        <field name="model">dynamic.template</field>
        <field name="arch" type="xml">
            <list string="Dynamic Templates">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_template_action" model="ir.actions.act_window">
        <field name="name">Dynamic Templates</field>
        <field name="res_model">dynamic.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dynamic_template_menu"
              action="view_dynamic_template_action"
              name="Dynamic Templates" sequence="10"
              web_icon="isky_contract_template,static/description/icon.png"/>
</odoo>