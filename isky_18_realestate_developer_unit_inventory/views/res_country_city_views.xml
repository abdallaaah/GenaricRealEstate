<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_developer_crm, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="view_country_city_list" model="ir.ui.view">
            <field name="name">view.country.city.list</field>
            <field name="model">res.country.city</field>
            <field name="arch" type="xml">
                <list string="City">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="governorate_id"/>
                </list>
            </field>
        </record>
        <record id="view_country_city_form" model="ir.ui.view">
            <field name="name">view.country.city.form</field>
            <field name="model">res.country.city</field>
            <field name="arch" type="xml">
                <form string="City">
                    <sheet>
                        <group>
                            <group>
                                <field name="id"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="governorate_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_couuntry_city" model="ir.actions.act_window">
            <field name="name">Districts</field>
            <field name="res_model">res.country.city</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
