<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="paperformat_euro_landscape" model="report.paperformat">
            <field name="name">A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">7</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">7</field>
            <field name="dpi">90</field>
        </record>
         <record id="insurance_form_2_report" model="ir.actions.report">
            <field name="name">Insurance Form</field>
            <field name="model">hr.insurance</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">isky_hr_egypt_social_insurance.insurance_form_2_template</field>
            <field name="report_file">isky_hr_egypt_social_insurance.insurance_form_2_template</field>
            <field name="print_report_name">'Insurance Form Report'</field>
            <field name="binding_model_id" ref="model_hr_insurance"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="isky_hr_egypt_social_insurance.paperformat_euro_landscape"/>
        </record>
        <template id="insurance_form_2_header">
            <div class="row mb-2 pb-3" style="border-bottom: 1px solid;">
                <div class="col-4 text-right">
                    <p style="font-family: 'Qahiri', sans-serif;">الهـيئة القـومية للتـأمين الاجتـماعي</p>
                    <p>
                        <span>منطقة: </span>
                        <span class="pr-4" t-field="o.company_id.insurance_office_zone"/>
                    </p>
                    <p>
                        <span>مكـتب: </span>
                        <span class="pr-4" t-field="o.company_id.insurance_office"/>
                    </p>
                </div>
                <div class="col-4 text-center">
                    <img style="text-align:center;max-width:200px" src="/isky_hr_egypt_social_insurance/static/img/insurance_logo.jpg"/>
                </div>
                <div class="col-4 text-right">
                    <p style="padding-top:65px">
                        <span>رقم المنشأة</span>
                        <span class="pr-4" t-field="o.company_id.company_registry"/>
                    </p>
                </div>
            </div>
        </template>
        <template id="insurance_form_2_template">

                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page" dir="auto">
                            <style>
                                @import url('https://fonts.googleapis.com/css2?family=Markazi+Text');
                                @import url('https://fonts.googleapis.com/css2?family=Qahiri');
                                th, td, span, p{
                                font-family: 'Markazi Text', serif;
                                }
                                table.meta-info td{
                                text-align:right;
                                }
                                table.employees-data td, table.employees-data th{
                                text-align:right;
                                border: 1px solid;
                                padding: 5px;
                                }
                            </style>
                            <t t-call="isky_hr_egypt_social_insurance.insurance_form_2_header"/>
                            <div class="text-center">
                                <p>طلب اشتراك منشأة</p>
                                <p>او اخطار بيانات المؤمن عليهم وأجورهم</p>
                                <p style="margin-right: 150px">في: </p>
                            </div>
                            <table class="meta-info" width="100%">
                                <tr>
                                    <td>اسم المنشأة</td>
                                    <td><span t-field="o.company_id.name"/></td>
                                    <td>المالك/المدير المسئول</td>
                                    <td><span t-field="o.company_id.owner.name"/></td>
                                    <td colspan="2">الشكل القانوني للمنشأة</td>
                                    <td colspan="2"></td>
                                </tr>
                                <tr>
                                    <td>عنوان المنشأة</td>
                                    <td><span t-field="o.company_id.street"/></td>

                                    <td>الشياخة/القرية</td>
                                    <td><span t-field="o.company_id.city"/></td>

                                    <td>القسم/المركز</td>
                                    <td><span t-field="o.company_id.state_id.name"/></td>

                                    <td>المحافظة</td>
                                    <td><span t-field="o.company_id.state_id.name"/></td>
                                </tr>
                                <tr>
                                    <td>نسبة تامين المرض</td>
                                    <td></td>

                                    <td>تاريخ بدء النسبة</td>
                                    <td>1/1/2021</td>

                                    <td>نسبة تامين الاصابة</td>
                                    <td></td>

                                    <td>تاريخ بدء النسبة</td>
                                    <td>1/1/2021</td>
                                </tr>
                                <tr>
                                    <td colspan="2">تاريخ التوقف/الاستمرار</td>
                                    <td>1/1/2021</td>

                                    <td>سبب التوقف</td>
                                    <td colspan="4"></td>
                                </tr>
                                <tr>
                                    <td colspan="2">بدء النشاط</td>
                                    <td colspan="2"><span t-field="o.company_id.start_date"/></td>

                                    <td colspan="2">رقم السجل الضريبي للمنشأة</td>
                                    <td colspan="2"><span t-field="o.company_id.vat"/></td>
                                </tr>
                            </table>

                            <table class="employees-data" width="100%">
                                <thead>
                                    <tr>
                                        <th>مسلسل</th>
                                        <th>الرقم التاميني</th>
                                        <th>إسم المؤمن عليه</th>
                                        <th>الرقم القومي</th>
                                        <th>تاريخ الالتحقاق</th>
                                        <th>أجر الاشتراك التاميني التاميني</th>
                                        <th>الاجر الشامل</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="total_wage" t-value="0"/>
                                    <tr t-foreach="o.insurance_line_ids" t-as="line">
<!--                                        <t t-if="not line.employee_id.contract_id.is_full_mandate">-->
                                            <td><span t-esc="line_index + 1"/></td>
                                            <td><span t-field="line.si_number"/></td>
                                            <td><span t-field="line.employee_id.name"/></td>
                                            <td><span t-field="line.employee_id.identification_id"/></td>
                                            <td><span t-field="line.employee_id.first_hiring_date"/></td>
                                            <td><span t-field="line.subscription"/></td>
                                            <td><span t-field="line.total_insurance"/></td>
                                            <t t-set="total_wage"
                                               t-value="total_wage + line.employee_id.contract_id.wage if line.employee_id.contract_id else 0"/>
<!--                                        </t>-->
                                    </tr>
                                </tbody>
                            </table>


                        </div>

                        <footer style="text-align:right;direction:rtl;page-break-inside: avoid;" class="footer">
                            <p>
                                <span>اقر انا أ/ </span>
                                <span style="min-width:250px" t-field="o.company_id.owner.name"/>
                                <span style="padding:0 100px;" t-if="not o.company_id.owner" ><![CDATA[&nbsp;]]></span>
                                <span> بصفتي المدير المسئول بأن اجمالي اعداد المؤمن عليهم </span>
                                <span style="padding: 0 20px" t-esc="len(o.insurance_line_ids)"/>
                                <span> عاملاً. </span>
                            </p>
                            <p>
                                <span>وان اجور الشهر الحالي </span>
                                <span style="padding:0 20px" t-esc="total_wage"/>
                                <span>
                                    جنيهاً وان جميع البيانات الواردة في بهذه الاستمارة وملحقاتها
                                </span>

                                صحيحة (الاجر الشامل لحساب اشتراكات التامين الصحي الشامل)
                            </p>
                            <div class="row">
                                <div class="col-6">
                                    <p>صاحب العمل او المدير المسئول</p>
                                    <p>مستلم الاستمارة / </p>
                                </div>
                                <div class="col-6">
                                    <p> روجعت بيانات هذا الطلب علي طلبات اشتراك المؤمن عليهم ووجدت صحيحة.</p>
                                    <p>تم مطابقة التوقيع بمعرفتي / </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <p>اخصائي الاشتراك/ </p>
                                </div>
                                <div class="col-3">
                                    <p>المراجع/ </p>
                                </div>
                                <div class="col-3">
                                    <p> سجل اليا/ </p>
                                </div>
                                <div class="col-3">
                                    <p>روجع اليا/ </p>
                                </div>
                            </div>
                            <p> تحريراً في
                                <span t-field="o.insurance_date"/>
                            </p>
                        </footer>
                    </t>
                </t>


        </template>
    </data>
</odoo>
