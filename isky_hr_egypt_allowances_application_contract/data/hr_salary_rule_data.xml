<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="fixed_bonus_salary_rule" model="hr.salary.rule">
            <field name="code">Fixed Bonus</field>
            <field name="name">Fixed Bonus</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.total_bonus_amount</field>
            <field name="sequence" eval="8"/>
            <field name="type">fixed_bonus</field>
            <field name="note">Fixed Bonus</field>
            <field name="struct_id" ref="isky_hr_egypt_policy.default_structure_002"/>
        </record>

        <record id="hr_salary_rule_bonus_allowance" model="hr.salary.rule">
            <field name="code">Other Bonus</field>
            <field name="name">Other Bonus</field>
            <field name="type">bonus</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = (inputs.OB.amount) if inputs.OB else 0.0</field>
            <field name="sequence" eval="13"/>
            <field name="note">Other Bonus Allowance</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result =bool(inputs.OB)</field>
            <field name="struct_id" ref="isky_hr_egypt_policy.default_structure_002"/>
        </record>

        <record id="hr_rule_input_bonus_allowance" model="hr.payslip.input.type">
            <field name="code">OB</field>
            <field name="name">Other Bonus Allowance Input</field>
        </record>

