<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="view_real_estate_unit_tree" model="ir.ui.view">
            <field name="name">real.estate.unit.tree</field>
            <field name="model">real.estate.unit</field>
            <field name="arch" type="xml">
                <list string="Real Estate Units">
                    <field name="name"/>
                    <field name="abbreviation"/>
                    <field name="unit_number"/>
                    <field name="project_phase"/>
                    <field name="unit_purpose"/>
                    <field name="unit_status"/>
                    <field name="unit_type" readonly="unit_type == 'residential'"/>
                    <field name="number_of_rooms"/>
                    <field name="indoor_net_area"/>
                    <field name="outdoor_net_area"/>
                    <field name="roof_area"/>
                    <field name="sale_price_per_meter"/>
                    <field name="rent_price_per_meter"/>
                    <field name="maintenance_price_per_meter"/>
                    <field name="maintenance_percentage"/>
                    <field name="company_id" column_invisible="1"/>
                    <field name="contracted_selling_price" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="view_real_estate_unit_form" model="ir.ui.view">
            <field name="name">real.estate.unit.form</field>
            <field name="model">real.estate.unit</field>
            <field name="arch" type="xml">
                <form string="Real Estate Unit">
                    <header>
                        <button name="action_available_for_sale"
                                invisible="unit_status not in ['available', 'expired_reservation', 'onhold_expired_reservation']"
                                string="Available For Sale"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_unit_blocked"
                                invisible="unit_status not in ['available', 'available_for_sale']"
                                string="Block Unit"
                                type="object"
                                groups="isky_18_realestate_developer_unit_inventory.group_block_unit"
                                class="oe_highlight"/>
                        <button name="action_unit_onhold"
                                invisible="unit_status not in ['available', 'available_for_sale']"
                                string="Hold M.A"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_unit_sold"
                                invisible="unit_status not in ['blocked', 'on_hold_ma']"
                                string="Sold"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_unit_lease"
                                invisible="unit_status != 'sold'"
                                string="In Lease"
                                type="object"
                                class="oe_highlight"/>
                        <button name="merge"
                                invisible="merged_unit == False or merge_button == True"
                                string="Merge"
                                type="object"
                                class="oe_highlight"/>
                        <button name="unmerge"
                                invisible="merged_unit == False"
                                string="Unmerge"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_rollback"
                                invisible="unit_status in ['available', 'available_for_sale', 'in_merge']"
                                string="Rollback"
                                type="object"
                                class="oe_highlight"/>
                        <button name="action_get_installment_report"
                                string="Payment Plan"
                                type="object"
                                class="btn-info"/>
                        <button name="action_unit_documents" invisible="unit_type != 'residential'"
                                string="Preview Documents"
                                type="object"
                                class="btn-info"/>
                        <button name="action_unit_documents" invisible="unit_type != 'residential'"
                                string="Download Documents" context="{'with_download': True}"
                                type="object"
                                class="btn-info"/>
                        <button name="action_print_unit_report" invisible="unit_type == 'residential'"
                                string="Unit Plan"
                                type="object"
                                class="btn-info"
                                icon="fa-print"/>
                        <button name="action_print_unit_offer_plan" string="Unit Offer Plan"
                                icon="fa-file-text-o" type="object"
                                class="btn-info"/>       

                        <field name="unit_status" widget="statusbar"
                               statusbar_visible="available,available_for_sale,reserved,on_hold_ma,blocked,sold,in_lease,delivered"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <widget name="web_ribbon" title="Merged"
                                bg_color="text-bg-danger"
                                invisible="unit_status != 'in_merge'"/>

                        <group>
                            <!-- 🏷️ Identification -->
                            <group string="Unit Identification">
                                <field name="unit_type"
                                       readonly="unit_status not in ['available', 'available_for_sale'] or unit_type == 'residential'"
                                       required="1"/>
                                <field name="unit_status" invisible="1"/>
                                <field name="name" string="Unit Name"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'" required="1"/>
                                <field name="name" string="Gate Name" invisible="unit_type != 'gate'"/>
                                <field name="name" string="Slot Name"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       invisible="unit_type != 'parking'"/>
                                <field name="abbreviation" string="Unit Code"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       required="unit_type != 'gate'"/>
                                <field name="unit_number" string="Gate Number" invisible="unit_type != 'gate'"/>
                                <field name="parent_source_id"
                                       readonly="unit_status not in ['available', 'available_for_sale']" required="1"/>
                                <field name="public_area" invisible="unit_type != 'public_area'"/>
                                <field name="industrial_type" invisible="unit_type != 'industrial'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="parking_type" invisible="unit_type != 'parking'"/>
                                <field name="retail_type" invisible="unit_type != 'retail'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="office_type_id" invisible="unit_type != 'office'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="residential_type" invisible="unit_type != 'residential'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="entertainment_type" invisible="unit_type != 'entertainment'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>

                                <field name="system_code"/>
                                <field name="merge_button" invisible="1"/>
                            </group>

                            <!-- 🏠 Details -->
                            <group string="Unit Details">
                                <field name="project_phase" invisible="unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="unit_purpose"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"/>
                                <field name="unit_purpose" string="Purpose" invisible="unit_type != 'parking'"/>
                                <field name="specially_booked"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"/>
                                <field name="customer_id"
                                       invisible="specially_booked == False or unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="unit_categorization"/>
                                <field name="unit_sale_type"/>
                                <field name="ready_to_move"/>
                                <field name="delivery_date"/>
                                <field name="estimate_delivery_years"/>
                            </group>
                        </group>

                        <group>
                            <!-- 🏢 Specifications -->
                            <group string="Unit Specifications">
                                <field name="merged_unit" invisible="unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status not in ['available', 'available_for_sale'] or merge_button == True"/>
                                <field name="units" widget="many2many_tags" invisible="merged_unit == False"
                                       readonly="unit_status not in ['available', 'available_for_sale'] or merge_button == True"/>
                                <field name="is_compound"/>
                                <field name="is_floors" invisible="unit_type != 'residential'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="floors_count" invisible="not is_floors"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="is_yard" invisible="unit_type != 'residential'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="yard_area" invisible="not is_yard"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>

                                <field name="industrial_type" invisible="unit_type != 'industrial'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="parking_type" invisible="unit_type != 'parking'"/>
                                <field name="retail_type" invisible="unit_type != 'retail'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="office_type_id" invisible="unit_type != 'office'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="residential_type" invisible="unit_type != 'residential'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="apartment_type_id" invisible="residential_type != 'apartment'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       required="residential_type == 'apartment'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="villa_type_id" invisible="residential_type != 'villa'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       required="residential_type == 'villa'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="villa_row" invisible="unit_type != 'residential' or residential_type != 'villa'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="loft_type_id" invisible="residential_type != 'loft'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       required="residential_type == 'loft'"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="entertainment_type" invisible="unit_type != 'entertainment'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                <field name="medical_type_id" invisible="unit_type != 'medical'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="parking_area_config_id"
                                       invisible="unit_type == 'residential'"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="public_area" invisible="unit_type != 'public_area'"/>
                                <field name="finishing_type"/>
                                <field name="project_id" invisible="1"/>
                                <field name="analytic_account_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                            </group>

                            <!-- Installment -->
                            <group string="Installment Plan">
                                <field name="installment_template_id"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="maintenance_template_id"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <button name="action_print_payment_plan"
                                        string="Print Payment Plan"
                                        type="object"
                                        class="btn-info"/>
                                <button name="request_discount_wizard"
                                        string="Request Discount"
                                        type="object"
                                        class="btn-success"
                                        invisible="unit_status not in ['available', 'available_for_sale']"/>
                                   <field name="maintenance_start_date" />
                            </group>
                        </group>

                        <!-- Premiums -->
                        <group string="Premiums">
                            <field name="premiums_ids"/>
                            <field name="total_premium_percentage" widget="percentage"/>
                            <field name="total_premium_price"/>
                        </group>

                        <notebook>
                            <page string="Basic Info" invisible="unit_type == 'gate'">
                                <style>
                                    .reu-grid {
                                    display: grid;
                                    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
                                    gap: 1rem;
                                    width: 100%;
                                    margin-top: 0.5rem;
                                    }
                                    .reu-card {
                                    background-color: #f8f9fa;
                                    border-radius: 8px;
                                    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                                    padding: 1rem 1.25rem;
                                    transition: all 0.3s ease;
                                    }
                                    .reu-card:hover {
                                    box-shadow: 0 6px 8px rgba(0,0,0,0.15);
                                    transform: translateY(-5px);
                                    }
                                    .reu-card-header {
                                    font-weight: 600;
                                    color: #495057;
                                    border-bottom: 2px solid #dee2e6;
                                    padding-bottom: 0.5rem;
                                    margin-bottom: 1rem;
                                    text-transform: uppercase;
                                    letter-spacing: 0.5px;
                                    }
                                    /* keep the inner group tight inside the card */
                                    .reu-card .o_group {
                                    margin: 0;
                                    }
                                </style>

                                <div class="reu-grid">

                                    <!-- AREAS (Net vs Gross side by side) -->
                                    <div class="reu-card">
                                        <div class="reu-card-header">Areas — Net vs Gross</div>
                                        <group col="2">
                                            <!-- NET COLUMN -->
                                            <group string="Net" groups="!isky_18_realestate_developer_unit_inventory.group_restrict_net_area_visibility">
                                                <field name="indoor_net_area" string="BUA"
                                                       invisible="unit_type in ['parking'] or (unit_type == 'residential' and residential_type not in ('apartment', 'loft', 'villa'))"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="indoor_net_area" string="Indoor"
                                                       invisible="unit_type in ['parking'] or (unit_type == 'residential' and residential_type in ('apartment', 'loft', 'villa'))"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="outdoor_net_area" string="Outdoor"
                                                       invisible="unit_type == 'parking' or not has_outdoor or (unit_type == 'residential' and has_garden)"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="outdoor_net_area" string="Garden"
                                                       invisible="unit_type not in ['residential'] or not has_garden"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="terrace_net_area" string="Terrace"
                                                       invisible="unit_type == 'residential' and residential_type != 'apartment'"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="terrace_net_area" string="Basement"
                                                       invisible="unit_type != 'residential' or residential_type != 'villa'"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <!-- spacer to align with landed_area row on the gross side -->
                                                <field name="landed_area" invisible="1"/>
                                                <field name="net_area" string="Total"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                                       class="total-highlight"/>
                                            </group>

                                            <!-- GROSS COLUMN -->
                                            <group string="Gross">
                                                <field name="indoor_gross_area" string="BUA"
                                                       invisible="unit_type in ['parking'] or (unit_type == 'residential' and residential_type not in ('apartment', 'loft', 'villa'))"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="indoor_gross_area" string="Indoor"
                                                       invisible="unit_type in ['parking'] or (unit_type == 'residential' and residential_type in ('apartment', 'loft', 'villa'))"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="outdoor_gross_area" string="Outdoor"
                                                       invisible="unit_type == 'parking' or not has_outdoor or (unit_type == 'residential' and has_garden)"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="outdoor_gross_area" string="Garden"
                                                       invisible="unit_type not in ['residential'] or not has_garden"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="terrace_gross_area" string="Terrace"
                                                       invisible="unit_type == 'residential' and residential_type != 'apartment'"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="terrace_gross_area" string="Basement"
                                                       invisible="unit_type != 'residential' or residential_type != 'villa'"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="landed_area" string="Landed"
                                                       invisible="unit_type != 'residential' or residential_type != 'villa'"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"/>
                                                <field name="unit_area" string="Total"
                                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                                       class="total-highlight"/>
                                            </group>
                                        </group>

                                        <!-- new gross total spans full width under the comparison -->
                                        <group>
                                            <field name="new_total_gross_area"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                        </group>
                                    </div>

                                    <!-- HAS -->
                                    <div class="reu-card" invisible="not unit_type">
                                        <div class="reu-card-header">Has</div>
                                        <group>
                                            <field name="number_of_rooms" invisible="unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="has_garden" invisible="unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="has_outdoor" invisible="unit_type == 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="has_roof" invisible="unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="roof_area"
                                                   invisible="has_roof == False and unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="has_pool" invisible="unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="has_club_membership" invisible="unit_type != 'residential'"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                        </group>
                                    </div>

                                    <!-- VIEW -->
                                    <div class="reu-card" invisible="unit_type != 'residential'">
                                        <div class="reu-card-header">View</div>
                                        <group>
                                            <field name="garden_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="pool_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="city_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="sea_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="lagoon_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                            <field name="internal_view"
                                                   readonly="unit_status not in ['available', 'available_for_sale']"/>
                                        </group>
                                    </div>

                                </div>
                            </page>
                            <page string="Utilities" invisible="unit_type == 'gate' or unit_type == 'parking'">
                                <group>
                                    <field name="heating_source"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="solar_system"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="electricity_meter"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="gas_meter"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="water_meter"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="landline"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="internet"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="air_condition"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="cooling_water"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                </group>
                            </page>
                            <page invisible="unit_type != 'residential'" string="Documents">
                            </page>
                            <page string="Financials" invisible="unit_type == 'gate' or unit_type == 'parking'">
                                <group invisible="unit_purpose != 'to_lease'">
                                    <field name="indoor_price_per_month_sqm"
                                           readonly="unit_status not in ['available', 'available_for_sale']"
                                           invisible="unit_purpose != 'to_lease'"/>
                                    <field name="outdoor_price_per_month_sqm" invisible="unit_purpose != 'to_lease'"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="indoor_outdoor_price_per_month_sqm"
                                           invisible="unit_purpose != 'to_lease'"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="service_charge_per_sqm" invisible="unit_purpose != 'to_lease'"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="marketing_fees_annually_percent"
                                           invisible="unit_purpose != 'to_lease'"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <label for="payment_terms_duration"/>
                                    <div class="o_row">
                                        <field name="payment_terms_duration"
                                               readonly="unit_status not in ['available', 'available_for_sale']"
                                        />
                                        <field name="payment_terms" class="field_rule_type"
                                               readonly="unit_status not in ['available', 'available_for_sale']"
                                        />
                                    </div>
                                </group>
                                <group invisible="unit_purpose != 'to_sale'" col="12">
                                    <field name="indoor_price_sqm"
                                           readonly="unit_status not in ['available', 'available_for_sale']"
                                           invisible="unit_purpose != 'to_sale'"/>
                                    <field name="outdoor_price_sqm"
                                           invisible="unit_purpose != 'to_sale' or has_garden == False"
                                           readonly="unit_status not in ['available', 'available_for_sale']"
                                           string="Garden Price/SQM"/>
                                    <field name="outdoor_price_sqm"
                                           invisible="unit_purpose != 'to_sale' or has_outdoor == False"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="terrace_price_sqm"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="terrace_total_price"
                                           readonly="unit_status not in ['available', 'available_for_sale']"/>
                                    <field name="basic_unit"/>
                                    <field name="total_price_unit"/>
                                    <field name="contracted_selling_price" invisible="unit_status != 'sold'"/>
                                    <field name="discount_percentage" />
                                    <field name="price_after_discount" />
                                </group>
                            </page>
                            <page string="Attachments">
                                <group>
                                    <field name="unit_plan" filename="unit_plan_filename"/>
                                    <field name="unit_plan_filename" invisible="1"/>
                                    <field name="unit_plan1" filename="unit_plan1_filename"/>
                                    <field name="unit_plan1_filename" invisible="1"/>
                                    <field name="unit_plan2" filename="unit_plan2_filename"/>
                                    <field name="unit_plan2_filename" invisible="1"/>
                                    <field name="floor_plan" invisible="unit_type != 'residential'"/>
                                    <field name="floor_plan1" invisible="unit_type != 'residential'"/>
                                    <field name="floor_plan2" invisible="unit_type != 'residential'"/>
                                    <field name="payment_plan"/>
                                </group>
                            </page>
                            <page string="Electricity Meter" invisible="electricity_meter == False">
                                <field name="counter_ids"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       context="{'default_meter_type': 'electricity'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Gas Meter" invisible="gas_meter == False">
                                <field name="gas_counter_ids"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       context="{'default_meter_type': 'gas'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Water Meter" invisible="water_meter == False">
                                <field name="water_counter_ids"
                                       readonly="unit_status not in ['available', 'available_for_sale']"
                                       context="{'default_meter_type': 'water'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Price After Discount"
                                  invisible="not has_discount">
                                <group>
                                    <field name="installment_years_after_discount" readonly="1"/>
                                    <field name="down_payment_after_discount" readonly="1" widget="percentage"/>
                                    <field name="total_price_unit_after_discount" readonly="1"/>
                                </group>
                            </page>
                            <page string="Landline" invisible="landline == False">
                                <field name="landline_counter_ids"
                                       readonly="unit_status not in ['available', 'available_for_sale']">
                                    <list editable="bottom">
                                        <field name="service_provider"/>
                                        <field name="activation_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Internet" invisible="internet == False">
                                <field name="internet_counter_ids"
                                       readonly="unit_status not in ['available', 'available_for_sale']">
                                    <list editable="bottom">
                                        <field name="service_provider"/>
                                        <field name="type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Warnings">
                                <field name="warning_msg" placeholder="Warning Message..."/>
                            </page>
                            <page string="Blocking Reason" invisible="unit_status != 'blocked'">
                                <field name="reason_id"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_real_estate_unit_search" model="ir.ui.view">
            <field name="name">real.estate.unit.search</field>
            <field name="model">real.estate.unit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="abbreviation"/>
                    <field name="system_code"/>
                    <field name="building_code"/>
                    <field name="building_system_code"/>

                    <filter string="Available Units" name="available_units"
                            domain="[('unit_status', '=', 'available')]"/>
                    <filter string="Available for Sale" name="available_for_sale"
                            domain="[('unit_status', '=', 'available_for_sale')]"/>
                    <filter string="Blocked Units" name="blocked_units" domain="[('unit_status', '=', 'blocked')]"/>
                    <filter string="Blocked for On Hold" name="blocked_draft"
                            domain="[('reason_id.for_draft_reservation', '=', True)]"/>
                    <filter string="Blocked for Initial Reservation" name="blocked_initial"
                            domain="[('reason_id.for_initial_reservation', '=', True)]"/>
                    <filter string="On Hold M.A Units" name="blocked_initial"
                            domain="[('unit_status', '=', 'on_hold_ma')]"/>
                </search>
            </field>
        </record>
