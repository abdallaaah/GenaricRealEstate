<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
        <record id="view_sale_request_tree" model="ir.ui.view">
            <field name="name">sale.request.tree</field>
            <field name="model">sale.request</field>
            <field name="arch" type="xml">
                <list string="Sale Requests">
                    <field name="name"/>
                    <field name="unit_id"/>
                    <field name="requester_id"/>
                    <field name="total_price_unit" sum="Total"/>
                    <field name="reason_id"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'accepted'"
                           decoration-danger="state == 'rejected'"
                           decoration-info="state == 'submitted'"
                           decoration-muted="state in ('draft', 'cancelled')"/>
                </list>
            </field>
        </record>
        <record id="view_sale_request_form" model="ir.ui.view">
            <field name="name">sale.request.form</field>
            <field name="model">sale.request</field>
            <field name="arch" type="xml">
                <form string="Sale Request">
                    <header>
                        <button name="action_submit" string="Submit" type="object"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="state != 'draft'"/>
                        <button name="action_accept" string="Accept" type="object"
                                class="oe_highlight" invisible="state != 'submitted'"
                                groups="isky_18_realestate_developer_unit_inventory.group_block_unit"/>
                        <button name="action_reject" string="Reject" type="object"
                                invisible="state != 'submitted'"
                                groups="isky_18_realestate_developer_unit_inventory.group_block_unit"/>
                        <button name="action_print_unit_offer_plan" string="Print Unit Offer Plan"
                                type="object" invisible="not unit_id"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,accepted"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Unit Information">
                                <field name="unit_id" readonly="state != 'draft'"
                                       options="{'no_create': True}"/>
                                <field name="unit_area"/>
                                <field name="total_price_unit"/>
                            </group>
                            <group string="Request Information">
                                <field name="requester_id"/>
                                <field name="reason_id" readonly="state != 'draft'"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Rejection" invisible="state != 'rejected'">
                            <field name="rejection_reason" nolabel="1"
                                   readonly="state != 'submitted'"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="view_sale_request_search" model="ir.ui.view">
            <field name="name">sale.request.search</field>
            <field name="model">sale.request</field>
            <field name="arch" type="xml">
                <search string="Sale Requests">
                    <field name="name"/>
                    <field name="unit_id"/>
                    <field name="requester_id"/>
                    <filter string="My Requests" name="my_requests" domain="[('requester_id','=',uid)]"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Accepted" name="accepted" domain="[('state','=','accepted')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                    <group>
                        <filter string="Requester" name="group_requester" context="{'group_by':'requester_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_sale_request" model="ir.actions.act_window">
            <field name="name">Request Sale</field>
            <field name="res_model">sale.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first sale request!
                </p>
            </field>
        </record>
</odoo>
