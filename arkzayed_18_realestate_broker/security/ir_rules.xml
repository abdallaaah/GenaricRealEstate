<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <function model="ir.rule" name="write">
            <value eval="[ref('website_crm_partner_assign.assigned_lead_portal_rule_1')]"/>
            <value eval="{
                'domain_force':
                    '''['|', '|', '|',
                        ('user_id', '=', user.id),
                        ('team_id.user_id', '=', user.id),
                        ('sales_ids', 'in', [user.id]),
                        ('sales_ids.sale_team_id.user_id', '=', user.id)
                    ]'''
            }"/>
        </function>

        <function model="ir.rule" name="write">
            <value eval="[ref('crm.crm_rule_all_lead')]"/>
            <value eval="{
                'domain_force':
                    '''['|', '|', '|',
                        ('user_id', '=', user.id),
                        ('team_id.user_id', '=', user.id),
                        ('sales_ids', 'in', [user.id]),
                        ('sales_ids.sale_team_id.user_id', '=', user.id)
                    ]'''
            }"/>
        </function>
        <!--        <record id="crm_rule_all_portals" model="ir.rule">-->
        <!--            <field name="name">Sales Portal</field>-->
        <!--            <field name="model_id" ref="crm.model_crm_lead"/>-->
        <!--            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>-->
        <!--            <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>-->
        <!--        </record>-->

        <record id="crm.crm_rule_all_lead" model="ir.rule">
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id),
                ('sales_ids', 'in', [user.id])]
            </field>
        </record>

        <!-- Record rule for Sales Manager -->
        <record id="crm_lead_rule_sales_manager" model="ir.rule">
            <field name="name">Sales Manager: See all leads in their department</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', '|','|',('user_id', '=', user.id),
                ('team_id.sales_manager_id', '=', user.id),
                ('sales_ids', 'in', user.crm_team_member_ids.ids),
                ('commission_ids.employee_id', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_manager_group'))]"/>
        </record>

        <!-- Record rule for Director -->
        <record id="crm_lead_rule_director" model="ir.rule">
            <field name="name">Director: See all leads in their department</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', ('user_id', '=', user.id),
                ('team_id.director_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('director_manager_group'))]"/>
        </record>

<!--        Record rule for Operations-->
        <record id="crm_lead_rule_operations" model="ir.rule">
            <field name="name">Sales Sector Manager: See all leads in in their department</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">['|', ('user_id', '=', user.id),
                ('team_id.operation_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('operation_manager_group'))]"/>
        </record>

        <!--     team -->
        <function model="ir.rule" name="write">
            <value eval="[ref('sales_team.crm_rule_all_salesteam')]"/>
            <value eval="{'domain_force': '[(\'user_id\', \'=\', user.id)]'}"/>
        </function>



        <record id="crm_team_rule_sales_manager" model="ir.rule">
            <field name="name">Sales Manager: See all teams in their department</field>
            <field name="model_id" ref="crm.model_crm_team"/>
            <field name="domain_force">[('sales_manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_manager_group'))]"/>
        </record>

        <record id="crm_team_rule_director" model="ir.rule">
            <field name="name">Director: See all teams</field>
            <field name="model_id" ref="crm.model_crm_team"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- Always true, no restriction -->
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.director_manager_group'))]"/>
        </record>

        <!--    eoi record rule    -->
        <record id="rule_eoi_admin_visibility" model="ir.rule">
            <field name="name">EOI Visibility: Admin All Access</field>
            <field name="model_id" ref="arkzayed_18_realestate_development.model_eoi_eoi"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_administrator_group'))]"/>
        </record>

        <record id="rule_eoi_hierarchy_visibility" model="ir.rule">
            <field name="name">EOI Visibility: Assigned and Hierarchy (via Commission)</field>
            <field name="model_id" ref="arkzayed_18_realestate_development.model_eoi_eoi"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('commission_ids.employee_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),
            (4, ref('arkzayed_18_realestate_broker.sales_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.director_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.operation_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.sales_administrator_group')),
            ]"/>
        </record>

        <!--   SALE RESERVATION record rule    -->
        <record id="rule_reservation_admin_visibility" model="ir.rule">
            <field name="name">Sale Reservation Visibility: Admin All Access</field>
            <field name="model_id" ref="arkzayed_18_realestate_development.model_real_estate_sale_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_administrator_group'))]"/>
        </record>

        <record id="rule_reservation_hierarchy_visibility" model="ir.rule">
            <field name="name">Sale Reservation Visibility: Assigned and Hierarchy (via Commission)</field>
            <field name="model_id" ref="arkzayed_18_realestate_development.model_real_estate_sale_reservation"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('commission_ids.employee_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')),
            (4, ref('arkzayed_18_realestate_broker.sales_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.director_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.operation_manager_group')),
            (4, ref('arkzayed_18_realestate_broker.sales_administrator_group')),
            ]"/>
        </record>

        <!--    sale proposal record rule    -->
        <record id="rule_sale_proposal_admin_visibility" model="ir.rule">
            <field name="name">Sale Proposal Visibility: Admin All Access</field>
            <field name="model_id" ref="model_sale_proposal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_administrator_group'))]"/>
        </record>

        <record id="rule_sale_proposal_hierarchy_visibility" model="ir.rule">
            <field name="name">Sale Proposal Visibility: Assigned and Hierarchy (via Commission)</field>
            <field name="model_id" ref="model_sale_proposal"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('commission_ids.employee_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('arkzayed_18_realestate_broker.sales_administrator_group'))]"/>
        </record>



