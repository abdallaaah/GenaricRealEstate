<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_partner_property_form_inherit_broker" model="ir.ui.view">
        <field name="name">view.partner.property.form.inherit.broker</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']//group//group[@name='accounting_entries']" position="inside">
                <field name="property_account_down_payment_receivable_id"/>
                <field name="property_account_down_payment_payable_id"/>
                <field name="property_notes_receivable_account_id"/>
            </xpath>
        </field>
    </record>
</odoo>