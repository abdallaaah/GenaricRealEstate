<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_unqualified_wizard_form" model="ir.ui.view">
            <field name="name">crm.lead.unqualified.wizard.form</field>
            <field name="model">crm.lead.unqualified.wizard</field>
            <field name="arch" type="xml">
                <form string="Unqualify Lead">
                    <group>
                        <field name="lost_reason_id" placeholder="Provide reason for unqualifying this lead" required="1"/>
                        <field name="lead_id" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
