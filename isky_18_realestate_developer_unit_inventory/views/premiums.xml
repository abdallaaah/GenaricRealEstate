<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="premiums_view_tree" model="ir.ui.view">
            <field name="name">premiums_view_tree</field>
            <field name="model">premiums.premiums</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="unit_type" readonly="unit_type == 'residential'"/>
                    <field name="percentage"/>
                </list>
            </field>
        </record>
        <record id="premiums_view_form" model="ir.ui.view">
            <field name="name">premiums_view_form</field>
            <field name="model">premiums.premiums</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="unit_type" readonly="unit_type == 'residential'"/>
                            </group>
                            <group>
                                <field name="percentage" widget="percentage"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="premiums_view_action" model="ir.actions.act_window">
            <field name="name">Premiums</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">premiums.premiums</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
