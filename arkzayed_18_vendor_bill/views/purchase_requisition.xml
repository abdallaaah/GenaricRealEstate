<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Requisition Form View -->
    <record id="view_purchase_requisition_form_inherit" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">

            <!-- Add button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_create_down_payment"
                        string="Create Down Payment"
                        type="object"
                        class="btn-info"/>
            </xpath>

            <!-- Add smart buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_payments"
                        icon="fa-money"
                        invisible="payment_count == 0">
                    <field name="payment_count" widget="statinfo" string="Payments"/>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_cheques"
                        icon="fa-file-text-o"
                        invisible="cheque_count == 0">
                    <field name="cheque_count" widget="statinfo" string="Cheques"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='reference']" position="after">
                <field name="total_agreement" widget="monetary"/>
                <field name="down_payment_agreement" widget="monetary"/>
            </xpath>
            <xpath expr="//field[@name='down_payment_agreement']" position="after">
                <field name="progress_cutoff_date"/>
                <field name="submission_date"/>
            </xpath>

            <!-- Add insurance fields in lines -->
            <xpath expr="//field[@name='line_ids']//field[@name='product_id']" position="after">
                <field name="is_insurance_product"/>
                <field name="insurance_percentage"/>
            </xpath>

        </field>
    </record>
</odoo>
