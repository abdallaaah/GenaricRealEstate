<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="custody_journal_entries_tree_view" model="ir.ui.view">
            <field name="name">custody.journal.entries.view</field>
            <field name="model">custody.journal.entries</field>
            <field name="arch" type="xml">
                <list string="Employee Journal Entries" create="false">
                    <field name="employee_id"/>
                    <field name="type"/>
                    <field name="debit"/>
                    <field name="credit"/>
                    <field name="balance"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_custody_journal_entries">
            <field name="name">Employee Journal Entries</field>
            <field name="res_model">custody.journal.entries</field>
            <field name="view_mode">list</field>
            <field name="context">{'group_by': 'employee_id'}</field>
            <field name="view_id" ref="custody_journal_entries_tree_view"/>
        </record>
    </data>
</odoo>