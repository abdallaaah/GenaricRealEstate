<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="broker_approval_rule_view_list" model="ir.ui.view">
        <field name="name">broker.approval.rule.view.list</field>
        <field name="model">broker.approval.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="phase"/>
                <field name="role"/>
                <field name="group_id"/>
            </list>
        </field>
    </record>

    <record id="broker_approval_rule_action" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">broker.approval.rule</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
