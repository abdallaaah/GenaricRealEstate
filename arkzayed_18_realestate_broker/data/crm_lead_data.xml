<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data noupdate="1">
        <record id="crm_lead_seq" model="ir.sequence">
            <field name="name">Crm Lead</field>
            <field name="code">crm.lead</field>
            <field name="padding">6</field>
            <field name="prefix">L</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
        <record id="crm_opportunity_seq" model="ir.sequence">
            <field name="name">Crm Opportunity</field>
            <field name="code">crm.opportunity</field>
            <field name="padding">6</field>
            <field name="prefix">T</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
    </data>
</odoo>