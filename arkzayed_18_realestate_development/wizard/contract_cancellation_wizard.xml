<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="contract_cancellation_wizard_view_form" model="ir.ui.view">
            <field name="name">contract_cancellation_wizard_view_form</field>
            <field name="model">contract.cancellation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="cancellation_reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button
                                name="action_confirm_cancellation"
                                string="Confirm"
                                type="object"
                                class="oe_highlight"
                        />
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
