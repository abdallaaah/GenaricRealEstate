<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="crm_lead_reassign_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.reassign.wizard.form</field>
        <field name="model">crm.lead.reassign</field>
        <field name="arch" type="xml">
            <form string="Reassign Lead">
                <group>
                    <field name="user_id"/>
                </group>
                <footer>
                    <button name="reassign_leads" string="Reassign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_crm_lead_reassign">
        <field name="name">Reassign</field>
        <field name="res_model">crm.lead.reassign</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="crm_lead_reassign_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>