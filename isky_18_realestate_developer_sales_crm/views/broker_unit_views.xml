<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_developer_crm, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
        <record id="view_real_estate_unit_list" model="ir.ui.view">
            <field name="name">real.estate.unit.list</field>
            <field name="model">broker.unit</field>
            <field name="arch" type="xml">
                <list string="Broker Units">
                    <field name="name"/>
                    <!--                    <field name="abbreviation"/>-->
                    <field name="unit_number"/>
                    <field name="unit_code"/>
                    <field name="sale_phase"/>
                    <field name="unit_purpose"/>
                    <field name="unit_status"/>
                    <field name="unit_type" readonly="unit_type == 'residential'"/>
                    <field name="sale_price_per_meter"/>
                    <field name="rent_price_per_meter"/>
                    <field name="maintenance_price_per_meter"/>
                    <field name="maintenance_percentage"/>
                </list>
            </field>
        </record>
        <record id="view_real_estate_unit_form" model="ir.ui.view">
            <field name="name">real.estate.unit.form</field>
            <field name="model">broker.unit</field>
            <field name="arch" type="xml">
                <form string="Broker Unit">
                    <header>
                        <button name="website_publish_button" type="object" string="Publish on Website"
                                class="oe_highlight"
                                invisible="is_published == True"/>
                        <button name="website_publish_button" type="object" string="Unpublish on Website"
                                invisible="is_published == False"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Available" bg_color="text-bg-success"
                                invisible="unit_status != 'available'"/>
                        <widget name="web_ribbon" title="Sold" bg_color="text-bg-danger"
                                invisible="unit_status != 'sold'"/>
                        <widget name="web_ribbon" title="Rented" bg_color="text-bg-danger"
                                invisible="unit_status != 'rented'"/>
                        <field name="unit_image" widget="image" class="oe_avatar ml-3 mr-3"
                               options="{'size': [0, 180]}"/>
                        <group>
                            <group>
                                <field name="name" string="Slot name"
                                       invisible="unit_type != 'parking'" readonly="1"/>
                                <field name="name" string="Gate name" invisible="unit_type != 'gate'" readonly="1"/>
                                <field name="name" string="Unit ID" readonly="1"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"/>
                                <!--                                <field name="abbreviation"/>-->
                                <field name="unit_number" string="Unit Number"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status != 'available'"/>
                                <field name="unit_number" string="Slot Number" invisible="unit_type != 'parking'"/>
                                <field name="unit_number" string="Gate Number" invisible="unit_type != 'gate'"/>
                                <field name="unit_type" readonly="unit_status != 'available' or unit_type == 'residential'" required="1"/>
                                <field name="public_area" invisible="unit_type != 'public_area'"/>
                                <field name="industrial_type" invisible="unit_type != 'industrial'"
                                       readonly="unit_status != 'available'"/>
                                <field name="parking_type" invisible="unit_type != 'parking'"/>
                                <field name="retail_type" invisible="unit_type != 'retail'"
                                       readonly="unit_status != 'available'"/>
                                <field name="office_type" invisible="unit_type != 'office'"
                                       readonly="unit_status != 'available'"/>
                                <field name="residential_type" invisible="unit_type != 'residential'"
                                       readonly="unit_status != 'available'"/>
                                <field name="is_floors" invisible="unit_type != 'residential'"
                                       readonly="unit_status != 'available'"/>
                                <field name="floors_count" invisible="not is_floors"
                                       readonly="unit_status != 'available'"/>
                                <field name="entertainment_type" invisible="unit_type != 'entertainment'"
                                       readonly="unit_status != 'available'"/>
                                <field name="project_id"/>
                                <field name="developer_id"/>
                                <field name="country_id"/>
                                <field name="governorate_id"/>
                                <field name="city_id"/>
                                <field name="neighborhood_id"/>
                                <field name="sale_price"
                                       invisible="unit_purpose != 'to_sale' and unit_purpose != 'sale_or_rent'"/>
                                <field name="rent_price"
                                       invisible="unit_purpose != 'to_rent' and unit_purpose != 'sale_or_rent'"/>
                                <field name="currency_id"/>
                                <field name="seller_sales_person"/>
                                <field name="seller_sales_person_phone"/>
                            </group>
                            <group>
                                <field name="unit_status"/>
                                <field name="sale_phase" invisible="unit_type == 'gate' or unit_type == 'parking'"
                                       readonly="unit_status != 'available'"
                                       options="{'no_open': True, 'no_create': True}"/>
                                <field name="unit_purpose" readonly="unit_status != 'available'"
                                       invisible="unit_type == 'gate' or unit_type == 'parking'"/>
                                <field name="unit_purpose" string="Purpose" invisible="unit_type != 'parking'"/>
                                <!--                                <field name="customer_id"-->
                                <!--                                       invisible="unit_type == 'gate' or unit_type == 'parking'"-->
                                <!--                                       readonly="unit_status != 'available'"/>-->
                                <field name="built_up_area" invisible="unit_type != 'residential'"
                                       readonly="unit_status != 'available'" required="unit_type != 'residential'"/>
                                <field name="is_yard" invisible="unit_type != 'residential'"
                                       readonly="unit_status != 'available'"/>
                                <field name="yard_area" invisible="not is_yard" readonly="unit_status != 'available'"/>
                                <field name="unit_plan"/>
                                <field name="unit_sale_type" readonly="1"/>
                                <field name="furniture_type" invisible="unit_sale_type != 'resale'"/>
                                <field name="is_compound"/>
                                <field name="finishing_type"/>
                                <field name="number_of_rooms"/>
                                <field name="number_of_bathrooms"/>
                                <field name="ready_to_move"/>
                                <field name="is_published" readonly="True"/>
                                <field name="is_client_tap_viewer" invisible="1"/>
                                <field name="is_seller_details_tap_viewer" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Basic Info" invisible="unit_type == 'gate'">
                                <group>
                                    <group string="Info">
                                        <field name="storge_capacity" invisible="unit_type != 'storage'"
                                               readonly="unit_status != 'available'"/>
                                        <field name="indoor_gross_area" invisible="unit_type in ['parking']"
                                               readonly="unit_status != 'available'"/>
                                        <field name="indoor_net_area" invisible="unit_type in ['parking']"
                                               readonly="unit_status != 'available'"/>
                                        <field name="outdoor_gross_area" invisible="unit_type in ['parking']"
                                               readonly="unit_status != 'available'"/>
                                        <field name="outdoor_net_area" invisible="unit_type in ['parking']"
                                               readonly="unit_status != 'available'"/>
                                        <field name="net_area" invisible="unit_type in ['parking']"
                                               readonly="unit_status != 'available'"/>
                                        <field name="unit_area" readonly="unit_status != 'available'"/>

                                    </group>
                                    <group string="Has" invisible="unit_type != 'residential'">
                                        <field name="has_garden" readonly="unit_status != 'available'"/>
                                        <field name="garden_area" invisible="has_garden == False"
                                               readonly="unit_status != 'available'"/>
                                        <field name="has_roof" readonly="unit_status != 'available'"/>
                                        <field name="roof_area" invisible="has_roof == False"
                                               readonly="unit_status != 'available'"/>
                                        <field name="has_parking" readonly="unit_status != 'available'"/>
                                        <field name="number_of_slots" invisible="has_parking == False"
                                               readonly="unit_status != 'available'"/>
                                        <field name="has_balcony" readonly="unit_status != 'available'"/>
                                        <field name="number_of_balcony" invisible="has_balcony == False"
                                               readonly="unit_status != 'available'"/>
                                        <field name="has_pool" readonly="unit_status != 'available'"/>
                                        <field name="pool_area" invisible="has_pool == False"
                                               readonly="unit_status != 'available'"/>
                                        <field name="has_club_membership" readonly="unit_status != 'available'"/>
                                    </group>
                                </group>
                                <group string="View" invisible="unit_type != 'residential'">
                                    <field name="garden_view" readonly="unit_status != 'available'"/>
                                    <field name="pool_view" readonly="unit_status != 'available'"/>
                                    <field name="city_view" readonly="unit_status != 'available'"/>
                                    <field name="sea_view" readonly="unit_status != 'available'"/>
                                    <field name="lagoon_view" readonly="unit_status != 'available'"/>
                                    <field name="internal_view" readonly="unit_status != 'available'"/>
                                </group>
                            </page>
                            <page string="Unit Price">
                                <group>
                                    <group>
                                        <field name="sale_price" string="Unit Price"
                                               invisible="unit_purpose not in ['to_sale', 'sale_or_rent']"/>
                                        <field name="sale_maintenance_price"
                                               invisible="unit_purpose not in ['to_sale', 'sale_or_rent']"/>
                                        <label for="down_payment_percentage"
                                               invisible="unit_purpose not in ['to_sale', 'sale_or_rent']"/>
                                        <div class="o_row" invisible="unit_purpose not in ['to_sale', 'sale_or_rent']">
                                            <field name="down_payment_percentage"
                                                   invisible="unit_purpose not in ['to_sale', 'sale_or_rent']"/>
                                            <span>%</span>
                                        </div>

                                        <field name="rent_price"
                                               invisible="unit_purpose not in ['to_rent', 'sale_or_rent']"/>
                                        <field name="rent_maintenance_price"
                                               invisible="unit_purpose not in ['to_rent', 'sale_or_rent']"/>
                                        <field name="rent_period"
                                               invisible="unit_purpose not in ['to_rent', 'sale_or_rent']"/>
                                        <field name="maintenance_period"
                                               invisible="unit_purpose not in ['to_rent', 'sale_or_rent']"/>
                                    </group>
                                    <group>

                                    </group>
                                </group>
                            </page>
                            <page string="Utilities" invisible="unit_type == 'gate' or unit_type == 'parking'">
                                <group>
                                    <field name="heating_source" readonly="unit_status != 'available'"/>
                                    <field name="solar_system" readonly="unit_status != 'available'"/>
                                    <field name="electricity_meter" readonly="unit_status != 'available'"/>
                                    <field name="gas_meter" readonly="unit_status != 'available'"/>
                                    <field name="water_meter" readonly="unit_status != 'available'"/>
                                    <field name="landline" readonly="unit_status != 'available'"/>
                                    <field name="internet" readonly="unit_status != 'available'"/>
                                    <field name="air_condition" readonly="unit_status != 'available'"/>
                                    <field name="cooling_water" readonly="unit_status != 'available'"/>
                                </group>
                            </page>
                            <page invisible="unit_type != 'residential'" string="Documents">
                                <group>
                                    <field name="unit_document_ids" nolabel="1" widget="many2many_tags"/>
                                </group>
                            </page>
                            <page string="Electricity Meter" invisible="electricity_meter == False">
                                <field name="counter_ids" readonly="unit_status != 'available'"
                                       context="{'default_meter_type': 'electricity'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Gas Meter" invisible="gas_meter == False">
                                <field name="gas_counter_ids" readonly="unit_status != 'available'"
                                       context="{'default_meter_type': 'gas'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Water Meter" invisible="water_meter == False">
                                <field name="water_counter_ids" readonly="unit_status != 'available'"
                                       context="{'default_meter_type': 'water'}">
                                    <list editable="bottom">
                                        <field name="serial_no"/>
                                        <field name="Type"/>
                                        <field name="meter_type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Landline" invisible="landline == False">
                                <field name="landline_counter_ids" readonly="unit_status != 'available'">
                                    <list editable="bottom">
                                        <field name="service_provider"/>
                                        <field name="activation_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Internet" invisible="internet == False">
                                <field name="internet_counter_ids" readonly="unit_status != 'available'">
                                    <list editable="bottom">
                                        <field name="service_provider"/>
                                        <field name="type"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Gallery">
                                <field name="unit_attachment_image_ids" widget="many2many_binary"
                                       options="{'accepted_file_extensions': 'image/*'}" string="Add Images"/>
                            </page>
                            <page string="Buyer/Tenant Details" invisible="unit_type == 'gate' or unit_type == 'parking' or is_client_tap_viewer != True"
                                  readonly="unit_status != 'available'">
                                <group>
                                    <group>
                                        <field name="customer_id"/>
                                        <field name="tcr" string="TCR"/>
                                    </group>
                                    <group>
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                    </group>
                                </group>
                            </page>
                            <page name="seller_details" string="Seller Details" invisible="unit_sale_type == 'primary' or is_seller_details_tap_viewer != True">
                                <group>
                                    <group>
                                        <field name="is_seller_details_tap_viewer" invisible="1"/>
                                        <field name="seller_team_leader"/>
                                        <field name="seller_sales_manager"/>
                                        <field name="seller_sales_director"/>
                                    </group>
                                    <group>
                                        <field name="seller_purpose_sale_price"/>
                                        <field name="seller_purpose_rent_price"/>
<!--                                        <field name="seller_client_name"/>-->
                                        <field name="seller_client_id"/>
                                        <field name="seller_client_phone"/>
                                        <field name="seller_client_extra_phone"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>

                </form>
            </field>
        </record>
        <record id="action_real_estate_unit" model="ir.actions.act_window">
            <field name="name">Broker Unit</field>
            <field name="res_model">broker.unit</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_broker_primary_unit" model="ir.actions.act_window">
            <field name="name">Primary Units</field>
            <field name="res_model">broker.unit</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('unit_sale_type', '=', 'primary')]</field>
            <field name="context">{'default_unit_sale_type': 'primary'}</field>

        </record>
        <record id="action_broker_resale_unit" model="ir.actions.act_window">
            <field name="name">Resale Units</field>
            <field name="res_model">broker.unit</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('unit_sale_type', '=', 'resale')]</field>
            <field name="context">{'default_unit_sale_type': 'resale'}</field>
        </record>
</odoo>
