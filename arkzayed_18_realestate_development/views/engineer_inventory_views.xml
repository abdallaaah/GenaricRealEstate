<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ark_engineer_inventory_search" model="ir.ui.view">
        <field name="name">ark.engineer.inventory.search</field>
        <field name="model">ark.engineer.inventory</field>
        <field name="arch" type="xml">
            <search string="Units">
                <field name="unit_code"/>
                <field name="building_name"/>
                <field name="floor_name"/>
                <field name="client_name"/>
                <field name="client_arabic_name"/>
                <field name="contract_ref"/>
                <field name="reservation_serial"/>
                <field name="sales"/>
                <field name="mobile"/>
                <filter name="sold" string="Sold" domain="[('unit_status', '=', 'sold')]"/>
                <filter name="reserved" string="Reserved" domain="[('unit_status', '=', 'reserved')]"/>
                <filter name="available" string="Available" domain="[('unit_status', 'in', ['available', 'available_for_sale'])]"/>
                <filter name="blocked" string="Blocked" domain="[('unit_status', 'in', ['blocked', 'on_hold_ma'])]"/>
                <separator/>
                <filter name="has_contract" string="Has contract" domain="[('contract_ref', '!=', False)]"/>
                <filter name="no_contract" string="No contract" domain="[('contract_ref', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_project" string="Boulevard" context="{'group_by': 'project_id'}"/>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="group_floor" string="Floor" context="{'group_by': 'floor_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'unit_status'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'unit_type'}"/>
                    <filter name="group_subtype" string="Unit Type" context="{'group_by': 'unit_subtype'}"/>
                </group>
            </search>
        </field>
    </record>

