<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_level_view_list" model="ir.ui.view">
        <field name="name">job.level.view.list</field>
        <field name="model">job.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_sales_person"/>
                <field name="is_team_leader"/>
                <field name="is_sales_manager"/>
                <field name="is_directory"/>
                <field name="is_operations"/>
            </list>
        </field>
    </record>

    <record id="job_level_view_form" model="ir.ui.view">
        <field name="name">job.level.view.form</field>
        <field name="model">job.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_sales_person"/>
                        <field name="is_team_leader"/>
                        <field name="is_sales_manager"/>
                        <field name="is_directory"/>
                        <field name="is_operations"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="job_level_action" model="ir.actions.act_window">
        <field name="name">Job Levels</field>
        <field name="res_model">job.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
