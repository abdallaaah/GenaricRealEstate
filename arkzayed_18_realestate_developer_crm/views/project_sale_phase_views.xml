<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_sale_phase_list" model="ir.ui.view">
            <field name="name">project.sale.phase.list</field>
            <field name="model">project.sale.phase</field>
            <field name="arch" type="xml">
                <list string="Project Sale Phases">
                    <field name="project_id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="view_project_sale_phase_form" model="ir.ui.view">
            <field name="name">project.sale.phase.form</field>
            <field name="model">project.sale.phase</field>
            <field name="arch" type="xml">
                <form string="Project Sale Phase">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="name"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_project_sale_phase" model="ir.actions.act_window">
            <field name="name">Project Sale Phase</field>
            <field name="res_model">project.sale.phase</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
