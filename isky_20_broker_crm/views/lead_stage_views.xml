<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lead_stage_view_list" model="ir.ui.view">
        <field name="name">lead.stage.view.list</field>
        <field name="model">lead.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="first"/>
                <field name="no_answer"/>
                <field name="call_later"/>
                <field name="follow_up"/>
                <field name="qualified_limited_budget"/>
                <field name="qualified"/>
                <field name="unqualified"/>
                <field name="locked"/>
            </list>
        </field>
    </record>

    <record id="lead_stage_action" model="ir.actions.act_window">
        <field name="name">Lead Pre-Qualification Stages</field>
        <field name="res_model">lead.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
