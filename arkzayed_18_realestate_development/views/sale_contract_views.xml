<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sale_contract" model="ir.actions.act_window">
        <field name="name">All Contracts Except Terminated &amp; Cancelled</field>
        <field name="res_model">sale.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_proposal_tree"/>
        <field name="domain">[('state', 'not in', ['terminated', 'cancelled'])]</field>
    </record>

    <record id="action_sale_contract_terminated" model="ir.actions.act_window">
        <field name="name">Terminated Contracts</field>
        <field name="res_model">sale.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_proposal_tree"/>
        <field name="domain">[('state', '=', 'terminated')]</field>
    </record>

    <record id="action_sale_contract_cancelled" model="ir.actions.act_window">
        <field name="name">Cancelled Contracts</field>
        <field name="res_model">sale.proposal</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_proposal_tree"/>
        <field name="domain">[('state', '=', 'cancelled')]</field>
    </record>
</odoo>
