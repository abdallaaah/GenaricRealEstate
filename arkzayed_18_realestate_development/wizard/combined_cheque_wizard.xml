<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_combined_cheque_wizard_form" model="ir.ui.view">
        <field name="name">combined.cheque.wizard.form</field>
        <field name="model">combined.cheque.wizard</field>
        <field name="arch" type="xml">
            <form string="Combined Cheque">
                <group>
                    <group>
                        <field name="sale_proposal_id"/>
                        <field name="customer_id"/>
                        <field name="contract_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="unit_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="bank_id"/>
                        <field name="cheque_no"/>
                        <field name="cheque_date"/>
                        <field name="journal_id"/>
                        <field name="replace_draft_cheques"/>
                        <field name="company_currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="line_type" column_invisible="1"/>
                        <field name="installment_id" column_invisible="1"/>
                        <field name="maintenance_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="cover"/>
                        <field name="sale_proposal_id" readonly="1" force_save="1"/>
                        <field name="unit_id" readonly="1" force_save="1"/>
                        <field name="name" readonly="1" force_save="1"/>
                        <field name="due_date" readonly="1" force_save="1"/>
                        <field name="amount_to_cover" readonly="1" force_save="1"/>
                        <field name="amount" readonly="not cover"/>
                        <field name="existing_draft_cheque_id" readonly="1" force_save="1"
                               optional="show"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="selected_count"/>
                    <field name="total_amount" widget="monetary"
                           options="{'currency_field': 'company_currency_id'}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Create Combined Cheque"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
