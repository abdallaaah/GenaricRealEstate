<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- #49: the four pipeline stages this module resolves by xmlid. `crm.stage` itself is core;
         the is_collected / is_confirmed_contract flags set below are declared by this module
         (models/core/crm_stage.py).

         Deliberately NOT included: the legacy file also renames core crm.stage_lead1/2/3 to
         EOI / Reservation / Contract. No code here resolves those three, and renaming Odoo's own
         pipeline stages is client configuration, not L2 seed data (decisions log, 2026-11-07).

         Replicated exactly as the legacy rows, which means "Cancel" does not carry is_cancel -
         so the lead-to-opportunity wizard's domain=[('is_cancel','=',False)] still excludes
         nothing. That is backlog #58, not a change #49 makes. -->
    <data noupdate="1">
        <record id="stage_lead5" model="crm.stage">
            <field name="name">Reopen</field>
            <field name="sequence">4</field>
        </record>
        <record id="stage_lead6" model="crm.stage">
            <field name="name">Cancel</field>
            <field name="sequence">5</field>
        </record>
        <record id="stage_lead7" model="crm.stage">
            <field name="name">Collected</field>
            <field name="is_collected">True</field>
            <field name="sequence">100</field>
        </record>
        <record id="stage_lead8" model="crm.stage">
            <field name="name">Confirmed Contract</field>
            <field name="is_confirmed_contract">True</field>
            <field name="sequence">100</field>
        </record>
    </data>
</odoo>
