<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_permission_requests" name="My Permission Requests">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Permission Requests</t>
            </t>
            <t t-if="not permission_requests">
                <div class="alert alert-warning" role="alert">There are no permission requests yet.</div>
            </t>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Type</th>
                            <th>Client</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="permission_requests" t-as="permission_request">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/permission-request/#{permission_request.id}">
                                        <t t-out="permission_request.name"/>
                                    </a>
                                </td>
                                <td><t t-out="permission_request.request_type"/></td>
                                <td><t t-out="permission_request.client_name"/></td>
                                <td><t t-out="permission_request.approval_status"/></td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
            <a href="/my/permission-request/create" class="btn btn-primary mt-3">New Permission Request</a>
        </t>
    </template>

    <template id="portal_my_permission_request" name="Permission Request">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="base.group_user"/>
            <div class="card">
                <div class="card-body">
                    <h4><t t-out="permission_request.name"/></h4>
                    <p><strong>Type:</strong> <t t-out="permission_request.request_type"/></p>
                    <p><strong>Client:</strong> <t t-out="permission_request.client_name"/> (<t t-out="permission_request.client_number"/>)</p>
                    <p><strong>Status:</strong> <t t-out="permission_request.approval_status"/></p>
                    <p><strong>Details:</strong> <t t-out="permission_request.request_details"/></p>
                    <p t-if="permission_request.operations_feedback">
                        <strong>Feedback:</strong> <t t-out="permission_request.operations_feedback"/>
                    </p>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_create_permission_request" name="New Permission Request">
        <t t-call="portal.portal_layout">
            <form action="/my/permission-request/create" method="post" class="card p-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-3">
                    <label class="form-label">Request Type</label>
                    <select name="request_type" class="form-select">
                        <option value="lead">Lead</option>
                        <option value="unit">Unit</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Client Name</label>
                    <input type="text" name="client_name" class="form-control"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Client Number</label>
                    <input type="text" name="client_number" class="form-control"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Details</label>
                    <textarea name="request_details" class="form-control"/>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </t>
    </template>
</odoo>
