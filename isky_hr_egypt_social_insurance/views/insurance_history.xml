<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="insurance_line_history_tree_view" model="ir.ui.view">
            <field name="name">insurance.line.history.tree.view</field>
            <field name="model">insurance.line</field>
            <field name="arch" type="xml">
                <list string="Insurance History" create="false" delete="false">
                    <field name="employee_id"/>
                    <field name="wage"/>
                    <field name="insurance_policy_id"/>
                    <field name="insurance_date"/>
                    <field name="subscription"/>
                    <field name="rules_amount"/>
                    <field name="salary_rule_ids"
                           widget="many2many_tags"/>
                    <field name="total_employee_insurance"/>
                    <field name="total_company_insurance"/>
                    <field name="total_insurance"/>
                    <field name="insurance_per_day"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="insurance_line_search_view" model="ir.ui.view">
            <field name="name">insurance.line.search.view</field>
            <field name="model">insurance.line</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="employee_id" string="Employee"/>
                    <separator/>
                    <group expand="0" string="Group By...">
                        <filter string="Employee"
                                name="group_employee_id"
                                domain="[]"
                                context="{'group_by':'employee_id'}"/>
                        <filter string="Status"
                                name="group_state"
                                domain="[]"
                                context="{'group_by':'state'}"/>
                        <filter string="Insurance Policy"
                                name="group_insurance_policy_id"
                                domain="[]"
                                context="{'group_by':'insurance_policy_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_insurance_history" model="ir.actions.act_window">
            <field name="name">Insurance History</field>
            <field name="res_model">insurance.line</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="insurance_line_history_tree_view"/>
            <field name="context">{'search_default_group_employee_id':1}</field>
        </record>


    </data>
</odoo>