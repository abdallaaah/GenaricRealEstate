<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apply_penalty_wizard_view_form" model="ir.ui.view">
        <field name="name">apply.penalty.wizard.view.form</field>
        <field name="model">apply.penalty.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Penalty">
                <group>
                    <field name="penalty_id" readonly="1"/>
                    <field name="customer_id"/>
                    <field name="number_of_periods"/>
                    <field name="penalty_amount" widget="monetary"/>
                </group>
                <footer>
                    <button name="action_create_draft_entry" string="Create Draft Entry" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

