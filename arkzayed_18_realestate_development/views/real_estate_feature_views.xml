<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_real_estate_feature_tree" model="ir.ui.view">
        <field name="name">real.estate.feature.tree</field>
        <field name="model">real.estate.feature</field>
        <field name="arch" type="xml">
            <list string="Features">
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [30, 30]}"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>
    <record id="view_real_estate_feature_form" model="ir.ui.view">
        <field name="name">real.estate.feature.form</field>
        <field name="model">real.estate.feature</field>
        <field name="arch" type="xml">
            <form string="Feature">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image" options="{'size': [50, 50]}"/>
                        <field name="project_id"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_real_estate_feature" model="ir.actions.act_window">
        <field name="name">Features</field>
        <field name="res_model">real.estate.feature</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
