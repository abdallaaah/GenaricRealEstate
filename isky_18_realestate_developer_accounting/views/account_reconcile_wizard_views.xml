<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- from arkzayed_18_vendor_bill/wizard/account_reconcile_wizard.xml -->
    <record id="account_reconcile_wizard_inherit" model="ir.ui.view">
        <field name="name">account_reconcile_wizard_inherit</field>
        <field name="model">account.reconcile.wizard</field>
        <field name="inherit_id" ref="account_accountant.view_account_reconcile_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_partials']" position="before">
                <field name="reconciliation_mode" widget="radio"/>
            </xpath>
            <xpath expr="//field[@name='to_check']" position="after">
                <field name="reconciliation_percentage" invisible="reconciliation_mode != 'construction'"/>
                <field name="original_payment_amount" invisible="reconciliation_mode != 'construction'"/>
            </xpath>
        </field>
    </record>
</odoo>
