<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="job_level_view_form" model="ir.ui.view">
            <field name="name">job_level_view_form</field>
            <field name="model">job.level</field>
            <field name="arch" type="xml">
                <form string="job_level_form">
                    <sheet>
                        <group>
                            <field name="name"/>
                           <field name="is_sales_person"/>
<!--                            <field name="is_team_leader"/>-->
                            <field name="is_directory"/>
                            <field name="is_sales_manager"/>
<!--                            <field name="is_operations"/>-->
                            <field name="is_sales_sector_manager"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="job_level_action" model="ir.actions.act_window">
            <field name="name">Job Level</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">job.level</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="job_level_menu" name="Job Level" parent="hr.menu_config_recruitment" action="job_level_action"/>

    </data>
</odoo>
