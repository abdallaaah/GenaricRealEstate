<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_stage_form_inherit_broker" model="ir.ui.view">
        <field name="name">crm.stage.form.inherit.broker</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="is_won" position="after">
                <field name="is_eoi"/>
                <field name="is_reserved"/>
                <field name="is_contract"/>
                <field name="is_collected"/>
                <field name="is_confirmed_contract"/>
                <field name="is_request_to_cancel"/>
                <field name="is_cancel"/>
            </field>
        </field>
    </record>
</odoo>
