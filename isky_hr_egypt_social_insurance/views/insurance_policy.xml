<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_insurance_policy_form" model="ir.ui.view">
            <field name="name">view.insurance.policy.form</field>
            <field name="model">insurance.policy</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="employee_percentage"/>
                            </group>
                            <group>
                                <field name="policy_date"/>
                                <field name="company_percentage"/>
                            </group>
                            <group colspan="4">
                                <field name="fixed_amount"/>
                                <field name="salary_rule_ids"
                                       widget="many2many_tags"
                                       domain="['|',('category_id.code', '=', 'BASIC'),('type','in',['fixed_bonus','housing','transportation','food','mobile','natural_work','car'])]"
                                       options="{'no_create': True}"
                                       invisible="fixed_amount == True"
                                       required="fixed_amount == False"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_insurance_policy_tree" model="ir.ui.view">
            <field name="name">view.insurance.policy.tree</field>
            <field name="model">insurance.policy</field>
            <field name="arch" type="xml">
                <list string="arch">
                    <field name="name"/>
                    <field name="policy_date"/>
                    <field name="employee_percentage"/>
                    <field name="company_percentage"/>
                </list>
            </field>
        </record>

        <record id="action_insurance_policy" model="ir.actions.act_window">
            <field name="name">Insurance Policy</field>
            <field name="res_model">insurance.policy</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>