<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
        <record id="project_phase_tree" model="ir.ui.view">
            <field name="name">project_phase_tree</field>
            <field name="model">real.estate.project.phase</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>
        <record id="project_phase_form" model="ir.ui.view">
            <field name="name">project_phase_form</field>
            <field name="model">real.estate.project.phase</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="id"/>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="image" widget="image"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="is_phase_one"/>
                            <field name="is_phase_two"/>
                            <field name="is_phase_three"/>
                            <field name="is_phase_four" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="project_phase_action">
            <field name="name">Project Phase</field>
            <field name="res_model">real.estate.project.phase</field>
            <field name="view_mode">list,form</field>
        </record>
</odoo>
