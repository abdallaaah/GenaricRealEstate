        <record id="sales_manager_group" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        <record id="operation_manager_group" model="res.groups">
            <field name="name">Sales Sector Manager</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('arkzayed_18_realestate_broker.sales_manager_group'))]"/>
        </record>
        <record id="director_manager_group" model="res.groups">
            <field name="name">Director</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('arkzayed_18_realestate_broker.operation_manager_group'))]"/>
        </record>


        <record id="sales_administrator_group" model="res.groups">
            <field name="name">Sales Administrator</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('arkzayed_18_realestate_broker.director_manager_group'))]"/>
        </record>

