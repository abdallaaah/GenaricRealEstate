<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 6: the two S8 settings now sit in the shared "Real Estate" tab's real sections -
         the credit account under Financials, the toggle under Sales Setup - instead of in a
         "Real Estate Cheques" tab of their own. L0 declares both headings and their containers
         (decisions log, 2026-11-07, P1 and the P2 amendment); L0 is already a dependency through
         sales_crm, so nothing new is added. Both entries still appear only when this bridge is
         installed, which is what S8 asks for. The 12.3 gap is untouched. -->
    <record id="res_config_settings_view_form_sales_cheques" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sales.cheques</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="76"/>
        <field name="inherit_id" ref="isky_18_realestate_developer_unit_inventory.res_config_settings_view_form_real_estate"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='realestate_financials_section']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Incoming Cheque Credit Account</span>
                            <div class="text-muted">
                                Credit account used for every incoming cheque. Required: creating a
                                cheque without it is rejected.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="cheque_incoming_credit_account_id"
                                           string="Credit Account" class="col-lg-4 o_light_label"/>
                                    <field name="cheque_incoming_credit_account_id"
                                           context="{'active_test': False}"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>
            </xpath>

            <xpath expr="//div[@id='realestate_sales_setup_section']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="cheques_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="cheques_enabled"/>
                            <div class="text-muted">
                                Generate cheques from a sale proposal's payment plan. When off, deals
                                produce no cheques; registering a cheque by hand still works.
                            </div>
                        </div>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>
