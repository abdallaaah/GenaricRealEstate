<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sales_achievement_landscape" model="report.paperformat">
        <field name="name">Sales Achievement A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sales_achievement" model="ir.actions.report">
        <field name="name">Sales Achievement Report</field>
        <field name="model">sales.achievement.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arkzayed_18_realestate_developer_crm.report_sales_achievement</field>
        <field name="report_file">arkzayed_18_realestate_developer_crm.report_sales_achievement</field>
        <field name="print_report_name">'Sales Achievement %s - %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_sales_achievement_landscape"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sales_achievement">
        <t t-call="web.html_container">
            <t t-set="d" t-value="report_data"/>
            <t t-set="primary" t-value="colors['primary']"/>
            <t t-set="secondary" t-value="colors['secondary']"/>
            <t t-set="period" t-value="'%s  -  %s' % (d['date_from'].strftime('%d/%m/%Y'), d['date_to'].strftime('%d/%m/%Y'))"/>

            <!-- ======================= BODY ======================= -->
            <t t-foreach="docs[:1]" t-as="o">
                <!-- Company header / footer come from the Odoo document layout (Settings > Document Layout) -->
                <t t-call="web.external_layout">
                <div class="page" style="color: #262626;">
                    <style>
                        /* Explicit system font: the Lato web font renders unreliably in wkhtmltopdf */
                        .page, .page * { font-family: Arial, Helvetica, sans-serif !important; }
                        .sa-kpis { width: 100%; border-collapse: separate; border-spacing: 8px 0; margin: 0 -8px 16px; }
                        .sa-kpi { background: #F3F3F2; padding: 9px 10px; text-align: center; border: 0 !important; border-top: 3px solid <t t-esc="primary"/> !important; }
                        .sa-kpi .lbl { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; color: #6b6b6b; }
                        .sa-kpi .val { font-size: 19px; font-weight: bold; color: <t t-esc="primary"/>; margin-top: 2px; }
                        .sa-section { font-size: 14px; font-weight: bold; color: <t t-esc="primary"/>; text-transform: uppercase;
                                      letter-spacing: .6px; border-bottom: 2px solid <t t-esc="primary"/>; padding-bottom: 3px; margin: 4px 0 8px; }
                        .sa-table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-bottom: 14px; page-break-inside: auto; }
                        .sa-table tr { page-break-inside: avoid; }
                        .sa-table thead { display: table-header-group; }
                        .sa-table th { background: <t t-esc="primary"/>; color: #fff; font-weight: bold; text-align: center;
                                       padding: 5px 6px; border: 1px solid #fff; vertical-align: middle; }
                        .sa-table th.grp { background: #E7E6E6; color: <t t-esc="primary"/>; }
                        .sa-table td { padding: 4px 6px; border: 0; border-bottom: 1px solid #E3E3E3; }
                        .sa-table tbody tr:nth-child(even) td { background: #F8F8F7; }
                        .sa-table td.num { text-align: right; white-space: nowrap; }
                        .sa-table td.ctr { text-align: center; }
                        .sa-table td.muted { color: #8a8a8a; }
                        .sa-table tr.total td { background: #E7E6E6 !important; color: <t t-esc="primary"/>; font-weight: bold;
                                                border-top: 2px solid <t t-esc="primary"/>; border-bottom: 2px solid <t t-esc="primary"/>; }
                        .sa-layout, .sa-layout > tbody > tr > td, .sa-layout > tr > td { border: 0 !important; background: transparent !important; }
                        .sa-bar { height: 5px; background: #E7E6E6; margin-top: 2px; }
                        .sa-bar span { display: block; height: 5px; background: <t t-esc="primary"/>; }
                    </style>

                    <!-- Title -->
                    <div style="text-align: center; margin-bottom: 12px;">
                        <div t-attf-style="font-size: 22px; font-weight: bold; letter-spacing: 1px; color: {{primary}};">SALES ACHIEVEMENT REPORT</div>
                        <div style="font-size: 12px; color: #6b6b6b;">
                            Contract Issue Date: <span t-esc="period"/>
                            <span style="margin: 0 6px;">|</span>
                            Printed by <span t-esc="user.name"/> on <span t-esc="printed_on.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>

                    <!-- KPI strip -->
                    <table class="sa-kpis o_ignore_layout_styling">
                        <tr>
                            <td class="sa-kpi" style="width: 16%;">
                                <div class="lbl">Contracts</div>
                                <div class="val" t-esc="d['kpis']['contracts']"/>
                            </td>
                            <td class="sa-kpi" style="width: 16%;">
                                <div class="lbl">Units</div>
                                <div class="val" t-esc="fmt_units(d['kpis']['units'])"/>
                            </td>
                            <td class="sa-kpi" style="width: 24%;">
                                <div class="lbl">Total Value (EGP)</div>
                                <div class="val" t-esc="fmt_money(d['kpis']['value'])"/>
                            </td>
                            <td class="sa-kpi" style="width: 22%;">
                                <div class="lbl">Commercial Value</div>
                                <div class="val" t-esc="fmt_money(d['kpis']['commercial_value'])"/>
                            </td>
                            <td class="sa-kpi" style="width: 22%;">
                                <div class="lbl">Residential Value</div>
                                <div class="val" t-esc="fmt_money(d['kpis']['residential_value'])"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Sales table -->
                    <div class="sa-section">Sales</div>
                    <table class="sa-table o_ignore_layout_styling">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width: 17%;">Sales</th>
                                <th rowspan="2" style="width: 14%;">Sales Manager</th>
                                <th colspan="2" class="grp">Commercial</th>
                                <th colspan="2" class="grp">Residential</th>
                                <th rowspan="2" style="width: 13%;">Total Value</th>
                                <th rowspan="2" style="width: 12%;">Share</th>
                            </tr>
                            <tr>
                                <th style="width: 7%;">Units</th>
                                <th style="width: 12%;">Value</th>
                                <th style="width: 7%;">Units</th>
                                <th style="width: 12%;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="not d['sales_rows']">
                                <td colspan="8" class="ctr muted">No contracts found for this period.</td>
                            </tr>
                            <tr t-foreach="d['sales_rows']" t-as="line">
                                <td style="font-weight: bold;" t-esc="line['name']"/>
                                <td t-att-class="'' if line['manager'] else 'muted'" t-esc="line['manager'] or '-'"/>
                                <td class="ctr" t-esc="fmt_units(line['commercial_units'])"/>
                                <td class="num" t-esc="fmt_money(line['commercial_value'])"/>
                                <td class="ctr" t-esc="fmt_units(line['residential_units'])"/>
                                <td class="num" t-esc="fmt_money(line['residential_value'])"/>
                                <td class="num" style="font-weight: bold;" t-esc="fmt_money(line['total'])"/>
                                <td>
                                    <div style="font-size: 10px; text-align: right;" t-esc="fmt_pct(line['share'])"/>
                                    <div class="sa-bar"><span t-attf-style="width: {{min(line['share'], 100)}}%;"/></div>
                                </td>
                            </tr>
                            <tr class="total">
                                <td colspan="2">Grand Total</td>
                                <td class="ctr" t-esc="fmt_units(d['sales_totals']['commercial_units'])"/>
                                <td class="num" t-esc="fmt_money(d['sales_totals']['commercial_value'])"/>
                                <td class="ctr" t-esc="fmt_units(d['sales_totals']['residential_units'])"/>
                                <td class="num" t-esc="fmt_money(d['sales_totals']['residential_value'])"/>
                                <td class="num" t-esc="fmt_money(d['sales_totals']['total'])"/>
                                <td class="ctr" t-esc="fmt_pct(100 if d['sales_totals']['total'] else 0)"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Managers tables -->
                    <div style="page-break-inside: avoid;">
                    <div class="sa-section">Managers</div>
                    <table class="sa-layout o_ignore_layout_styling" style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <t t-foreach="[('Commercial', 'commercial_rows', 'commercial_totals'), ('Residential', 'residential_rows', 'residential_totals')]" t-as="section">
                                <td t-attf-style="border: 0; width: 50%; vertical-align: top; padding-{{'right' if section_first else 'left'}}: 8px;">
                                    <table class="sa-table o_ignore_layout_styling">
                                        <thead>
                                            <tr><th colspan="4" class="grp" t-esc="section[0]"/></tr>
                                            <tr>
                                                <th style="width: 40%;">Sales Manager</th>
                                                <th style="width: 14%;">Units</th>
                                                <th style="width: 26%;">Value</th>
                                                <th style="width: 20%;">Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-if="not d[section[1]]">
                                                <td colspan="4" class="ctr muted">No data</td>
                                            </tr>
                                            <tr t-foreach="d[section[1]]" t-as="line">
                                                <td style="font-weight: bold;" t-esc="line['name']"/>
                                                <td class="ctr" t-esc="fmt_units(line['units'])"/>
                                                <td class="num" t-esc="fmt_money(line['value'])"/>
                                                <td>
                                                    <div style="font-size: 10px; text-align: right;" t-esc="fmt_pct(line['share'])"/>
                                                    <div class="sa-bar"><span t-attf-style="width: {{min(line['share'], 100)}}%;"/></div>
                                                </td>
                                            </tr>
                                            <tr class="total">
                                                <td>Grand Total</td>
                                                <td class="ctr" t-esc="fmt_units(d[section[2]]['units'])"/>
                                                <td class="num" t-esc="fmt_money(d[section[2]]['value'])"/>
                                                <td class="ctr" t-esc="fmt_pct(100 if d[section[2]]['value'] else 0)"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </t>
                        </tr>
                    </table>
                    </div>

                    <!-- Contract Details table -->
                    <div class="sa-section">Contract Details</div>
                    <table class="sa-table o_ignore_layout_styling">
                        <thead>
                            <tr>
                                <th style="width: 10%;">Contract</th>
                                <th style="width: 8%;">Issue Date</th>
                                <th style="width: 8%;">Discount %</th>
                                <th style="width: 12%;">Price Before Discount</th>
                                <th style="width: 12%;">Value</th>
                                <th style="width: 12%;">Discount Approved By</th>
                                <th style="width: 20%;">Customer</th>
                                <th style="width: 18%;">Sales</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="not d['contract_lines']">
                                <td colspan="8" class="ctr muted">No contracts found for this period.</td>
                            </tr>
                            <tr t-foreach="d['contract_lines']" t-as="line">
                                <td t-esc="line['name']"/>
                                <td class="ctr" t-esc="line['date'].strftime('%d/%m/%Y') if line['date'] else ''"/>
                                <td class="ctr" t-esc="fmt_pct(line['discount_percentage'])"/>
                                <td class="num" t-esc="fmt_money(line['price_before_discount'])"/>
                                <td class="num" t-esc="fmt_money(line['price'])"/>
                                <td t-esc="line['discount_approved_by']"/>
                                <td t-esc="line['customer']"/>
                                <td class="muted" t-esc="line['sales']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div style="font-size: 9.5px; color: #8a8a8a; margin-top: 4px;">
                        Values are Price After Discount. Excluded statuses: Draft Proposal, Draft Contract, Pending Approvals,
                        Cancelled, Terminated. Non-residential units are counted as Commercial. Split units follow the
                        percentages in each contract's Commission tab; deals referred by Management or Board Representative
                        are credited to those rows in the Managers tables.
                    </div>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
