<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
    <record id="view_unit_design_tree" model="ir.ui.view">
        <field name="name">unit.design.tree</field>
        <field name="model">unit.design</field>
        <field name="arch" type="xml">
            <list string="Unit Designs">
                <field name="name"/>
                <field name="design_type"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_unit_design_form" model="ir.ui.view">
        <field name="name">unit.design.form</field>
        <field name="model">unit.design</field>
        <field name="arch" type="xml">
            <form string="Unit Design">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="design_type"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_unit_design" model="ir.actions.act_window">
        <field name="name">Unit Designs</field>
        <field name="res_model">unit.design</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
