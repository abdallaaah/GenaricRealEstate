<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="contract_change_ownership_wizard_form" model="ir.ui.view">
            <field name="name">contract.change.ownership.wizard.form</field>
            <field name="model">contract.change.ownership.wizard</field>
            <field name="arch" type="xml">
                <form string="Change Ownership">
                    <sheet>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="current_customer_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="new_customer_id" domain="[('is_customer', '=', True)]" required="1"/>
                        </group>

                        <group string="Cheque Settings">
                            <group>
                                <field name="number_of_banks" required="1" widget="radio"/>
                                <field name="cheque_is_serial" required="1" widget="radio"/>
                            </group>
                        </group>

                        <group string="Bank 1">
                            <group>
                                <field name="bank_id" required="1"/>
                                <field name="cheque_starting_number"
                                       required="cheque_is_serial == 'serial'"
                                       invisible="cheque_is_serial != 'serial'"/>
                            </group>
                            <group>
                                <field name="bank_1_installments_count"/>
                            </group>
                        </group>

                        <group string="Bank 2" invisible="number_of_banks in ('1',)">
                            <group>
                                <field name="bank_id_2"
                                       required="number_of_banks in ('2', '3')"/>
                                <field name="cheque_starting_number_2"
                                       required="number_of_banks in ('2', '3') and cheque_is_serial == 'serial'"
                                       invisible="cheque_is_serial != 'serial'"/>
                            </group>
                            <group>
                                <field name="bank_2_installments_count"/>
                            </group>
                        </group>

                        <group string="Bank 3" invisible="number_of_banks != '3'">
                            <group>
                                <field name="bank_id_3"
                                       required="number_of_banks == '3'"/>
                                <field name="cheque_starting_number_3"
                                       required="number_of_banks == '3' and cheque_is_serial == 'serial'"
                                       invisible="cheque_is_serial != 'serial'"/>
                            </group>
                            <group>
                                <field name="bank_3_installments_count"/>
                            </group>
                        </group>

                        <div class="text-muted" colspan="2">
                            Leave the "Number of Installments" fields at 0 to auto-distribute the
                            remaining cheques evenly across the selected banks.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_change_ownership_wizard" model="ir.actions.act_window">
            <field name="name">Change Ownership</field>
            <field name="res_model">contract.change.ownership.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>