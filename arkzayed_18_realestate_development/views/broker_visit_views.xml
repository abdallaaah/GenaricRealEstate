<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_broker_visit_list" model="ir.ui.view">
            <field name="name">broker.visit.list</field>
            <field name="model">broker.visit</field>
            <field name="arch" type="xml">
                <list string="Broker Visits">
                    <field name="name"/>
                    <field name="broker_id"/>
                    <field name="visit_date"/>
                    <field name="check_in_datetime"/>
                    <field name="check_out_datetime"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'checked_in'" decoration-success="state == 'checked_out'"/>
                </list>
            </field>
        </record>

        <record id="view_broker_visit_form" model="ir.ui.view">
            <field name="name">broker.visit.form</field>
            <field name="model">broker.visit</field>
            <field name="arch" type="xml">
                <form string="Broker Visit">
                    <header>
                        <button name="action_check_in" string="Check In" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_check_out" string="Check Out" type="object" class="oe_highlight" invisible="state != 'checked_in'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,checked_in,checked_out"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="broker_id" readonly="state != 'draft'"/>
                                <field name="visit_date" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="check_in_datetime"/>
                                <field name="check_out_datetime"/>
                                <separator string="Location Attachment"/>
                                <field name="location_attachment"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Comments" name="comments">
                                <field name="comment_ids" readonly="state == 'checked_out'">
                                    <list editable="bottom">
                                        <field name="date" readonly="1"/>
                                        <field name="user_id" readonly="1"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_broker_visit_search" model="ir.ui.view">
            <field name="name">broker.visit.search</field>
            <field name="model">broker.visit</field>
            <field name="arch" type="xml">
                <search string="Search Broker Visits">
                    <field name="name"/>
                    <field name="broker_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                    <filter string="Checked Out" name="checked_out" domain="[('state', '=', 'checked_out')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Broker" name="group_by_broker" context="{'group_by': 'broker_id'}"/>
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Visit Date" name="group_by_date" context="{'group_by': 'visit_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_broker_visit" model="ir.actions.act_window">
            <field name="name">Broker Visits</field>
            <field name="res_model">broker.visit</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_broker_visit_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Record a new broker visit
                </p>
                <p>
                    Track broker visit date, actual check-in/check-out timestamps, and record notes.
                </p>
            </field>
        </record>

    </data>
</odoo>
