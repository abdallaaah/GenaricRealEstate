<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_developer_project_list" model="ir.ui.view">
            <field name="name">developer.project.list</field>
            <field name="model">developer.project</field>
            <field name="arch" type="xml">
                <list string="Projects">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="developer_id"/>
                    <field name="country_id"/>
                    <field name="governorate_id"/>
                    <field name="city_id"/>
                    <field name="neighborhood_id"/>
                </list>
            </field>
        </record>
        <record id="view_developer_project_form" model="ir.ui.view">
            <field name="name">developer.project.form</field>
            <field name="model">developer.project</field>
            <field name="arch" type="xml">
                <form string="Developer Project">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="developer_id"/>
                                <field name="country_id"/>
                                <field name="governorate_id"/>
                                <field name="city_id"/>
                                <field name="neighborhood_id"/>
                            </group>
                            <group>
                                <field name="double_commission"/>
                                <field name="half_commission"/>

                            </group>
                            <notebook>
                                <page string="Project Commissions">
                                        <field name="project_commission_ids" context="{'default_start_date': last_end_date}">
                                            <list editable="bottom" string="Project Commissions">
                                                <field name="start_date" readonly="not is_first_commission"/>
                                                <field name="end_date"/>
                                                <field name="commission_percentage" widget="percentage"/>
                                                <field name="additional_commission_percentage" widget="percentage"/>
                                            </list>
                                        </field>
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_developer_project" model="ir.actions.act_window">
            <field name="name">Developer Project</field>
            <field name="res_model">developer.project</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
