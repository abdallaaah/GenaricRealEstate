        <field name="res_model">ark.engineer.inventory</field>
        <field name="view_mode">list</field>
        <field name="domain">[('unit_type', '=', 'residential')]</field>
        <field name="context">{'engineer_kind': 'residential'}</field>
        <field name="search_view_id" ref="view_ark_engineer_inventory_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_ark_engineer_inventory_residential')})]"/>
