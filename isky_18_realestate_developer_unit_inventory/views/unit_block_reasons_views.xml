<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 1: moved here from arkzayed_18_realestate_development, verbatim and with the same
         local xmlids. L0 owns these models, so it owns their UI. -->
    <record id="view_unit_block_reason_list" model="ir.ui.view">
        <field name="name">unit.block.reason.list</field>
        <field name="model">block.reason</field>
        <field name="arch" type="xml">
            <list string="Unit Block Reasons">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_unit_block_reason_form" model="ir.ui.view">
        <field name="name">unit.block.reason.form</field>
        <field name="model">block.reason</field>
        <field name="arch" type="xml">
            <form string="Block Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group></group>
                    <group>
                        <group>
                            <field name="for_initial_reservation" />
                            <field name="for_draft_reservation" />
                            <field name="for_reallocation" />

                        </group>
                        <group>
                            <field name="blocked_from_cancellation" />
                            <field name="blocked_from_termination"/>
                            <field name="for_upgrade"/>
                            <field name="for_sale_request"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_unit_block_reason" model="ir.actions.act_window">
        <field name="name">Block Reasons</field>
        <field name="res_model">block.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
