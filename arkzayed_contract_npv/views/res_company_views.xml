<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_npv_inherit" model="ir.ui.view">
        <field name="name">res.company.form.npv.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="NPV" groups="arkzayed_contract_npv.group_npv_access">
                    <field name="npv_discount_rate"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
