<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Search View -->
        <record id="crm_meeting_report_view_search" model="ir.ui.view">
            <field name="name">crm.meeting.report.search</field>
            <field name="model">crm.meeting.report</field>
            <field name="arch" type="xml">
                <search string="Meetings Analysis">
                    <field name="user_id"/>
                    <field name="date_deadline"/>
                    <filter string="My Meetings" name="my_meetings" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Date" name="date" date="date_deadline"/>
                    <group expand="0" string="Group By">
                        <filter string="Salesperson" name="salesperson" context="{'group_by': 'user_id'}"/>
                        <filter string="Year" name="year" context="{'group_by': 'year'}"/>
                        <filter string="Quarter" name="quarter" context="{'group_by': 'quarter'}"/>
                        <filter string="Month" name="month" context="{'group_by': 'month'}"/>
                        <filter string="Week" name="week" context="{'group_by': 'week'}"/>
                        <filter string="Day" name="day" context="{'group_by': 'day'}"/>
                        <filter string="Meeting Date" name="date_deadline" context="{'group_by': 'date_deadline'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Tree View -->
        <record id="crm_meeting_report_view_tree" model="ir.ui.view">
            <field name="name">crm.meeting.report.tree</field>
            <field name="model">crm.meeting.report</field>
            <field name="arch" type="xml">
                <list string="Meetings Analysis" create="false">
                    <field name="user_id"/>
                    <field name="date_deadline"/>
                    <field name="meeting_count" sum="Total Meetings"/>
                    <field name="meeting_done_count" sum="Done Meetings"/>
<!--                    <field name="meeting_canceled_count" sum="Canceled Meetings"/>-->
                </list>
            </field>
        </record>

        <!-- Main Action -->
        <record id="action_crm_meeting_report" model="ir.actions.act_window">
            <field name="name">Meetings</field>
            <field name="res_model">crm.meeting.report</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_salesperson': 1, 'search_default_month': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No data yet!
                </p>
                <p>
                    Create meetings in your CRM to see the analysis here.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_crm_meeting_report"
                  name="Meetings"
                  parent="crm.crm_menu_report"
                  action="action_crm_meeting_report"
                  sequence="15"/>
    </data>
</odoo>
