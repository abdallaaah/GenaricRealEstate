<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cheque_split_wizard_form" model="ir.ui.view">
        <field name="name">cheque.split.wizard.form</field>
        <field name="model">cheque.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Replace With Individual Cheques">
                <group>
                    <group>
                        <field name="cheque_id" readonly="1"/>
                        <field name="cheque_state" invisible="1"/>
                        <field name="bank_id"/>
                    </group>
                    <group>
                        <field name="starting_number"/>
                        <field name="return_reason_id"
                               invisible="cheque_state != 'collect'"
                               required="cheque_state == 'collect'"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="installment_id" column_invisible="1"/>
                        <field name="maintenance_id" column_invisible="1"/>
                        <field name="sale_proposal_id" readonly="1" force_save="1"/>
                        <field name="unit_id" readonly="1" force_save="1"/>
                        <field name="amount" readonly="1" force_save="1"/>
                        <field name="cheque_date"/>
                        <field name="cheque_no"/>
                        <field name="bank_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Create Individual Cheques"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
