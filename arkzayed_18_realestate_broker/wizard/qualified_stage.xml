<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_qualified_stage_wizard_form" model="ir.ui.view">
            <field name="name">qualified.stage.wizard.form</field>
            <field name="model">qualified.stage.wizard</field>
            <field name="arch" type="xml">
                <form string="Complete Required Fields">
                    <p>Please fill in the following fields:</p>
                    <field name="lead_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="unit_type"/>
                            <field name="finish_type"/>
                        </group>
                        <group>
                            <label for="min_area" string="Area"/>
                            <div name="area" class="o_row">
                                <field name="min_area" widget="float" string="Min Area"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                <field name="max_area" widget="float" string="Max Area"/>
                            </div>
                            <label for="min_price" string="Budget"/>
                            <div name="budget" class="o_row">
                                <field name="min_price" widget="monetary" string="Min Budget"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                <field name="max_price" widget="monetary" string="Max Budget"/>
                            </div>
                        </group>
                        <group>
                            <field name="qualified_comment"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
