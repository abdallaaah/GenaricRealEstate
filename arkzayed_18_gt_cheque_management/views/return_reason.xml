<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="return_reason_view_tree" model="ir.ui.view">
            <field name="name">return_reason_view_tree</field>
            <field name="model">return.reason</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="return_reason_view_form" model="ir.ui.view">
            <field name="name">return_reason_view_form</field>
            <field name="model">return.reason</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="return_reason_action" model="ir.actions.act_window">
            <field name="name">Return Reason</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">return.reason</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
