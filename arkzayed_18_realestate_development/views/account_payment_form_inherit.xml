<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="account_payment_form_view_inherit_returned_cheques" model="ir.ui.view">
            <field name="name">account.payment.form.view.inherit.returned.cheques</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='main_group']" position="after">
                    <group>
                        <group string="returned Cheques">
                            <field name="is_returned_cheque" widget="boolean_toggle"
                                   invisible="payment_type == 'outbound'"/>
                            <field name="returned_cheque_ids" widget="many2many_tags"
                                   invisible="not is_returned_cheque"/>
                            <field name="returned_source_type" invisible="not is_returned_cheque"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
