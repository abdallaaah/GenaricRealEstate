<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cost_distribution_list" model="ir.ui.view">
        <field name="name">arkzayed.cost.distribution.list</field>
        <field name="model">arkzayed.cost.distribution</field>
        <field name="arch" type="xml">
            <list string="Distribution Report" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="create_uid" string="By" widget="many2one_avatar_user"/>
                <field name="move_id"/>
                <field name="partner_id" optional="show"/>
                <field name="description" optional="show"/>
                <field name="building_ids" widget="many2many_tags"/>
                <field name="units_summary"/>
                <field name="total_area" optional="show"/>
                <field name="rate_per_sqm" optional="show"/>
                <field name="cost_type" widget="badge"
                       decoration-info="cost_type == 'direct'" decoration-warning="cost_type == 'indirect'"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_cost_distribution_form" model="ir.ui.view">
        <field name="name">arkzayed.cost.distribution.form</field>
        <field name="model">arkzayed.cost.distribution</field>
        <field name="arch" type="xml">
            <form string="Cost Distribution" create="0" edit="0" delete="0">
                <header>
                    <button name="%(arkzayed_cost_distribution.action_report_cost_distribution)d" type="action"
                            string="Print Report" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="create_date" string="Allocated On"/>
                            <field name="create_uid" string="Allocated By"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="cost_type"/>
                            <field name="amount"/>
                            <field name="total_area"/>
                            <field name="rate_per_sqm"/>
                            <field name="unit_count"/>
                        </group>
                    </group>
                    <separator string="Unit Details"/>
                    <field name="allocation_ids">
                        <list>
                            <field name="building_id"/>
                            <field name="unit_id"/>
                            <field name="unit_area"/>
                            <field name="rate_per_sqm"/>
                            <field name="percentage" optional="hide"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cost_distribution_pivot" model="ir.ui.view">
        <field name="name">arkzayed.cost.distribution.pivot</field>
        <field name="model">arkzayed.cost.distribution</field>
        <field name="arch" type="xml">
            <pivot string="Distribution Report">
                <field name="partner_id" type="row"/>
                <field name="cost_type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cost_distribution_search" model="ir.ui.view">
        <field name="name">arkzayed.cost.distribution.search</field>
        <field name="model">arkzayed.cost.distribution</field>
        <field name="arch" type="xml">
            <search string="Distribution Report">
                <field name="name"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="building_ids"/>
                <field name="unit_ids"/>
                <field name="create_uid" string="Allocated By"/>
                <filter name="direct" string="Direct" domain="[('cost_type', '=', 'direct')]"/>
                <filter name="indirect" string="Indirect" domain="[('cost_type', '=', 'indirect')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('create_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_bill" string="Bill" context="{'group_by': 'move_id'}"/>
                    <filter name="group_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_user" string="Allocated By" context="{'group_by': 'create_uid'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cost_distribution" model="ir.actions.act_window">
        <field name="name">Distribution Report</field>
        <field name="res_model">arkzayed.cost.distribution</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_cost_distribution_search"/>
    </record>

    <menuitem id="menu_cost_distribution_report" name="Distribution Report"
              parent="menu_arkzayed_cost_root" action="action_cost_distribution" sequence="20"/>

</odoo>
