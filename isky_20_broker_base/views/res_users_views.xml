<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_broker" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.broker</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="before">
                <page name="broker_information" string="Broker Information">
                    <group>
                        <field name="job_level_id"/>
                        <field name="sale_team_id" readonly="1"/>
                        <field name="user_department_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
