<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Phase 3c step 2a: moved here from arkzayed_18_realestate_developer_crm, verbatim and with the same
         local xmlids. L2 owns these models, so it owns their UI. -->
    <record id="view_sales_achievement_report_wizard_form" model="ir.ui.view">
        <field name="name">sales.achievement.report.wizard.form</field>
        <field name="model">sales.achievement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Achievement Report">
                <p class="text-muted">
                    Contracts are filtered by Contract Issue Date. Draft, Draft Contract, Pending Approvals,
                    Cancelled and Terminated contracts are excluded. Any unit type other than Residential is
                    counted as Commercial. Deals referred by Management or Board Representative are credited to
                    Top Management / Board Representative in the Managers tables.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF" type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sales_achievement_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales Achievement Report</field>
        <field name="res_model">sales.achievement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
