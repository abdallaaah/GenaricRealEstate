<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_work_permit_form" model="ir.ui.view">
            <field name="name">view.work.permit.form</field>
            <field name="model">work.permit</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="payment_no"/>
                                <field name="amount"/>
                            </group>
                            <group>
                                <field name="issued_date"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>