<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_sales_landscape" model="report.paperformat">
        <field name="name">Sales - A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sales" model="ir.actions.report">
        <field name="name">Sales Executive Report</field>
        <field name="model">arkzayed.sales.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arkzayed_18_realestate_development.report_sales</field>
        <field name="report_file">arkzayed_18_realestate_development.report_sales</field>
        <field name="print_report_name">'Sales Executive Report'</field>
        <field name="paperformat_id" ref="paperformat_sales_landscape"/>
    </record>

    <template id="report_sales">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 10pt; color: #1f2937;">

                    <div style="font-size: 20pt; font-weight: bold; color: #0f2a4a;">Sales Executive Report</div>
                    <div style="color: #6b7280; margin-bottom: 12px;">
                        As of <span t-out="today" t-options="{'widget': 'date'}"/> &#160;|&#160; Prepared by <span t-out="user_name"/>
                        &#160;|&#160; All contract statuses except Draft, Cancelled and Terminated; year by contract issue date; value = price after discount
                        <t t-if="filters"> &#160;|&#160; Filter: <span t-out="filters"/></t>
                    </div>

                    <table style="width: 100%; border-collapse: separate; border-spacing: 8px 0; margin: 0 -8px 14px -8px;">
                        <tr><td style="width:20%; background:#0f2a4a; padding:10px 12px; border-radius:4px;"><div style="font-size:8pt; text-transform:uppercase; color:#fff;">Total Sales Value</div><div style="font-size:13pt; font-weight:bold; color:#fff;" t-out="total['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><div style="font-size:8pt; color:#fff;"><t t-out="total['contracts']"/> contracts</div></td><td style="width:20%; background:#eef2f7; padding:10px 12px; border-radius:4px;"><div style="font-size:8pt; text-transform:uppercase; color:#6b7280;">Avg. Price per m&#178;</div><div style="font-size:13pt; font-weight:bold; color:#1f2937;" t-out="total['per_sqm']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><div style="font-size:8pt; color:#6b7280;"><t t-out="'{:,.0f}'.format(total['area'])"/> m&#178; gross area sold</div></td><td style="width:20%; background:#e8eef8; padding:10px 12px; border-radius:4px;"><div style="font-size:8pt; text-transform:uppercase; color:#6b7280;">Domestic</div><div style="font-size:13pt; font-weight:bold; color:#0f2a4a;" t-out="total['domestic'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><div style="font-size:8pt; color:#6b7280;"><t t-out="total['domestic'][0]"/> contracts &#183; <t t-out="'{:,.1f}%'.format(total['domestic_share'])"/></div></td><td style="width:20%; background:#e3f5f2; padding:10px 12px; border-radius:4px;"><div style="font-size:8pt; text-transform:uppercase; color:#6b7280;">Overseas</div><div style="font-size:13pt; font-weight:bold; color:#0d9488;" t-out="total['overseas'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><div style="font-size:8pt; color:#6b7280;"><t t-out="total['overseas'][0]"/> contracts &#183; <t t-out="'{:,.1f}%'.format(total['overseas_share'])"/></div></td><td style="width:20%; background:#f3f4f6; padding:10px 12px; border-radius:4px;"><div style="font-size:8pt; text-transform:uppercase; color:#6b7280;">Not Specified</div><div style="font-size:13pt; font-weight:bold; color:#6b7280;" t-out="total['unspecified'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><div style="font-size:8pt; color:#6b7280;"><t t-out="total['unspecified'][0]"/> contracts without a type</div></td></tr>
                    </table>

                    <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Sales by Year (contract issue date)</div>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 4px; font-size: 9pt;">
                        <thead>
                            <tr style="background: #0f2a4a; color: #fff;">
                                <th rowspan="2" style="padding: 5px 8px; text-align: left;">Year</th><th rowspan="2" style="padding: 5px 8px; text-align: right;">Contracts</th><th rowspan="2" style="padding: 5px 8px; text-align: right;">Sales Value</th><th rowspan="2" style="padding: 5px 8px; text-align: right;">Avg. Price / m&#178;</th>
                                <th colspan="3" style="padding: 4px 8px; text-align: center; background: #16407a;">Domestic</th>
                                <th colspan="3" style="padding: 4px 8px; text-align: center; background: #0d9488;">Overseas</th>
                                <th rowspan="2" style="padding: 5px 8px; text-align: right;">Not Specified</th>
                            </tr>
                            <tr style="background: #0f2a4a; color: #fff;">
                                <th style="padding: 4px 8px; text-align: right; background: #16407a;">Contracts</th>
                                <th style="padding: 4px 8px; text-align: right; background: #16407a;">Value</th>
                                <th style="padding: 4px 8px; text-align: right; background: #16407a;">%</th>
                                <th style="padding: 4px 8px; text-align: right; background: #0d9488;">Contracts</th>
                                <th style="padding: 4px 8px; text-align: right; background: #0d9488;">Value</th>
                                <th style="padding: 4px 8px; text-align: right; background: #0d9488;">%</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="year_rows" t-as="y">
                                <tr t-att-style="'background: #f6f8fb;' if y_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold;" t-out="y['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="y['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['per_sqm']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['domestic'][0]"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['domestic'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(y['domestic_share'])"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['overseas'][0]"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['overseas'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(y['overseas_share'])"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; color: #6b7280;" t-out="y['unspecified'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                            </t>
                            <tr style="font-weight: bold; background: #eef2f7;"><td style="padding: 6px 8px;">Total</td><td style="padding: 6px 8px; text-align: right;" t-out="total['contracts']"/><td style="padding: 6px 8px; text-align: right;" t-out="total['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right;" t-out="total['per_sqm']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right;" t-out="total['domestic'][0]"/><td style="padding: 6px 8px; text-align: right;" t-out="total['domestic'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right;" t-out="'{:,.1f}%'.format(total['domestic_share'])"/><td style="padding: 6px 8px; text-align: right;" t-out="total['overseas'][0]"/><td style="padding: 6px 8px; text-align: right;" t-out="total['overseas'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right;" t-out="'{:,.1f}%'.format(total['overseas_share'])"/><td style="padding: 6px 8px; text-align: right;" t-out="total['unspecified'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                        </tbody>
                    </table>
                    <div style="font-size: 8pt; color: #6b7280; margin-bottom: 14px;">
                        <span style="display:inline-block; width:9px; height:9px; background:#0f2a4a;"/> Domestic &#160;
                        <span style="display:inline-block; width:9px; height:9px; background:#0d9488;"/> Overseas &#160;
                        <span style="display:inline-block; width:9px; height:9px; background:#9ca3af;"/> Not specified
                    </div>

                    <table style="width: 100%; border-collapse: separate; border-spacing: 12px 0; margin: 0 -12px 14px -12px;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Sales Value by Year</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><t t-foreach="year_rows" t-as="y"><tr><td style="padding: 3px 8px; width: 22%; white-space: nowrap;" t-out="y['label']"/><td style="padding: 3px 8px;"><div style="background:#eef2f7; height:9px; border-radius:2px; white-space:nowrap; font-size:0;"><span t-att-style="'display:inline-block; height:9px; background:#0f2a4a; width:{:.1f}%;'.format(y['domestic_bar'])"/><span t-att-style="'display:inline-block; height:9px; background:#0d9488; width:{:.1f}%;'.format(y['overseas_bar'])"/><span t-att-style="'display:inline-block; height:9px; background:#9ca3af; width:{:.1f}%;'.format(y['unspecified_bar'])"/></div></td><td style="padding: 3px 8px; text-align: right; width: 30%; white-space: nowrap;" t-out="y['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></t></table>
                            </td>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Sales by Month (last 12 months)</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><t t-foreach="month_rows" t-as="m"><tr><td style="padding: 3px 8px; width: 20%; white-space: nowrap;" t-out="m['label']"/><td style="padding: 3px 8px;"><div style="background:#eef2f7; height:9px; border-radius:2px; white-space:nowrap; font-size:0;"><span t-att-style="'display:inline-block; height:9px; background:#0f2a4a; width:{:.1f}%;'.format(m['domestic_bar'])"/><span t-att-style="'display:inline-block; height:9px; background:#0d9488; width:{:.1f}%;'.format(m['overseas_bar'])"/><span t-att-style="'display:inline-block; height:9px; background:#9ca3af; width:{:.1f}%;'.format(m['unspecified_bar'])"/></div></td><td style="padding: 3px 8px; text-align: right; width: 14%; white-space: nowrap;"><t t-out="m['contracts']"/> ct.</td><td style="padding: 3px 8px; text-align: right; width: 26%; white-space: nowrap;" t-out="m['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></t></table>
                                <div t-if="earlier['contracts']" style="font-size: 9pt; color: #6b7280; padding: 3px 8px;">
                                    Earlier: <t t-out="earlier['contracts']"/> contracts, <span t-out="earlier['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="page-break-inside: avoid; margin-bottom: 14px;">
                        <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Sales vs Collections by Year</div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Sold in</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Sales Value</th><th style="padding: 5px 8px; text-align: right;">Collected</th><th style="padding: 5px 8px; text-align: right;">Collected %</th><th style="padding: 5px 8px; text-align: right;">Still to Collect</th></tr></thead><tbody><t t-foreach="year_rows" t-as="y"><tr t-att-style="'background: #f6f8fb;' if y_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold;" t-out="y['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; color: #047857; font-weight: bold;" t-out="y['collected']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="'{:,.1f}%'.format(y['collected_pct'])"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="y['remaining']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></t><tr style="font-weight: bold; background: #eef2f7;"><td style="padding: 6px 8px;">Total</td><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="total['contracts']"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="total['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="total['collected']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="'{:,.1f}%'.format(total['collected_pct'])"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="total['remaining']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></tbody></table>
                        <div style="font-size: 8pt; color: #6b7280; margin-top: 3px;">
                            Collected follows the Collections Report rules (installments marked Paid count as collected). Sold contracts without an installment schedule count as 0 collected.
                        </div>
                    </div>

                    <table style="width: 100%; border-collapse: separate; border-spacing: 12px 0; margin: 0 -12px 14px -12px; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Inventory and Sell-through</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 8.5pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Category</th><th style="padding: 5px 8px; text-align: right;">Units</th><th style="padding: 5px 8px; text-align: right;">Sold</th><th style="padding: 5px 8px; text-align: right;">Sell-through</th><th style="padding: 5px 8px; text-align: right;">Reserved</th><th style="padding: 5px 8px; text-align: right;">Available</th><th style="padding: 5px 8px; text-align: right;">Unsold List Value</th></tr></thead><tbody><t t-foreach="inventory_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['total']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['sold']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="'{:,.1f}%'.format(r['sell_through'])"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['reserved']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['available']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['open_value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></t><tr style="font-weight: bold; background: #eef2f7;"><td style="padding: 6px 8px;">Total</td><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="inventory_total['total']"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="inventory_total['sold']"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="'{:,.1f}%'.format(inventory_total['sell_through'])"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="inventory_total['reserved']"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="inventory_total['available']"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="inventory_total['open_value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></tbody></table>
                                <div style="font-size: 8pt; color: #6b7280; margin-top: 3px;">Sold = units with a counted contract. Unsold List Value = unit list price of reserved + available units (units with no price count as 0).</div>
                            </td>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Sales Channel</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 8.5pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Channel</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Share</th><t t-foreach="channel_years" t-as="cy"><th style="padding: 5px 8px; text-align: right;" t-out="cy"/></t></tr></thead><tbody><t t-foreach="channel_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(r['share'])"/><t t-foreach="r['year_counts']" t-as="n"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; color: #6b7280;" t-out="n"/></t></tr></t></tbody></table>
                                <div style="font-size: 8pt; color: #6b7280; margin-top: 3px;">Columns on the right = contracts per issue year.</div>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: separate; border-spacing: 12px 0; margin: 0 -12px 14px -12px; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Cancelled and Terminated Contracts</div>
                                <t t-if="lost_rows"><table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Year</th><th style="padding: 5px 8px; text-align: right;">Cancelled</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Terminated</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Total Lost</th></tr></thead><tbody><t t-foreach="lost_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold;" t-out="r['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['cancelled'][0]"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['cancelled'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['terminated'][0]"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['terminated'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></t><tr style="font-weight: bold; background: #eef2f7;"><td style="padding: 6px 8px;">Total</td><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="lost_total['cancelled'][0]"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="lost_total['cancelled'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="lost_total['terminated'][0]"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="lost_total['terminated'][1]" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 6px 8px; text-align: right; font-weight: bold;" t-out="lost_value" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></tbody></table></t>
                                <div t-else="" style="background: #e8f7ee; color: #047857; border-radius: 4px; padding: 8px 12px; font-size: 9.5pt;">
                                    No cancelled or terminated contracts, so no sales lost.
                                </div>
                            </td>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">Discount</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><tbody><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">List price of all sold contracts</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="discount['list_total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">Contracts sold below list price</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="discount['discount_n']"/></tr><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">Total discount given</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="discount['discount_value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">Discount as % of list price</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="'{:,.2f}%'.format(discount['discount_pct'])"/></tr><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">Contracts sold above list price</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="discount['premium_n']"/></tr><tr><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;">Extra value above list price</td><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold; color: #047857;" t-out="discount['premium_value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr></tbody></table>
                                <div style="font-size: 8pt; color: #6b7280; margin-top: 3px;">List price = unit price on the contract; discount = list price minus price after discount.</div>
                            </td>
                        </tr>
                    </table>

                    <table style="width: 100%; border-collapse: separate; border-spacing: 12px 0; margin: 0 -12px 14px -12px; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">By Unit Category</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Category</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Avg. Price / m&#178;</th><th style="padding: 5px 8px; text-align: right;">Share</th></tr></thead><tbody><t t-foreach="type_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['per_sqm']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(r['share'])"/></tr></t></tbody></table>
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin: 12px 0 6px;">By Contract Status</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Status</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Share</th></tr></thead><tbody><t t-foreach="state_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['label']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(r['share'])"/></tr></t></tbody></table>
                            </td>
                            <td style="width: 50%; vertical-align: top;">
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin-bottom: 6px;">By Building</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Building</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Share</th></tr></thead><tbody><t t-foreach="top_buildings" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['name']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(r['share'])"/></tr></t></tbody></table>
                                <div style="font-size: 8pt; color: #6b7280; margin-top: 3px;" t-if="building_count &gt; 10">Top 10 of <t t-out="building_count"/> groups.</div>
                                <div style="font-size: 12pt; font-weight: bold; color: #0f2a4a; margin: 12px 0 6px;">Top Clients by Purchases</div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;"><thead><tr style="background: #0f2a4a; color: #fff;"><th style="padding: 5px 8px; text-align: left;">Client</th><th style="padding: 5px 8px; text-align: right;">Contracts</th><th style="padding: 5px 8px; text-align: right;">Value</th><th style="padding: 5px 8px; text-align: right;">Share</th></tr></thead><tbody><t t-foreach="client_rows" t-as="r"><tr t-att-style="'background: #f6f8fb;' if r_index % 2 else ''"><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb;" t-out="r['name']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="r['contracts']"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right; font-weight: bold;" t-out="r['value']" t-options="{'widget': 'monetary', 'display_currency': currency}"/><td style="padding: 4px 8px; border-bottom: 1px solid #e5e7eb; text-align: right;" t-out="'{:,.1f}%'.format(r['share'])"/></tr></t></tbody></table>
                            </td>
                        </tr>
                    </table>

                    <t t-if="no_date_count or unspecified_count or no_schedule_count or inventory_total['other'] or inventory_total['no_price']">
                        <div style="font-size: 8.5pt; color: #92400e; background: #fff7e6; padding: 5px 10px; border-radius: 3px; margin-bottom: 8px;">
                            Data check:
                            <t t-if="no_date_count"><t t-out="no_date_count"/> contracts have no issue date (shown as "No issue date"). </t>
                            <t t-if="unspecified_count"><t t-out="unspecified_count"/> contracts have no Domestic/Overseas type (shown as "Not specified"). </t>
                            <t t-if="no_schedule_count"><t t-out="no_schedule_count"/> contracts have no installment schedule (0 collected). </t>
                            <t t-if="inventory_total['other']"><t t-out="inventory_total['other']"/> units are neither sold, reserved nor available (for example marked Sold without a contract). </t>
                            <t t-if="inventory_total['no_price']"><t t-out="inventory_total['no_price']"/> unsold units have no list price, so Unsold List Value is understated.</t>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
