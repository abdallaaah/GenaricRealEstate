    <menuitem id="menu_units_config_installment_template" name="Installment Templates"
              parent="menu_units_config"
              action="action_installment_template_form_act_window" sequence="180"/>
    <menuitem id="menu_units_config_maintenance_template" name="Maintenance Templates"
              parent="menu_units_config"
              action="action_maintenance_template_form_act_window" sequence="190"/>
    <menuitem id="menu_units_config_developer_project" name="Developer Projects"
              parent="menu_units_config"
              action="action_developer_project" sequence="200"/>
    <menuitem id="menu_units_config_neighborhood" name="Neighborhoods" parent="menu_units_config"
              action="neighborhood_neighborhood_action" sequence="210"/>
    <menuitem id="menu_units_config_city" name="Districts" parent="menu_units_config"
              action="action_couuntry_city" sequence="220"/>
</odoo>
