<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <!-- Inherit Form View to Modify it -->
       <record id="product_product_inherit_form" model="ir.ui.view">
           <field name="name">product_inherit_form</field>
           <field name="model">product.product</field>
           <field name="inherit_id" ref="product.product_normal_form_view"/>
           <field name="arch" type="xml">

               <xpath expr="//field[@name='barcode']" position="after">
                   <field name="insurance_exclude_tax"/>
                   <field name="ipc_type"/>
               </xpath>

               <xpath expr="//field[@name='property_account_expense_id']" position="after">
                        <field name="is_social_insurance"/>
                        <field name="is_engineering_fee"/>
                </xpath>

           </field>
       </record>

        <record id="product_template_inherit_form_view" model="ir.ui.view">
           <field name="name">product_template_inherit_form</field>
           <field name="model">product.template</field>
           <field name="inherit_id" ref="product.product_template_only_form_view"/>
           <field name="arch" type="xml">

               <xpath expr="//field[@name='barcode']" position="after">
                   <field name="insurance_exclude_tax"/>
                   <field name="ipc_type"/>
                   <field name="deduction"/>
               </xpath>

               <xpath expr="//field[@name='property_account_expense_id']" position="after">

                        <field name="is_social_insurance"/>
                        <field name="is_engineering_fee"/>

                </xpath>

           </field>
       </record>

    </data>
</odoo>