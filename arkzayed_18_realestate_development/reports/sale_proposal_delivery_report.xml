<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_proposal_delivery_report_list" model="ir.ui.view">
        <field name="name">sale.proposal.delivery.report.list</field>
        <field name="model">sale.proposal.delivery.report</field>
        <field name="arch" type="xml">
            <list string="Unit Delivery Report" create="false" edit="false" delete="false"
                  default_order="delivery_date asc">
                <field name="name" string="Contract Reference"/>
                <field name="customer_id" string="Customer Name"/>
                <field name="unit_number" string="Unit Number"/>
                <field name="delivery_date" string="Delivery Date"/>
                <field name="remaining_days" string="Remaining Days"
                       decoration-danger="remaining_days &lt; 0"
                       decoration-warning="remaining_days &gt;= 0 and remaining_days &lt;= 30"/>
                <field name="state" string="Contract Stage" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sale_proposal_delivery_report_search" model="ir.ui.view">
        <field name="name">sale.proposal.delivery.report.search</field>
        <field name="model">sale.proposal.delivery.report</field>
        <field name="arch" type="xml">
            <search string="Unit Delivery Report">
                <field name="name" string="Contract Reference"/>
                <field name="customer_id" string="Customer Name"/>
                <field name="unit_number" string="Unit Number"/>

                <filter string="Overdue" name="filter_overdue"
                        domain="[('remaining_days_range', '=', 'overdue')]"/>
                <filter string="Due in 0-30 Days" name="filter_0_30"
                        domain="[('remaining_days_range', '=', '0_30')]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_by_customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter string="Days Left (30-Day Range)" name="group_by_range"
                            context="{'group_by': 'remaining_days_range'}"/>
                    <filter string="Delivery Date" name="group_by_delivery_date"
                            context="{'group_by': 'delivery_date'}"/>
                    <filter string="Contract Stage" name="group_by_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_proposal_delivery_report" model="ir.actions.act_window">
        <field name="name">Unit Delivery Report</field>
        <field name="res_model">sale.proposal.delivery.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sale_proposal_delivery_report_search"/>
        <field name="context">{'search_default_group_by_range': 1}</field>
    </record>

    <menuitem id="menu_sale_proposal_delivery_report"
              name="Unit Delivery Report"
              action="action_sale_proposal_delivery_report"
              parent="menu_reports_root"
              sequence="14"/>

</odoo>