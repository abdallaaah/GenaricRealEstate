<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wip_report_list" model="ir.ui.view">
        <field name="name">wip.report.list</field>
        <field name="model">wip.report</field>
        <field name="arch" type="xml">
            <list string="WIP Report" create="0" edit="0" delete="0">
                <field name="vendor_id"/>
                <field name="scope_id"/>
                <field name="type_id"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wip_report_search" model="ir.ui.view">
        <field name="name">wip.report.search</field>
        <field name="model">wip.report</field>
        <field name="arch" type="xml">
            <search string="WIP Report">
                <field name="vendor_id"/>
                <field name="scope_id"/>
                <field name="type_id"/>
                <group string="Group By">
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wip_report" model="ir.actions.act_window">
        <field name="name">WIP Report</field>
        <field name="res_model">wip.report</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_wip_report_search"/>
    </record>

    <menuitem id="menu_wip_report"
              name="WIP Report"
              parent="account.menu_finance_reports"
              action="action_wip_report"
              sequence="100"/>
</odoo>