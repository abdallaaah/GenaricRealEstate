<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <record id="attachment_type_view_form" model="ir.ui.view">
           <field name="name">attachment_type_view_form</field>
           <field name="model">attachment.type</field>
           <field name="arch" type="xml">
               <form string="attachment_type_form">
                   <sheet>
                       <group>
                           <field name="name"/>
                       </group>
                   </sheet>
               </form>
           </field>
       </record>

        <record id="attachment_type_view_action" model="ir.actions.act_window">
            <field name="name">Attachment Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">attachment.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="attachment_type_menu" name="Attachment Type" parent="hr.menu_human_resources_configuration" action="attachment_type_view_action"/>

    </data>
</odoo>
