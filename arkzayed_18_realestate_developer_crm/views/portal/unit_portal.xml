<odoo>
    <data>

        <template id="arkzayed_18_realestate_developer_crm.portal_my_units" name="Portal Units">
            <t t-call="portal.portal_layout">
                <div class="container">
                    <ul class="nav nav-tabs mb-4" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#general" role="tab">
                                General
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#basic_info" role="tab">Basic Info</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#unit_price" role="tab">Unit Price</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#utilities" role="tab">Utilities</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#financials" role="tab">Financials</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#counters" role="tab">Counters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#warnings" role="tab">Warnings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#location" role="tab">Location</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#seller" role="tab">Seller Details</a>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content">
                        <!-- General Tab -->
                        <div class="tab-pane fade show active" id="general" role="tabpanel">
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Unit Name:</span>
                                            <t t-esc="unit.name"/>
                                        </div>
<!--                                        <div class="card-body">-->
<!--                                            <span class="fw-bold">Abbreviation:</span>-->
<!--                                            <t t-esc="unit.abbreviation"/>-->
<!--                                        </div>-->
                                        <div class="card-body">
                                            <span class="fw-bold">Unit Number:</span>
                                            <t t-esc="unit.unit_number"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Unit Code:</span>
                                            <t t-esc="unit.unit_code"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Unit Type:</span>
                                            <t t-esc="dict(request.env['broker.unit'].fields_get('unit_type')['unit_type']['selection'])[unit.unit_type]"/>
                                        </div>
                                        <div class="card-body">
                                            <t t-if="unit.unit_type == 'retail'">
                                                <span class="fw-bold">Retail Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('retail_type')['retail_type']['selection'])[unit.retail_type]"/>
                                            </t>
                                            <t t-if="unit.unit_type == 'office'">
                                                <span class="fw-bold">Office Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('office_type')['office_type']['selection'])[unit.office_type]"/>

                                            </t>
                                            <t t-if="unit.unit_type == 'residential'">
                                                <span class="fw-bold">Residential Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('residential_type')['residential_type']['selection'])[unit.residential_type]"/>
                                                <br/>
                                                <br/>
                                                <span class="fw-bold">Multiple Floors:</span>
                                                <t t-if="unit.is_floors == True">
                                                    <span class="text-success fw-bold">Yes</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-danger fw-bold">No</span>
                                                </t>
                                            </t>
                                            <t t-if="unit.unit_type == 'entertainment'">
                                                <span class="fw-bold">Entertainment Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('entertainment_type')['entertainment_type']['selection'])[unit.entertainment_type]"/>

                                            </t>
                                            <t t-if="unit.unit_type == 'industrial'">
                                                <span class="fw-bold">Industrial Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('industrial_type')['industrial_type']['selection'])[unit.industrial_type]"/>

                                            </t>
                                            <t t-if="unit.unit_type == 'parking'">
                                                <span class="fw-bold">Parking Type:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('parking_type')['parking_type']['selection'])[unit.parking_type]"/>
                                            </t>
                                            <t t-if="unit.unit_type == 'public_area'">
                                                <span class="fw-bold">Public Area:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('public_area')['public_area']['selection'])[unit.public_area]"/>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Project:</span>
                                            <t t-esc="unit.project_id.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Developer:</span>
                                            <t t-esc="unit.developer_id.name"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Unit Status:</span>
                                            <t t-esc="dict(request.env['broker.unit'].fields_get('unit_status')['unit_status']['selection'])[unit.unit_status]"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Sale Phase:</span>
                                            <t t-esc="unit.sale_phase.name"/>
                                        </div>
                                        <t t-if="unit.unit_purpose">
                                            <div class="card-body">
                                                <span class="fw-bold">Unit Purpose:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('unit_purpose')['unit_purpose']['selection'])[unit.unit_purpose]"/>
                                            </div>
                                        </t>
                                        <div class="card-body">
                                            <span class="fw-bold">Ready To Move:</span>
                                            <t t-if="unit.ready_to_move == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Is Published:</span>
                                            <t t-if="unit.is_published == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Add similar structure for other tabs -->
                        <div class="tab-pane fade" id="basic_info" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Indoor Gross Area:</span>
                                            <t t-esc="unit.indoor_gross_area"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Indoor Net Area:</span>
                                            <t t-esc="unit.indoor_net_area"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Outdoor Gross Area:</span>
                                            <t t-esc="unit.outdoor_gross_area"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Outdoor Net Area:</span>
                                            <t t-esc="unit.outdoor_net_area"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Net Total Area:</span>
                                            <t t-esc="unit.net_area"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Gross Total Area:</span>
                                            <t t-esc="unit.unit_area"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="unit_price" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Rent Price:</span>
                                            <t t-esc="unit.rent_price"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Rent Maintenance Price:</span>
                                            <t t-esc="unit.rent_maintenance_price"/>
                                        </div>
                                        <t t-if="unit.rent_period">
                                            <div class="card-body">
                                                <span class="fw-bold">Rent Period:</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('rent_period')['rent_period']['selection'])[unit.rent_period]"/>
                                            </div>
                                        </t>
                                        <t t-if="unit.maintenance_period">
                                            <div class="card-body">
                                                <span class="fw-bold">Maintenance Period</span>
                                                <t t-esc="dict(request.env['broker.unit'].fields_get('maintenance_period')['maintenance_period']['selection'])[unit.maintenance_period]"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="utilities" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Heating Source:</span>
                                            <t t-esc="unit.heating_source"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Solar System:</span>
                                            <t t-if="unit.solar_system == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Electricity Meter:</span>
                                            <t t-if="unit.electricity_meter == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Gas Meter:</span>
                                            <t t-if="unit.gas_meter == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Water Meter:</span>
                                            <t t-if="unit.water_meter == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Landline:</span>
                                            <t t-if="unit.landline == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Internet:</span>
                                            <t t-if="unit.internet == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Air Condition:</span>
                                            <t t-if="unit.air_condition == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Cooling Water:</span>
                                            <t t-if="unit.cooling_water == True">
                                                <span class="text-success fw-bold">Yes</span>
                                            </t>
                                            <t t-else="">
                                                <span class="text-danger fw-bold">No</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="financials" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Indoor Price/Month/SQM:</span>
                                            <t t-esc="unit.indoor_price_per_month_sqm"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Outdoor Price/Month/SQM:</span>
                                            <t t-esc="unit.outdoor_price_per_month_sqm"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Indoor+Outdoor Price/Month/SQM:</span>
                                            <t t-esc="unit.indoor_outdoor_price_per_month_sqm"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Service Charge / SQM?:</span>
                                            <t t-esc="unit.service_charge_per_sqm"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Marketing Fees Annually Percent:</span>
                                            <t t-esc="unit.marketing_fees_annually_percent"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Payment Terms Duration:</span>
                                            <t t-esc="unit.payment_terms_duration"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="counters" role="tabpanel">
                            <div class="row">
                                <!-- Add a card to group the on2many field -->
                                <div class="card shadow-lg border-0">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">Counters</h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Loop through the on2many field -->
                                        <t t-if="unit.counter_ids">
                                            <t t-foreach="unit.counter_ids" t-as="counter">
                                                <div class="row mb-3 border-bottom pb-2">
                                                    <div class="col-md-4">
                                                        <span class="fw-bold">Counter Serial No:</span>
                                                        <t t-esc="counter.serial_no"/>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <span class="fw-bold">Counter Type:</span>
                                                        <t t-esc="counter.Type"/>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <span class="fw-bold">Meter Type:</span>
                                                        <t t-esc="counter.meter_type"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <!-- If no counters are available -->
                                            <div class="text-muted">No counters available.</div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="warnings" role="tabpanel">
                            <div class="row">
                                <div class="card shadow-lg border-0">
                                    <div class="card-body">
                                        <span class="fw-bold">Warnings:</span>
                                        <t t-esc="unit.warning_msg"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="location" role="tabpanel">
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6 mb-4">
                                    <span class="fw-bold">Google Maps Location</span>
                                    <br/>
                                    <br/>
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Location:</span>
                                            <a t-att-href="unit.location_url" t-esc="unit.location_url" target="_blank"
                                               class="text-primary"></a>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Latitude:</span>
                                            <t t-esc="unit.latitude"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Longitude:</span>
                                            <t t-esc="unit.longitude"/>
                                        </div>
                                    </div>
                                </div>
                                <!-- Right Column -->
                                <div class="col-md-6 mb-4">
                                    <span class="fw-bold">Location</span>
                                    <br/>
                                    <br/>
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Country:</span>
                                            <t t-esc="unit.country_id.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Governorate:</span>
                                            <t t-esc="unit.governorate_id.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">City:</span>
                                            <t t-esc="unit.city_id.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Neighborhood:</span>
                                            <t t-esc="unit.neighborhood_id.name"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="seller" role="tabpanel">
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Sales Person:</span>
                                            <t t-esc="unit.seller_sales_person.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Mobile:</span>
                                            <t t-esc="unit.seller_sales_person_phone"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Team Leader:</span>
                                            <t t-esc="unit.seller_team_leader.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Sales Manager:</span>
                                            <t t-esc="unit.seller_sales_manager.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Sales Director:</span>
                                            <t t-esc="unit.seller_sales_director.name"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-lg border-0">
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Purpose Sale Price:</span>
                                            <t t-esc="unit.seller_purpose_sale_price"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">Seller Purpose Rent Price:</span>
                                            <t t-esc="unit.seller_purpose_rent_price"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">seller client name:</span>
                                            <t t-esc="unit.seller_client_id.name"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">seller client Phone:</span>
                                            <t t-esc="unit.seller_client_phone"/>
                                        </div>
                                        <div class="card-body">
                                            <span class="fw-bold">seller client Extra Phone:</span>
                                            <t t-esc="unit.seller_client_extra_phone"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </template>
        <template id="portal_my_home_units" name="Show Units" inherit_id="portal.portal_my_home"
                  customize_show="True">
            <xpath expr="//div[hasclass('o_portal_docs')]/div[hasclass('o_portal_category')]" position="before">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/arkzayed_18_realestate_developer_crm/static/src/img/unittt.svg'"/>
                    <t t-set="title">Units</t>
                    <t t-set="url" t-value="'/my/units'"/>
                    <t t-set="text">Units</t>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'units_count'"/>
                </t>
            </xpath>
        </template>

         <template id="portal_my_units_menu" name="Portal My Units Menu" inherit_id="website.template_header_default">
            <xpath expr="//t[@t-foreach='website.menu_id.child_id']" position="after">
                <li class="nav-item">
                    <a class="nav-link" href="/my/units">Units</a>
                </li>
            </xpath>
        </template>

        <template id="portal_units_breadcrumbs" inherit_id="portal.portal_breadcrumbs">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'unit_list_view'" class="breadcrumb-item">Units</li>
            </xpath>
        </template>
        <template id="unit_list_view" name="Units">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Units</t>
                    <div class="mb-3">
                        <a href="/my/unit/create" class="btn btn-primary">
                            Create Unit
                        </a>
                    </div>
                </t>
                <div t-if="not units" class="alert alert-warning" role="alert">
                    There are no Units.
                </div>
                <t t-if="units" t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
<!--                            <th>Abbreviation</th>-->
                            <th>Unit ID</th>
<!--                            <th>Unit Code</th>-->
                            <th>Sale Phase</th>
                            <th>Unit Purpose</th>
                            <th>Unit Status</th>
                            <th>Unit Type</th>
                            <th>Sale Price/Meter</th>
                            <th>Rent Price/Meter</th>
                            <th>Maintenance Price/Meter</th>
                            <th>Maintenance Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="units" t-as="u">
                            <td>
                                <span t-field="u.create_date" t-options='{"widget": "date"}'/>
                            </td>
                            <td class="text-wrap">
                                <a t-attf-href="/my/units//#{u.id}">
                                    <span t-field="u.name"/>
                                </a>
                            </td>
<!--                            <td>-->
<!--                                <span t-field="u.abbreviation"/>-->
<!--                            </td>-->
                            <td>
                                <span t-field="u.unit_number"/>
                            </td>
<!--                            <td>-->
<!--                                <span t-field="u.unit_code"/>-->
<!--                            </td>-->
                            <td>
                                <span t-field="u.sale_phase.name"/>
                            </td>
                            <td>
                                <span t-field="u.unit_purpose"/>
                            </td>
<!--                            <td>-->
<!--                                <span t-field="u.unit_status"/>-->
<!--                            </td>-->
                            <td>
                                <span t-field="u.unit_type"/>
                            </td>
                            <td>
                                <span t-field="u.sale_price_per_meter"/>
                            </td>
                            <td>
                                <span t-field="u.rent_price_per_meter"/>
                            </td>
                            <td>
                                <span t-field="u.maintenance_price_per_meter"/>
                            </td>
                            <td>
                                <span t-field="u.maintenance_percentage"/>
                            </td>
                        </tr>
