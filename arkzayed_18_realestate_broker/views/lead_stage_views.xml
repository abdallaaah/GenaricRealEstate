<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="lead_stage_search" model="ir.ui.view">
            <field name="name">Lead Stage - Search</field>
            <field name="model">lead.stage</field>
            <field name="arch" type="xml">
                <search string="Lead Stage Search">
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="is_won"/>
                    <field name="first"/>
                    <field name="call_later"/>
                    <field name="no_answer"/>
                    <field name="qualified"/>
                    <field name="unqualified"/>
                    <field name="locked"/>
                    <field name="follow_up"/>
                    <field name="qualified_limited_budget"/>
                    <field name="team_id"/>
                </search>
            </field>
        </record>
        <record id="lead_stage_tree" model="ir.ui.view">
            <field name="name">lead.stage.list</field>
            <field name="model">lead.stage</field>
            <field name="arch" type="xml">
                <list string="Lead Stages" multi_edit="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name" readonly="1"/>
                    <field name="is_won"/>
                    <field name="first"/>
                    <field name="call_later"/>
                    <field name="no_answer"/>
                    <field name="qualified"/>
                    <field name="unqualified"/>
                    <field name="locked"/>
                    <field name="follow_up"/>
                    <field name="qualified_limited_budget"/>
                    <field name="team_id"/>
                </list>
            </field>
        </record>
        <record id="crm_stage_form" model="ir.ui.view">
            <field name="name">lead.stage.form</field>
            <field name="model">lead.stage</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <form string="Lead Stage">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Negotiation"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_won"/>
                                <field name="first"/>
                                <field name="call_later"/>
                                <field name="no_answer"/>
                                <field name="qualified"/>
                                <field name="unqualified"/>
                                <field name="locked"/>
                                <field name="follow_up"/>
                                <field name="qualified_limited_budget"/>
                                <field name="fold"/>
                                <field name="team_id" options='{"no_open": True, "no_create": True}'
                                       invisible="team_count &lt;= 1"
                                       context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"/>
                            </group>
                            <field name="team_count" invisible="1"/>
                        </group>
                        <separator string="Requirements"/>
                        <field name="requirements" nolabel="1"
                               placeholder="Give your team the requirements to move an opportunity to this stage."/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="lead_stage_action" model="ir.actions.act_window">
            <field name="name">Lead Stages</field>
            <field name="res_model">lead.stage</field>
            <field name="view_id" ref="lead_stage_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Set a new stage in your lead pipeline
                </p>
                <p>
                    Stages allow salespersons to easily track how a specific opportunity
                    is positioned in the sales cycle.
                </p>
            </field>
        </record>
        <menuitem
                id="menu_lead_stage"
                name="Lead Stages"
                sequence="1"
                parent="crm.menu_crm_config_lead"
                action="lead_stage_action"
                groups="base.group_no_one"/>
    </data>
</odoo>