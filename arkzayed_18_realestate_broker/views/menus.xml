<odoo>
    <data>

        <record model="ir.actions.act_window" id="crm.crm_lead_action_pipeline">
            <field name="name">Pipeline</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">list,kanban,graph,pivot,form,calendar,activity</field>
            <field name="domain">[('type','=','opportunity')]</field>
            <field name="context">
                {
                'default_type': 'opportunity',
                'search_default_assigned_to_me': 1
                }
            </field>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list'})]"/>
            <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
        </record>


        <menuitem id="new_menu_crm_opportunities" name="Opportunities" parent="crm.crm_menu_root" sequence="1"/>
        <!-- New Menu for Converted Opportunities -->
        <menuitem id="menu_crm_converted_opportunities" name="Converted Leads" parent="new_menu_crm_opportunities"
                  action="action_converted_opportunities" sequence="2"/>
        <!-- New Menu for Opportunities -->
        <menuitem id="crm.menu_crm_opportunities" name="Opportunities" parent="new_menu_crm_opportunities"
                  action="crm.action_your_pipeline" sequence="1"/>

        <menuitem id="menu_broker_root" name="Units Inventory"
                  web_icon="isky_realestate_development,static/description/broker.png"/>
        <menuitem id="inventory_main_menu" name="Inventory" parent="menu_broker_root"/>
        <menuitem id="developer_main_menu" name="Developer" parent="menu_broker_root"/>
        <menuitem id="conf_main_menu" name="Configuration" parent="menu_broker_root"/>
        <menuitem id="project_commission_menu" name="Project Commission" parent="conf_main_menu"
            action="project_commission_action"/>
        <menuitem id="project_sale_phase" name="Project Sale Phase" parent="conf_main_menu"
                  action="action_project_sale_phase"/>
        <menuitem id="neighborhood_menu" name="Neighborhood" parent="conf_main_menu"
                  action="action_neighborhood_project"/>

        <menuitem id="primary_inventory_menu" name="Primary Inventory" action="action_broker_primary_unit"
                  parent="inventory_main_menu"/>
        <menuitem id="resale_inventory_menu" name="Resale Inventory" action="action_broker_resale_unit"
                  parent="inventory_main_menu"/>
        <menuitem id="projects_menu" name="Projects" action="action_developer_project" parent="developer_main_menu"/>

        <record id="crm.res_partner_menu_customer" model="ir.ui.menu">
            <field name="groups_id" eval="[(5,0),(4, ref('arkzayed_18_realestate_broker.operation_manager_group')),(4, ref('arkzayed_18_realestate_broker.lead_admin_group'))]"/>
<!--                                           (4, ref('arkzayed_18_realestate_broker.operation_executive_group')),-->

        </record>
        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="groups_id" eval="[(5,0),(4, ref('arkzayed_18_realestate_broker.lead_admin_group')),
                                           (4, ref('arkzayed_18_realestate_broker.operation_manager_group')),(4, ref('base.group_partner_manager'))]"/>
<!--                                           (4, ref('arkzayed_18_realestate_broker.operation_executive_group')),-->

        </record>
    </data>
</odoo>