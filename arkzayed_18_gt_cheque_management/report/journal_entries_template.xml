<odoo>
    <data>
        <template id="account_cash_in_out_template" t-name="arkzayed_18_gt_cheque_management.account_cash_in_out_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.basic_layout">
                        <style>
                            body {
                                font-family: 'DejaVu Sans', sans-serif;
                                -webkit-print-color-adjust: exact;
                            }
                            table {
                                border-collapse: collapse;
                            }
                        </style>
                        <!-- Added explicit width and removed problematic borders -->
                        <div class="page" style="width: 100%; border: 1px solid #000; padding: 10px;">

                            <header>
                                <h5 style="text-decoration: underline; text-align: center; color: red;">
                                    شركة ابراج للتطوير العمرانى
                                </h5>

                                <!-- Fixed image alignment -->
                                <div style="display: table; width: 100%;">
                                    <div style="display: table-row;">
                                        <div style="display: table-cell; width: 33%;">
                                            <img t-att-src="'/arkzayed_18_gt_cheque_management/static/src/newCairo_logo.jpg'"
                                                 alt="Company Branch"
                                                 style="width: 150px; display: block;"/>
                                        </div>
                                        <div style="display: table-cell; width: 33%; text-align: center;">
                                            <!-- Spacer -->
                                        </div>
                                        <div style="display: table-cell; width: 33%; text-align: right;">
                                            <img t-att-src="'/arkzayed_18_gt_cheque_management/static/src/abraj_logo.jpg'"
                                                 alt="Company Logo"
                                                 style="width: 150px; display: block; margin-left: auto;"/>
                                        </div>
                                    </div>
                                </div>
                            </header>

                            <!-- Receipt type header -->
                            <h5 style="text-align: center; text-decoration: underline; color: red; margin: 15px 0;">
                                <t t-if="doc.is_receipt()">
                                    إيصال استلام خزينة<span style="unicode-bidi: embed; direction: ltr;">(نقدى /شيكات/ فيزا)-</span>
                                </t>
                                <t t-if="not doc.is_receipt()">
                                    إيصال صرف خزينة<span style="unicode-bidi: embed; direction: ltr;">(نقدى)-</span>
                                </t>
                            </h5>

                            <!-- Amount section - converted to table layout -->
                            <div style="width: 100%; overflow: hidden; margin-bottom: 15px;">
                               <div style="float: right; width: 70%; text-align: right; padding-top: 15px;" dir="rtl">
                                    <span style="font-weight: bold;">رقم الايصال: </span>
                                    <span style="font-weight: bold;" dir="ltr">(
                                        <span t-esc="doc.name[-5:]"/>)
                                    </span>
                                </div>

                                <div style="float: left; width: 30%;">
                                    <table style="border: 1px solid #000; width: 100%; text-align: center;">
                                        <thead>
                                            <tr style="background-color: #f0f0f0;">
                                                <th style="border: 1px solid #000; padding: 5px;">المبلغ</th>
                                                <th style="border: 1px solid #000; padding: 5px;">العمله</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="border: 1px solid #000; text-align: center; padding: 5px;">
                                                    <t t-esc="doc.calculate_total_amount()"/>
                                                </td>
                                                <td style="border: 1px solid #000; text-align: center; padding: 5px;">
                                                    <t t-esc="doc.get_currency_name()"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>


                            </div>

                            <!-- Recipient section -->
                            <div style="clear: both; width: 100%; text-align: right; margin: 15px 0;" dir="rtl">
                                <span style="font-weight: bold;">
                                    <t t-if="doc.is_receipt()">
                                        إستلمت المبلغ اعلاه من السيد
                                    </t>
                                    <t t-if="not doc.is_receipt()">
                                        وصلنى انا الموقع على هذا
                                    </t>
                                </span>

                                <span style="font-weight: bold; direction: ltr;">
                                    <t t-if="doc.line_ids">
                                        <t t-foreach="doc.line_ids" t-as="line">
                                            <t t-if="line.account_id.account_type == 'asset_cash'">
                                                / <span t-esc="line.partner_id.name"/>
                                            </t>
                                        </t>
                                    </t>
                                </span>
                            </div>


                            <!-- Arabic amount -->
                            <div style="width: 100%; margin: 15px 0; font-size:12px;">
                                <table style="border: 1px solid #000; width: 100%;">
                                    <tr>
                                        <td style="text-align: right; padding: 4px; border: none;">جنيه مصرى فقط لاغير</td>
                                        <td style="text-align: center; padding: 4px; border: none;" t-esc="doc._get_arabic_amount(doc.calculate_total_amount(),'ar')"/>
                                        <td style="text-align: left; padding: 4px; border: none;">/مبلغ وقدره</td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Payment reason -->
                            <div style="width: 100%; text-align: right; margin: 15px 0;" dir="rtl">
                                <span style="font-weight: bold;">
                                    <t t-if="doc.is_receipt()">
                                        وذلك قيمة /
                                    </t>
                                    <t t-if="not doc.is_receipt()">
                                        بيانات الصرف /
                                    </t>
                                </span>

                                <t t-if="doc.line_ids">
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <t t-if="line.account_id.account_type == 'asset_cash'">
                                            <span style="font-weight: bold;" dir="ltr">
                                                <span t-esc="line.name"/>
                                            </span>
                                        </t>
                                    </t>
                                </t>
                            </div>


                            <!-- Receiver section -->
                            <div style="text-align: center; margin: 30px 0;">
                                <div style="margin-bottom: 10px;">
                                    <span style="font-weight: bold; text-decoration: underline; color: red;">المستلم</span>
                                </div>
                                <div style="margin-bottom: 5px;">
                                    <span style="font-weight: bold;">:الإسم</span>
                                </div>
                                <div>
                                    <span style="font-weight: bold;">:التوقيع</span>
                                </div>
                            </div>

                            <!-- Footer sections -->
                            <div style="text-align: right; margin: 10px 0;">
                                <span style="font-weight: bold;">تحريرا فى: </span>
                                <span style="font-weight: bold;" t-esc="time.strftime('%Y-%m-%d')"></span>
                            </div>

                            <div style="text-align: right; margin: 10px 0; font-weight: bold;">
                                هذا الايصال لا يعتد به الا اذا كان معتمدا بختم الشركة و موقع عليه من الموظف المختص
                            </div>

                            <div style="text-align: right; margin: 10px 0;" dir="rtl">
                                <span style="font-weight: bold;">طبع بواسطة: </span>
                                <span style="font-weight: bold;" dir="ltr">
                                    <span t-esc="user.name"/>
                                </span>
                            </div>


                            <div style="text-align: center; margin: 20px 0;">
                                <span>********************</span><br/>
                                <span>نهاية الإيصال</span>
                            </div>

                            <hr style="border: 1px solid #000; margin: 15px 0;"/>

                            <div style="font-size: 12px; text-align: center;">
                                <table width="100%">
                                    <tr>
                                        <td>9&amp;10 B Entertainment District - Fifth Settlement - New Cairo</td>
                                        <td><a href="http://WWW.U-VENUES.COM" target="_blank">WWW.U-VENUES.COM</a></td>
                                        <td>1089 B المنطقة الترفهية - التجمع الخامس - القاهرة الجديدة</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>