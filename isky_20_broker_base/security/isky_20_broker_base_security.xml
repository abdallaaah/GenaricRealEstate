<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_broker" model="ir.module.category">
        <field name="name">iSky Broker</field>
    </record>

    <record id="res_groups_privilege_broker" model="res.groups.privilege">
        <field name="name">Broker</field>
        <field name="category_id" ref="module_category_broker"/>
    </record>

    <record id="group_broker_admin" model="res.groups">
        <field name="name">Broker Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_broker"/>
        <field name="comment">Configures job levels, feature flags, and other broker platform settings.</field>
    </record>
</odoo>
