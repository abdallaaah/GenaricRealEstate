<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="report_initial_reservation_paperformat" model="report.paperformat">
      <field name="name">Initial Reservation Format</field>
      <field name="format">A4</field>
      <field name="orientation">Portrait</field>
      <field name="margin_top">10</field>
      <field name="margin_bottom">10</field>
      <field name="margin_left">10</field>
      <field name="margin_right">10</field>
      <field name="header_line">False</field>
      <field name="header_spacing">20</field>
      <field name="dpi">90</field>
    </record>

    <record id="initial_reservation_report" model="ir.actions.report">
      <field name="name">Initial Reservation Form</field>
      <field name="model">real.estate.sale.reservation</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">arkzayed_18_realestate_development.initial_reservation_form</field>
      <field name="report_file">arkzayed_18_realestate_development.initial_reservation_form</field>
      <field name="print_report_name">"Initial Reservation Form - %s" % (object.customer_id.name)</field>
      <field name="binding_model_id" ref="isky_18_realestate_developer_sales_crm.model_real_estate_sale_reservation"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="arkzayed_18_realestate_development.report_initial_reservation_paperformat"/>
    </record>

    <template id="initial_reservation_form">
      <t t-call="web.html_container">
        <meta charset="utf-8"/>

        <style>
          @page {
            size: A4;
            margin: 8mm 10mm 18mm 10mm;
          }

          html, body{
            width: 100%;
            direction: rtl !important;
            text-align: right !important;
            font-family: 'Cairo', 'Rajawali', 'Almar', sans-serif;
            font-size: 10.5pt;
            line-height: 1.5;
            color: #000;
            margin: 0 !important;
            padding: 0 !important;
          }
          *{ box-sizing: border-box; }

          .sheet{
            width: 100%;
            max-width: 190mm;
            margin: 0 auto !important;
            padding: 4px 0 16mm 0;
            direction: rtl;
            text-align: right;
            position: relative;
          }

          .brand{
            font-size: 22pt;
            font-weight: 700;
            color: #2c3e50;
            text-align: left;
            direction: ltr;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
          }

            .date-row{
              margin-top: 6px;
              margin-bottom: 8px;
              text-align: right;
            }
          .date-row .lbl{
            font-weight: 600;
            font-size: 9.5pt;
            display: inline;
            margin-left: 4px;
          }
          .date-row .fill-inline{
            display: inline-block;
            vertical-align: middle;
            min-width: 100px;
            height: 16px;
            padding: 1px 6px;
            font-size: 9.5pt;
            border-bottom: 1px dotted #666;
          }

          .title{
            text-align: center;
            font-size: 11.5pt;
            font-weight: 700;
            margin: 26px 0 14px 0;
            color: #000;
          }

          .section{
            margin-top: 12px;
            margin-bottom: 10px;
          }
          .section-h{
            font-weight: 700;
            font-size: 10.5pt;
            margin-bottom: 8px;
            padding-bottom: 3px;
            background-color: #f4f6f8;
          }

          .field{
            margin: 5px 0;
            display: flex;
            align-items: flex-start;
          }
          .field .lbl{
            min-width: 140px;
            max-width: 140px;
            font-weight: 600;
            font-size: 10pt;
            padding-top: 2px;
            flex-shrink: 0;
          }

          .field .fill{
            flex: 1;
            min-height: 18px;
            border-bottom: 1px dotted #666;
            padding: 2px 8px;
            font-size: 10pt;
            word-wrap: break-word;
            text-align: right;
            direction: rtl;
          }

          .ltr{
            direction: ltr !important;
            unicode-bidi: bidi-override;
            text-align: left !important;
          }

          .note{
            margin-top: 14px;
            margin-bottom: 12px;
            line-height: 1.7;
            font-size: 10pt;
            text-align: justify;
          }
          .note .fill-inline{
            display: inline-block;
            vertical-align: middle;
            min-width: 120px;
            height: 16px;
            border-bottom: 1px dotted #666;
            padding: 1px 6px;
            margin: 0 4px;
            font-size: 10pt;
          }

          .signature-section{
            margin-top: 14px;
            margin-bottom: 0;
          }
          .footer{
          position: fixed;
          bottom: 8mm;
          left: 0;
          right: 0;
        }

        .nowrap{
            white-space: nowrap;
        }

        .amount-line{
          display: inline-block;
          min-width: 120px;
          text-align: center;
          border-bottom: 1px dotted #000;
          padding: 0 6px 2px 6px;
          direction: rtl;
        }
        </style>

        <t t-foreach="docs" t-as="o">
          <div class="sheet">

            <div class="brand">The Arkzayed</div>

            <div class="date-row">
              <span class="lbl">التاريخ:</span>
              <span class="fill-inline ltr">
                <t t-if="o.reservation_start_date">
                  <t t-esc="o.reservation_start_date.strftime('%d/%m/%Y')"/>
                </t>
                <t t-else="">&#160;</t>
              </span>
            </div>

            <div class="title">طلب حجز مبدئي بمشروع The Arkzayed - التجمع الخامس</div>

            <div class="section">
              <div class="section-h">بيانات العميل</div>

              <!-- Single Ownership -->
              <t t-if="o.ownership != 'multiple'">
                <div class="field">
                  <div class="lbl">الاسم بالكامل:</div>
                  <div class="fill"><t t-esc="o.customer_id.name or ''"/></div>
                </div>

                <div class="field">
                  <div class="lbl nowrap">رقم قومي/جواز السفر:</div>
                  <div class="fill">
                    <span class="ltr">
                      <t t-if="o.customer_national_id"><t t-esc="o.customer_national_id"/></t>
                      <t t-elif="o.customer_passport_number"><t t-esc="o.customer_passport_number"/></t>
                      <t t-else="">&#160;</t>
                    </span>
                  </div>
                </div>

                <div class="field">
                  <div class="lbl">عميل داخلي/خارجي:</div>
                  <div class="fill">
                    <t t-if="o.contract_type == 'domestic'">Domestic</t>
                    <t t-elif="o.contract_type == 'overseas'">Overseas</t>
                    <t t-else="">&#160;</t>
                  </div>
                </div>

                <div class="field">
                  <div class="lbl">الجنسية:</div>
                  <div class="fill"><t t-esc="(o.customer_id and o.customer_id.nationality) or ''"/></div>
                </div>

                <div class="field">
                  <div class="lbl">رقم التليفون:</div>
                  <div class="fill">
                    <span class="ltr">
                      <t t-if="o.customer_id and o.customer_id.mobile"><t t-esc="o.customer_id.mobile"/></t>
                      <t t-elif="o.customer_id and o.customer_id.phone"><t t-esc="o.customer_id.phone"/></t>
                      <t t-else="">&#160;</t>
                    </span>
                  </div>
                </div>
              </t>

              <!-- Multiple Ownership -->
              <t t-if="o.ownership == 'multiple'">
                <t t-foreach="o.customer_new_ownership_ids" t-as="owner">
                  <div style="margin-bottom: 10px; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                    <div style="font-weight: bold; margin-bottom: 6px;">
                    </div>

                    <div class="field">
                      <div class="lbl">الاسم بالكامل:</div>
                      <div class="fill"><t t-esc="owner.customer_id.name or ''"/></div>
                    </div>

                    <div class="field">
                      <div class="lbl nowrap">رقم قومي/جواز السفر:</div>
                      <div class="fill">
                        <span class="ltr">
                          <t t-if="owner.customer_id.national_id"><t t-esc="owner.customer_id.national_id"/></t>
                          <t t-elif="owner.customer_id.passport_number"><t t-esc="owner.customer_id.passport_number"/></t>
                          <t t-else="">&#160;</t>
                        </span>
                      </div>
                    </div>

                    <div class="field">
                      <div class="lbl">الجنسية:</div>
                      <div class="fill"><t t-esc="owner.customer_id.nationality or ''"/></div>
                    </div>

                    <div class="field">
                      <div class="lbl">رقم التليفون:</div>
                      <div class="fill">
                        <span class="ltr">
                          <t t-if="owner.customer_id.mobile"><t t-esc="owner.customer_id.mobile"/></t>
                          <t t-elif="owner.customer_id.phone"><t t-esc="owner.customer_id.phone"/></t>
                          <t t-else="">&#160;</t>
                        </span>
                      </div>
                    </div>
                  </div>
                </t>

                <div class="field">
                  <div class="lbl">عميل داخلي/خارجي:</div>
                  <div class="fill">
                    <t t-if="o.contract_type == 'domestic'">Domestic</t>
                    <t t-elif="o.contract_type == 'overseas'">Overseas</t>
                    <t t-else="">&#160;</t>
                  </div>
                </div>
              </t>
            </div>

            <div class="section">
              <div class="section-h">بيانات الوحدة</div>

              <div class="field">
                <div class="lbl">رقم الوحدة:</div>
                <div class="fill">
                  <span class="ltr"><t t-esc="(o.unit_id and o.unit_id.system_code) or ''"/></span>
                </div>
              </div>

              <div class="field">
                <div class="lbl">نوع الوحدة:</div>
                <div class="fill">
                  <span class="ltr">
                    <t t-esc="o.unit_type or ''"/>
                  </span>
                </div>
              </div>

              <div class="field">
                <div class="lbl">المساحة الإجمالية:</div>
                <div class="fill">
                  <span class="ltr"><t t-esc="'{:,.2f}'.format(o.contracted_build_up_area or 0.0)"/></span>
                  <span> متر مربع</span>
                </div>
              </div>

              <div class="field">
                <div class="lbl">السعر الإجمالي:</div>
                <div class="fill">
                  <span class="ltr"><t t-esc="'{:,.0f}'.format(o.unit_sales_price or 0.0)"/></span>
                  <span> جنيه مصري</span>
                </div>
              </div>
            </div>

            <div class="section">
              <div class="section-h">بيانات مسؤول المبيعات</div>

              <div class="field">
                <div class="lbl">مسؤول المبيعات:</div>
                <div class="fill"><t t-esc="o.sales_consultant_names or ''"/></div>
              </div>

              <div class="field">
                <div class="lbl">مدير المبيعات:</div>
                <div class="fill"><t t-esc="o.sales_manager_names or ''"/></div>
              </div>

              <div class="field">
                <div class="lbl">مباشر / غير مباشر:</div>
                <div class="fill">
                    <t t-if="o.referred_by == 'broker'">Broker</t>
                    <t t-elif="o.referred_by == 'customer'">Customer</t>
                    <t t-elif="o.referred_by == 'employee'">Employee</t>
                    <t t-elif="o.referred_by == 'ambassador'">Ambassador</t>
                    <t t-elif="o.referred_by == 'other'">Other</t>
                    <t t-else="">&#160;</t>
                </div>
              </div>

              <div class="field">
                <div class="lbl nowrap">شركة الوسيط العقارى:</div>
                    <div class="fill">
                        <t t-if="o.referred_by == 'broker' and o.referred_by_partner_id">
                            <t t-esc="o.referred_by_partner_id.name"/>
                        </t>
                        <t t-else="">&#160;</t>
                    </div>
              </div>
            </div>

           <div class="note">
              يرجى العلم بأننى أرغب فى حجز الوحده المذكورة اعلاه بمشروع (The Arkzayed) التابع لشركتكم و اتعهد بسداد مبلغ
                <span class="amount-line">
                  <bdi>
                    <t t-esc="'{:,.0f}'.format(o.initial_reservation_amount or 0.0)"/>
                  </bdi>
                </span>
                <span class="nowrap">
                  (
                  <span class="amount-line">
                    <t t-esc="o.amount_to_arabic(o.initial_reservation_amount)"/> جنيه مصرى
                  </span>
                  )
                </span>


              كجزء من دفعه الحجز ، كما اتعهد بالتوقيع على استماره حجز الوحده و استكمال باقى دفعة الحجز كاملة خلال مدة أقصاها خمس ايام عمل من تاريخ الطلب، و فى حاله عدم التزامى بذلك يصبح كامل المبلغ غير مسترد و حقا خالصــــــــا لشركتكم و تعويضا لها عن عدم اتمام التعاقد ولا يحق لى الرجوع على الشركه بأيه مطالبات.
            </div>

            <div class="signature-section">
              <div class="field">
                <div class="lbl">اسم العميل:</div>
                <div class="fill"><t t-esc="o.customer_id.name or ''"/></div>
              </div>

              <div class="field">
                <div class="lbl">توقيع العميل:</div>
                <div class="fill">&#160;</div>
              </div>
            </div>

          </div>

        <div class="footer">
          <div style="width:190mm;margin:0 auto;direction:ltr;white-space:nowrap;font-size:0;">

            <span style="display:inline-block;width:40%;text-align:left;font-size:7pt;line-height:1.2;color:#1f2a44;">
              South 90th Road &amp; Mohamed Naguib Axis, New Cairo
            </span>

            <span style="display:inline-block;width:22%;text-align:center;font-size:7pt;line-height:1.2;color:#1f2a44;">
              info@thearkdevelopment.com
            </span>

            <span style="display:inline-block;width:22%;text-align:center;font-size:7pt;line-height:1.2;color:#1f2a44;">
              www.thearkdevelopment.com
            </span>

            <span style="display:inline-block;width:16%;text-align:right;font-size:7pt;line-height:1.2;color:#1f2a44;">
              15275
            </span>

          </div>
        </div>

        </t>

      </t>
    </template>

  </data>
</odoo>