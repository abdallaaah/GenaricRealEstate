<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="si_position_tree_view" model="ir.ui.view">
            <field name="name">si.position.tree.view</field>
            <field name="model">si.position</field>
            <field name="arch" type="xml">
                <list string="SI Position">
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="si_position_form_view" model="ir.ui.view">
            <field name="name">si.position.form.view</field>
            <field name="model">si.position</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"
                                       required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_si_position" model="ir.actions.act_window">
            <field name="name">SI Position</field>
            <field name="res_model">si.position</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>